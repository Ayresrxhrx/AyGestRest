<UserControl x:Class="AyGestRest.Views.OrderHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <!-- Cores e Brushes -->
        <SolidColorBrush x:Key="PrimaryColor">#1976D2</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryDarkColor">#1565C0</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryLightColor">#E3F2FD</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessColor">#43A047</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessLightColor">#E8F5E9</SolidColorBrush>
        <SolidColorBrush x:Key="Gray100">#F5F5F5</SolidColorBrush>
        <SolidColorBrush x:Key="Gray200">#EEEEEE</SolidColorBrush>
        <SolidColorBrush x:Key="Gray300">#E0E0E0</SolidColorBrush>
        <SolidColorBrush x:Key="Gray700">#616161</SolidColorBrush>
        <SolidColorBrush x:Key="Gray800">#424242</SolidColorBrush>
        <SolidColorBrush x:Key="Gray900">#212121</SolidColorBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1976D2" Offset="0"/>
            <GradientStop Color="#1565C0" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow" Color="#1A237E" BlurRadius="15" 
                         ShadowDepth="0" Opacity="0.06" Direction="270"/>

        <!-- Estilos Responsivos Compactos -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ECEFF1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CFD8DC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1976D2"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos para ComboBox compactos -->
        <Style x:Key="CompactComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilos para DatePicker compactos -->
        <Style x:Key="CompactDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
        </Style>

        <!-- Estilo para item compacto da lista -->
        <Style x:Key="CompactListCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8" Background="#F8FAFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO COMPACTO -->
        <Border Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Ícone e título -->
                <StackPanel Grid.Row="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="0,0,0,8">
                    <Border Background="{StaticResource PrimaryGradient}" 
                            CornerRadius="8" 
                            Padding="8"
                            Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="History" 
                                                Width="20" 
                                                Height="20" 
                                                Foreground="White"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="HISTÓRICO DE VENDAS" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#1A237E"/>
                        <TextBlock Text="Visualize e gerencie vendas finalizadas" 
                                   FontSize="11" 
                                   Foreground="#546E7A"/>
                    </StackPanel>
                </StackPanel>

                <!-- Busca rápida -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtBuscaTalao" 
                             Style="{StaticResource ModernTextBox}"
                             Text=""
                             KeyDown="TxtBuscaTalao_KeyDown"
                             Margin="0,0,6,0"/>

                    <Button Content="BUSCAR" 
                            Style="{StaticResource PrimaryButton}"
                            Grid.Column="1"
                            Width="80"
                            Click="BtnBuscarTalao_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- FILTROS AVANÇADOS COMPACTOS -->
        <Border Style="{StaticResource ModernCard}" Grid.Row="1">
            <StackPanel>
                <TextBlock Text="FILTROS AVANÇADOS" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#37474F"
                           Margin="0,0,0,8"/>

                <!-- Filtros em grid para melhor responsividade -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Linha 1 -->
                    <!-- Data -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,6,6">
                        <TextBlock Text="Data" 
                                   FontSize="11" 
                                   FontWeight="Medium" 
                                   Foreground="#546E7A"
                                   Margin="0,0,0,2"/>
                        <DatePicker x:Name="dpData"
                                    Style="{StaticResource CompactDatePicker}"/>
                    </StackPanel>

                    <!-- Mesa -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="3,0,3,6">
                        <TextBlock Text="Mesa" 
                                   FontSize="11" 
                                   FontWeight="Medium" 
                                   Foreground="#546E7A"
                                   Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbMesa" 
                                  Style="{StaticResource CompactComboBox}"/>
                    </StackPanel>

                    <!-- Utilizador -->
                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="6,0,0,6">
                        <TextBlock Text="Utilizador" 
                                   FontSize="11" 
                                   FontWeight="Medium" 
                                   Foreground="#546E7A"
                                   Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbUtilizador" 
                                  Style="{StaticResource CompactComboBox}"/>
                    </StackPanel>

                    <!-- Linha 2 -->
                    <!-- Valor mínimo -->
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,6,0">
                        <TextBlock Text="Valor mínimo" 
                                   FontSize="11" 
                                   FontWeight="Medium" 
                                   Foreground="#546E7A"
                                   Margin="0,0,0,2"/>
                        <TextBox x:Name="txtValorMin" 
                                 Style="{StaticResource ModernTextBox}"
                                 Text="0"/>
                    </StackPanel>

                    <!-- Forma de pagamento -->
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="3,0,3,0">
                        <TextBlock Text="Pagamento" 
                                   FontSize="11" 
                                   FontWeight="Medium" 
                                   Foreground="#546E7A"
                                   Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbPagamento" 
                                  Style="{StaticResource CompactComboBox}"/>
                    </StackPanel>

                    <!-- Botões de ação -->
                    <StackPanel Grid.Column="2" Grid.Row="1" 
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="6,0,0,0">
                        <Button Content="🔍 FILTRAR" 
                                Style="{StaticResource CompactButton}"
                                Click="BtnFiltrar_Click"
                                MinWidth="90"
                                Margin="0,0,4,0"/>
                        <Button Content="🔄 LIMPAR" 
                                Style="{StaticResource SecondaryButton}"
                                Height="32"
                                Padding="8,4"
                                Click="BtnLimparFiltros_Click"
                                MinWidth="90"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- LISTA DE VENDAS ULTRA COMPACTA -->
        <Border Grid.Row="2" 
                Background="Transparent" 
                Padding="0"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho da lista compacto -->
                <Border Grid.Row="0" 
                        Background="White" 
                        CornerRadius="8,8,0,0" 
                        Padding="12"
                        BorderBrush="#ECEFF1"
                        BorderThickness="1,1,1,0"
                        Margin="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="VENDAS ENCONTRADAS" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="#546E7A"/>

                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   Foreground="#78909C">
                            <Run Text="Total: "/>
                            <Run x:Name="txtContadorVendas" Text="0" FontWeight="Bold" Foreground="#1976D2"/>
                            <Run Text=" vendas"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Lista de vendas compacta -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <ItemsControl x:Name="lstPedidos" 
                                  Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CompactListCard}">
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Indicador de status baseado no pagamento -->
                                        <Border x:Name="indicatorBorder" Grid.Column="0" 
                                                Width="3" 
                                                CornerRadius="1.5,0,0,1.5"
                                                Loaded="IndicatorBorder_Loaded"/>

                                        <!-- Conteúdo principal SUPER COMPACTO -->
                                        <StackPanel Grid.Column="1" 
                                                    Margin="10,8"
                                                    VerticalAlignment="Center">

                                            <!-- Primeira linha: Talão e Data -->
                                            <WrapPanel Orientation="Horizontal" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,0,6">

                                                <!-- Talão -->
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="TALÃO" 
                                                               FontSize="9" 
                                                               FontWeight="Medium" 
                                                               Foreground="#78909C"
                                                               Margin="0,0,0,1"/>
                                                    <StackPanel Orientation="Horizontal" 
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="T" 
                                                                   FontSize="14" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="#1976D2"/>
                                                        <TextBlock Text="{Binding TalaoFormatado}" 
                                                                   FontSize="14" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="#2C3E50"
                                                                   Margin="1,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Separador -->
                                                <Border Width="1" 
                                                        Height="20" 
                                                        Background="#ECEFF1" 
                                                        Margin="8,0,8,0"/>

                                                <!-- Data/Hora -->
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="DATA/HORA" 
                                                               FontSize="9" 
                                                               FontWeight="Medium" 
                                                               Foreground="#78909C"
                                                               Margin="0,0,0,1"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DataFormatada}" 
                                                                   FontSize="11" 
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#2C3E50"/>
                                                        <TextBlock Text="{Binding HoraFormatada}" 
                                                                   FontSize="10" 
                                                                   Foreground="#607D8B"
                                                                   Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Separador -->
                                                <Border Width="1" 
                                                        Height="20" 
                                                        Background="#ECEFF1" 
                                                        Margin="8,0,8,0"/>

                                                <!-- Mesa -->
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="MESA" 
                                                               FontSize="9" 
                                                               FontWeight="Medium" 
                                                               Foreground="#78909C"
                                                               Margin="0,0,0,1"/>
                                                    <Border Background="{StaticResource PrimaryLightColor}" 
                                                            CornerRadius="4" 
                                                            Padding="4,2"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding MesaFormatada}" 
                                                                   FontSize="10" 
                                                                   FontWeight="Bold"
                                                                   Foreground="#1565C0"/>
                                                    </Border>
                                                </StackPanel>
                                            </WrapPanel>

                                            <!-- Segunda linha: Pagamento, Utilizador, Total e Ação -->
                                            <WrapPanel Orientation="Horizontal" 
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Stretch">

                                                <!-- Pagamento -->
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="PAGAMENTO" 
                                                               FontSize="9" 
                                                               FontWeight="Medium" 
                                                               Foreground="#78909C"
                                                               Margin="0,0,0,1"/>
                                                    <TextBlock Text="{Binding PagamentoFormatado}"
                                                               FontSize="10" 
                                                               FontWeight="SemiBold"
                                                               Foreground="#455A64"/>
                                                </StackPanel>

                                                <!-- Separador -->
                                                <Border Width="1" 
                                                        Height="16" 
                                                        Background="#ECEFF1" 
                                                        Margin="6,0,6,0"/>

                                                <!-- Utilizador -->
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="UTILIZADOR" 
                                                               FontSize="9" 
                                                               FontWeight="Medium" 
                                                               Foreground="#78909C"
                                                               Margin="0,0,0,1"/>
                                                    <TextBlock Text="{Binding UtilizadorFormatado}"
                                                               FontSize="10" 
                                                               FontWeight="SemiBold"
                                                               Foreground="#455A64"/>
                                                </StackPanel>

                                                <!-- Separador -->
                                                <Border Width="1" 
                                                        Height="16" 
                                                        Background="#ECEFF1" 
                                                        Margin="6,0,6,0"/>

                                                <!-- Total -->
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="TOTAL" 
                                                               FontSize="9" 
                                                               FontWeight="Medium" 
                                                               Foreground="#78909C"
                                                               Margin="0,0,0,1"/>
                                                    <TextBlock Text="{Binding TotalFormatado}"
                                                               FontSize="14" 
                                                               FontWeight="Bold"
                                                               Foreground="#1976D2"/>
                                                </StackPanel>

                                                <!-- Botão de ação compacto -->
                                                <!-- Menu suspenso para escolher tipo de impressão -->
                                                <StackPanel Margin="8,0,0,0">
                                                    <Border Background="#F0F8FF" 
            CornerRadius="6"
            Padding="1">
                                                        <StackPanel>
                                                            <TextBlock Text="IMPRIMIR" 
                       FontSize="9" 
                       FontWeight="Medium" 
                       Foreground="#1976D2"
                       TextAlignment="Center"
                       Margin="0,0,0,1"/>
                                                            <WrapPanel>
                                                                <Button Style="{StaticResource CompactButton}"
                        Content="📄 A4"
                        ToolTip="Imprimir recibo em formato A4"
                        Click="BtnImprimirA4_Click"
                        Tag="{Binding}"
                        Padding="4,2"
                        FontSize="9"
                        MinWidth="40"
                        Height="24"
                        Margin="0,0,2,0"/>
                                                                <Button Style="{StaticResource CompactButton}"
                        Content="📟 80mm"
                        ToolTip="Imprimir recibo em 80mm (fiscal)"
                        Click="BtnImprimir80mm_Click"
                        Tag="{Binding}"
                        Padding="4,2"
                        FontSize="9"
                        MinWidth="40"
                        Height="24"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- RESUMO DO DIA COMPACTO -->
        <Border Grid.Row="3" 
                Style="{StaticResource ModernCard}" 
                Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Resumo geral -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtResumo" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#1A237E"/>
                    <TextBlock Text="Filtrado por data selecionada" 
                               FontSize="11" 
                               Foreground="#78909C"/>
                </StackPanel>

                <!-- Numerário compacto -->
                <Border Grid.Column="1" 
                        Background="{StaticResource SuccessLightColor}" 
                        CornerRadius="8" 
                        Padding="12,8"
                        Margin="0,0,6,0"
                        MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="NUMERÁRIO" 
                                   FontSize="10" 
                                   FontWeight="Medium" 
                                   Foreground="#2E7D32"
                                   Margin="0,0,0,2"/>
                        <TextBlock x:Name="txtTotalNumerario" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#1B5E20"/>
                    </StackPanel>
                </Border>

                <!-- Eletrônico compacto -->
                <Border Grid.Column="2" 
                        Background="{StaticResource PrimaryLightColor}" 
                        CornerRadius="8" 
                        Padding="12,8"
                        MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="ELETRÔNICO" 
                                   FontSize="10" 
                                   FontWeight="Medium" 
                                   Foreground="#1565C0"
                                   Margin="0,0,0,2"/>
                        <TextBlock x:Name="txtTotalEletronico" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#0D47A1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>