<Window x:Class="AyGestRest.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="270" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AyGestBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold"/>
        <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,18,0,18" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource AyGestSecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Confirmar" Style="{StaticResource AyGestPrimaryButton}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
