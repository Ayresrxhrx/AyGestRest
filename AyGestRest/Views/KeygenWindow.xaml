<Window x:Class="AyGest.AtivacaoKeygenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keygen AyGest" Height="250" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gerador de Key (AyGest)" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="HWID:" />
            <TextBox x:Name="txtHwid" Height="30" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Key Gerada:" />
            <TextBox x:Name="txtKey" Height="30" IsReadOnly="True" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnGerar" Content="Gerar" Width="100" Height="30" Click="btnGerar_Click"/>
            <Button x:Name="btnCopiar" Content="Copiar" Width="100" Height="30" Margin="10,0,0,0" Click="btnCopiar_Click"/>
        </StackPanel>
    </Grid>
</Window>
