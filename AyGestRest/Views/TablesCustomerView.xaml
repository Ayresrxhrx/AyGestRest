<UserControl x:Class="AyGestRest.Views.TablesCustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="600" MinWidth="800"
             Background="#1E1E1E">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="TablesCanvas" Background="Transparent"/>
        </ScrollViewer>

        <!-- Legenda fixa -->
        <Border Background="#2D2D2D" Opacity="0.9" CornerRadius="8" Padding="10" 
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20">
            <StackPanel>
                <TextBlock Text="Legenda" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                <ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="20" Height="20" Fill="Gray" Margin="0,0,10,0"/>
                        <TextBlock Text="Livre" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="20" Height="20" Fill="Green" Margin="0,0,10,0"/>
                        <TextBlock Text="Ocupada" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="20" Height="20" Fill="Orange" Margin="0,0,10,0"/>
                        <TextBlock Text="Reservada" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="20" Height="20" Fill="Yellow" Margin="0,0,10,0"/>
                        <TextBlock Text="Pendente" Foreground="White"/>
                    </StackPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
