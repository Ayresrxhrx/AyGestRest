                                             Text="1" 
                                             Height="32" 
                                             FontSize="11"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1"
                                             Padding="6,4"
                                             Background="White"
                                             TextAlignment="Right"/>
                                            </StackPanel>

                                            <!-- Preço Unitário -->
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,0">
                                                <TextBlock Text="Preço" 
                                               FontSize="11" 
                                               Foreground="#64748B"
                                               FontWeight="Medium"
                                               Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtPurchaseUnitPrice" 
                                             Text="0,00" 
                                             Height="32" 
                                             FontSize="11"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1"
                                             Padding="6,4"
                                             Background="White"
                                             TextAlignment="Right"/>
                                            </StackPanel>

                                            <!-- Botão Adicionar -->
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,0,0">
                                                <TextBlock Text=" " 
                                               FontSize="11" 
                                               Visibility="Hidden"/>
                                                <Button x:Name="BtnAddPurchaseItem" 
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="#4F46E5"
                                            Click="BtnAddPurchaseItem_Click" 
                                            Height="32" 
                                            Width="60"
                                            Padding="0"
                                            ToolTip="Adicionar item"
                                            >
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Plus" 
                                                                     Width="14" 
                                                                     Height="14"
                                                                     Margin="0,0,4,0"/>
                                                        <TextBlock Text="Add" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Lista de Itens -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" 
                                                     Width="16" 
                                                     Height="16" 
                                                     Foreground="#64748B"
                                                     Margin="0,0,6,0"/>
                                        <TextBlock Text="Itens adicionados" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="#475569"/>
                                    </StackPanel>

                                    <DataGrid x:Name="DgPurchaseItems" 
          AutoGenerateColumns="False" 
          CanUserAddRows="False" 
          CanUserDeleteRows="False"
          CanUserReorderColumns="False"
          CanUserResizeColumns="False"
          CanUserSortColumns="False"
          HeadersVisibility="Column"
          RowHeight="32"
          Height="140"
          MaxHeight="140"
          BorderThickness="1" 
          BorderBrush="#E2E8F0" 
          FontSize="11"
          Background="White"
          Margin="0,0,0,8"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#F1F5F9"
          SelectionMode="Single"
          SelectionUnit="FullRow">

                                        <DataGrid.Columns>
                                            <!-- Ícone e Tipo -->
                                            <DataGridTemplateColumn Header="" Width="30">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Icon}" 
                               FontSize="14" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Nome do Item -->
                                            <DataGridTextColumn Header="Item" 
                            Binding="{Binding Name}" 
                            Width="*" 
                            IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="Padding" Value="0,0,4,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Tipo -->
                                            <DataGridTextColumn Header="Tipo" 
                            Binding="{Binding Type}" 
                            Width="70"
                            IsReadOnly="True"/>

                                            <!-- Quantidade -->
                                            <DataGridTextColumn Header="Qtd" 
                            Binding="{Binding Quantity}" 
                            Width="45"
                            IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Preço Unitário -->
                                            <DataGridTextColumn Header="Preço" 
                            Binding="{Binding UnitPrice, StringFormat=N2}" 
                            Width="60"
                            IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Subtotal -->
                                            <DataGridTextColumn Header="Subtotal" 
                            Binding="{Binding Subtotal, StringFormat=N2}" 
                            Width="70"
                            IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Remover -->
                                            <DataGridTemplateColumn Header="" Width="36">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Width="24" 
                            Height="24"
                            Padding="0"
                            Background="#FEE2E2"
                            BorderThickness="0"
                            Click="BtnRemovePurchaseItem_Click" 
                            Tag="{Binding}"
                            ToolTip="Remover item"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="Close" 
                                                 Width="12" 
                                                 Height="12"
                                                 Foreground="#EF4444"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Contador de itens -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <TextBlock Text="Total de itens: " 
                                       FontSize="11" 
                                       Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtPurchaseItemCount" 
                                       Text="0" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="#4F46E5"
                                       Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ===== RESUMO DA COMPRA ===== -->
                            <Border Background="White" 
                        CornerRadius="8" 
                        Padding="16"
                        BorderBrush="#4F46E5"
                        BorderThickness="2"
                        Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Calculator" 
                                                         Width="18" 
                                                         Height="18" 
                                                         Foreground="#4F46E5"
                                                         Margin="0,0,8,0"/>
                                            <TextBlock Text="RESUMO DA COMPRA" 
                                           FontWeight="ExtraBold" 
                                           Foreground="#4F46E5" 
                                           FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock Text="Clique em 'Registrar Compra' para confirmar" 
                                       FontSize="10" 
                                       Foreground="#64748B"
                                       Margin="26,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL" 
                                       FontSize="11" 
                                       Foreground="#475569"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="TxtPurchaseTotal" 
                                       Text="0,00 MTn" 
                                       FontSize="22" 
                                       FontWeight="ExtraBold" 
                                       Foreground="#10B981"
                                       HorizontalAlignment="Right"
                                       Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Espaçamento final -->
                            <Rectangle Height="8" Fill="Transparent"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== RODAPÉ FIXO (SEMPRE VISÍVEL) ===== -->
                    <Border Grid.Row="2" 
                Background="#F8FAFC" 
                CornerRadius="0,0,10,10" 
                Padding="16,12"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right">

                            <!-- Botão Registrar Compra -->
                            <Button x:Name="BtnSavePurchase" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Background="#4F46E5"
                        Click="BtnSavePurchase_Click" 
                        Margin="0,0,8,0" 
                        Padding="16,8" 
                        Height="38"
                        MinWidth="140"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        IsEnabled="False"
                        ToolTip="Registrar compra (adicione pelo menos 1 item)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" 
                                                 Width="16" 
                                                 Height="16" 
                                                 Margin="0,0,8,0"/>
                                    <TextBlock Text="REGISTRAR COMPRA" 
                                   FontSize="12" 
                                   FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Botão Cancelar -->
                            <Button x:Name="BtnCancelPurchase" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Background="#64748B"
                        Click="ClosePurchasePopup_Click" 
                        Padding="16,8" 
                        Height="38"
                        MinWidth="100"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        ToolTip="Cancelar e fechar">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" 
                                                 Width="16" 
                                                 Height="16" 
                                                 Margin="0,0,8,0"/>
                                    <TextBlock Text="CANCELAR" 
                                   FontSize="12" 
                                   FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Cabeçalho Principal -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariant" Width="28" Height="28" Foreground="White" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Gestão de Produtos e Inventário" FontSize="20" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="Produtos, inventário, compras e fornecedores" FontSize="12" 
                           Foreground="{StaticResource SemiTransparentText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Estatísticas em tempo real -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource TranslucentWhite}" CornerRadius="6" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Silverware" Foreground="White" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtTotalIngredients" Text="0" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text=" ingredientes" Foreground="{StaticResource SemiTransparentText}" Margin="4,0,0,0" FontSize="12"/>
                        </StackPanel>
                        
                    </Border>
                    <Border Background="{StaticResource TranslucentWhite}" CornerRadius="6" Padding="8,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Foreground="White" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtTotalProducts" Text="0" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text=" produtos" Foreground="{StaticResource SemiTransparentText}" Margin="4,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource TranslucentWhite}" CornerRadius="6" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrendingUp" Foreground="White" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStockValue" Text="0,00 MTn" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text=" valor stock" Foreground="{StaticResource SemiTransparentText}" Margin="4,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <TabControl Grid.Row="1" Margin="16" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      ContentSource="Header" Margin="8,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#4F46E5"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="#4F46E5"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="#64748B"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="#4F46E5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB PRODUTOS -->
            <TabItem Header="📦 Produtos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar Superior -->
                    <Border Grid.Row="0" Margin="0,0,0,16" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filtros de Busca -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Style="{StaticResource ModernCardStyle}" Padding="10" Margin="0,0,10,0" MinWidth="260">
                                    <StackPanel>
                                        <TextBlock Text="🔍 Buscar Produtos" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" FontSize="13"/>
                                        <StackPanel>
                                            <TextBlock Text="Nome, código ou descrição" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" Style="{StaticResource ValidatedTextBoxStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ModernCardStyle}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Filtros Avançados" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" FontSize="13"/>
                                        <WrapPanel>
                                            <ComboBox x:Name="CmbFilterCategory" Width="160" 
                                          materialDesign:HintAssist.Hint="Categoria"
                                          DisplayMemberPath="Nome" SelectedValuePath="Id" 
                                          SelectionChanged="CmbFilterCategory_SelectionChanged" Margin="0,0,6,6"/>

                                            <ComboBox x:Name="CmbFilterStatus" Width="120" 
                                          materialDesign:HintAssist.Hint="Status" 
                                          SelectedIndex="0" Margin="0,0,6,6">
                                                <ComboBoxItem Content="Todos"/>
                                                <ComboBoxItem Content="Ativos"/>
                                                <ComboBoxItem Content="Inativos"/>
                                            </ComboBox>

                                            <ComboBox x:Name="CmbFilterStock" Width="140" 
                                          materialDesign:HintAssist.Hint="Stock" 
                                          SelectedIndex="0">
                                                <ComboBoxItem Content="Todos"/>
                                                <ComboBoxItem Content="Sem stock"/>
                                                <ComboBoxItem Content="Stock baixo (&lt;10)"/>
                                                <ComboBoxItem Content="Stock normal"/>
                                            </ComboBox>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Botões de Ação -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Style="{StaticResource ModernCardStyle}" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnNew" ToolTip="Novo Produto" Style="{StaticResource PrimaryButtonStyle}" 
                                    Background="#10B981" Margin="0,0,6,0" Click="BtnNew_Click" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/>
                                                <TextBlock Text="Novo Produto" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- LISTA DE PRODUTOS -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho da Lista -->
                            <Border Grid.Row="0" Padding="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ViewList" Width="20" Height="20" Foreground="#4F46E5" Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📋 Lista de Produtos" FontWeight="SemiBold" FontSize="16" Foreground="#2C3E50"/>
                                                <TextBlock x:Name="TxtProductCount" Text=" (0)" FontWeight="SemiBold" Foreground="#64748B" FontSize="16"/>
                                            </StackPanel>
                                            <TextBlock Text="Clique em um produto para editá-lo" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Lista de Produtos -->
                            <ListBox x:Name="ProductsListControl" 
                         Grid.Row="1"
                         Margin="0,12,0,0"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                Padding="16" Margin="0,0,0,8" Cursor="Hand"
                Tag="{Binding}"
                MouseLeftButtonUp="ProductItem_MouseLeftButtonUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Ícone do Produto -->
                                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                        Width="44" Height="44" CornerRadius="8"
                        Background="#F1F5F9" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Viewbox Width="20" Height="20">
                                                        <materialDesign:PackIcon>
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Foreground" Value="#475569"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsComposite}" Value="True">
                                                                            <Setter Property="Kind" Value="ChefHat"/>
                                                                            <Setter Property="Foreground" Value="#3B82F6"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsComposite}" Value="False">
                                                                            <Setter Property="Kind" Value="PackageVariant"/>
                                                                            <Setter Property="Foreground" Value="#8B5CF6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                    </Viewbox>
                                                </Border>

                                                <!-- Informações do Produto -->
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                                                        <TextBlock Text=" • " Foreground="#CBD5E1" Margin="4,0"/>
                                                        <TextBlock Text="{Binding Code}" FontSize="12" Foreground="#64748B"/>
                                                        <Border CornerRadius="6" Padding="4,2" Margin="8,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#EF4444"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                                                            <Setter Property="Background" Value="#10B981"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Ativo" Foreground="White" FontWeight="Medium" FontSize="10">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Ativo"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Active}" Value="False">
                                                                                <Setter Property="Text" Value="Inativo"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Category.Nome}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Detalhes -->
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                                    <!-- Preço -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Preço:" FontSize="12" Foreground="#64748B" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Price, StringFormat='MTn {0:N2}'}" 
                                   FontWeight="Bold" FontSize="13" Foreground="#10B981"/>
                                                    </StackPanel>

                                                    <!-- Stock -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,4,0">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="PackageVariant"/>
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                                                            <Setter Property="Kind" Value="PackageVariantRemove"/>
                                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Stock}">
                                                                            <DataTrigger.Value>
                                                                                <sys:Double>10</sys:Double>
                                                                            </DataTrigger.Value>
                                                                            <Setter Property="Kind" Value="PackageVariantClosed"/>
                                                                            <Setter Property="Foreground" Value="#F97316"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Stock}">
                                                                            <DataTrigger.Value>
                                                                                <sys:Double>50</sys:Double>
                                                                            </DataTrigger.Value>
                                                                            <Setter Property="Kind" Value="Check"/>
                                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                        <TextBlock Text="{Binding Stock, StringFormat=N0}" FontSize="12" FontWeight="Medium" Foreground="#475569"/>
                                                        <TextBlock Text=" unidades" FontSize="11" Foreground="#94A3B8" Margin="2,0,0,0"/>
                                                    </StackPanel>

                                                    <!-- Código de Barras - CORRIGIDO SEM CONVERTER E SEM QUALIFIER -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <!-- Se Barcode for nulo, mantém Collapsed -->
                                                                    <DataTrigger Binding="{Binding Barcode}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <!-- Se Barcode for string vazia, mantém Collapsed -->
                                                                    <DataTrigger Binding="{Binding Barcode}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <!-- Se tiver qualquer valor (não nulo e não vazio), torna Visible -->
                                                                    <Trigger Property="Tag" Value="{x:Null}">
                                                                        <!-- Este trigger é um truque: como Tag tem valor, nunca dispara, mas permite usar MultiDataTrigger abaixo -->
                                                                    </Trigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Barcode}" Value="{x:Null}" />
                                                                            <Condition Binding="{Binding Barcode, TargetNullValue='__NON_EMPTY__'}" Value="__NON_EMPTY__" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <materialDesign:PackIcon Kind="Barcode" Width="12" Height="12"
                                                 Foreground="#8B5CF6" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="#8B5CF6"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Botão de Ação -->
                                                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#F1F5F9" Margin="12,0,0,0"
                        Tag="{Binding}"
                        Click="ProductAction_Click">
                                                    <materialDesign:PackIcon Kind="DotsVertical" Width="18" Height="18" Foreground="#64748B"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Rodapé da Lista -->
                            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,8,8" Padding="12,8" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Estatísticas -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊 Resumo: " FontWeight="Medium" Foreground="#475569" FontSize="12"/>
                                            <TextBlock x:Name="TxtActiveProducts" Text="0 ativos" Foreground="#64748B" Margin="4,0,8,0" FontSize="12"/>
                                            <TextBlock x:Name="TxtLowStockProducts" Text="0 com stock baixo" Foreground="#F97316" Margin="0,0,8,0" FontSize="12"/>
                                            <TextBlock x:Name="TxtOutOfStockProducts" Text="0 sem stock" Foreground="#EF4444" FontSize="12"/>
                                            <TextBlock x:Name="TxtBarcodeProducts" Text="0 com código de barras" Foreground="#8B5CF6" Margin="8,0,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB INGREDIENTES -->
            <TabItem Header="🧪 Ingredientes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar Superior -->
                    <Border Grid.Row="0" Margin="0,0,0,16" Padding="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Style="{StaticResource ModernCardStyle}" Padding="10">
                                <Button x:Name="BtnNewIngredient" ToolTip="Novo Ingrediente" Style="{StaticResource PrimaryButtonStyle}" 
                                        Background="#10B981" Padding="12,8" Click="BtnNewIngredient_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/>
                                        <TextBlock Text="Novo Ingrediente" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lista de Ingredientes -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho -->
                            <Border Grid.Row="0" Padding="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧪 Todos os Ingredientes" FontWeight="SemiBold" FontSize="16" Foreground="#2C3E50"/>
                                        <TextBlock x:Name="TxtIngredientCount" Text=" (0)" FontWeight="SemiBold" Foreground="#64748B" FontSize="16"/>
                                    </StackPanel>
                                    <TextBlock Text="Gerencie os ingredientes disponíveis para receitas" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>

                            <!-- DataGrid -->
                            <DataGrid Grid.Row="1" x:Name="DgIngredients" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionChanged="DgIngredients_SelectionChanged" BorderThickness="1" BorderBrush="#E2E8F0" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Custo" Binding="{Binding Cost, StringFormat='N2 MTn'}" Width="100"/>
                                    <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="100"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat=N2}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stock}" Value="0">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Stock}">
                                                        <DataTrigger.Value>
                                                            <sys:Double>10</sys:Double>
                                                        </DataTrigger.Value>
                                                        <Setter Property="Foreground" Value="#F97316"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Ações" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}" Padding="6,4"
                                                            Click="EditIngredient_Click" Tag="{Binding}" FontSize="11" Margin="0,0,4,0"/>
                                                    <Button Content="Excluir" Style="{StaticResource SecondaryButtonStyle}" Padding="6,4"
                                                            Click="BtnDeleteIngredient_Click" Tag="{Binding}" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,8"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGrid.CellStyle>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <!-- TAB ANÁLISE HISTÓRICA -->
            <!-- TAB ANÁLISE HISTÓRICA -->
            <TabItem Header="📈 Análise Histórica">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Filtros de Data -->
                        <Border Grid.Row="0" Margin="16,16,16,16" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Filtros -->
                                <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="📅 Período de Análise" 
                                       FontWeight="SemiBold" 
                                       Foreground="#475569" 
                                       Margin="0,0,0,12" 
                                       FontSize="14"/>

                                        <!-- Linha 1: Datas -->
                                        <WrapPanel Margin="0,0,0,12">
                                            <!-- Data Inicial -->
                                            <StackPanel Margin="0,0,24,8" MinWidth="140">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Data Inicial" 
                                                   Style="{StaticResource RequiredFieldLabelStyle}"/>
                                                    <TextBlock Style="{StaticResource RequiredIndicatorStyle}"/>
                                                </StackPanel>
                                                <DatePicker x:Name="DpHistoryFrom" 
                                                Width="140" 
                                                SelectedDate="{x:Static sys:DateTime.Today}"
                                                materialDesign:HintAssist.Hint="dd/MM/yyyy"
                                                FontSize="12"/>
                                            </StackPanel>

                                            <!-- Data Final -->
                                            <StackPanel Margin="0,0,24,8" MinWidth="140">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Data Final" 
                                                   Style="{StaticResource RequiredFieldLabelStyle}"/>
                                                    <TextBlock Style="{StaticResource RequiredIndicatorStyle}"/>
                                                </StackPanel>
                                                <DatePicker x:Name="DpHistoryTo" 
                                                Width="140" 
                                                SelectedDate="{x:Static sys:DateTime.Today}"
                                                materialDesign:HintAssist.Hint="dd/MM/yyyy"
                                                FontSize="12"/>
                                            </StackPanel>
                                        </WrapPanel>

                                        <!-- Linha 2: Filtros de Produto e Categoria -->
                                        <WrapPanel Margin="0,0,0,12">
                                            <!-- Produto Específico -->
                                            <StackPanel Margin="0,0,24,8" MinWidth="200">
                                                <TextBlock Text="Produto (opcional)" 
                                               Style="{StaticResource RequiredFieldLabelStyle}"/>
                                                <ComboBox x:Name="CmbHistoryProduct" 
                                              Width="200"
                                              materialDesign:HintAssist.Hint="Todos os produtos"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              FontSize="12"
                                              Height="32"/>
                                            </StackPanel>

                                            <!-- Categoria -->
                                            <StackPanel Margin="0,0,24,8" MinWidth="160">
                                                <TextBlock Text="Categoria" 
                                               Style="{StaticResource RequiredFieldLabelStyle}"/>
                                                <ComboBox x:Name="CmbHistoryCategory" 
                                              Width="160"
                                              materialDesign:HintAssist.Hint="Todas categorias"
                                              DisplayMemberPath="Nome"
                                              SelectedValuePath="Id"
                                              FontSize="12"
                                              Height="32"/>
                                            </StackPanel>
                                        </WrapPanel>

                                        <!-- Linha 3: Opções de análise -->
                                        <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="⚙️ Opções de Análise" 
                                               FontWeight="SemiBold" 
                                               Foreground="#475569" 
                                               Margin="0,0,0,8" 
                                               FontSize="13"/>

                                                <WrapPanel>
                                                    <CheckBox x:Name="ChkShowOnlyChanges" 
                                                  Content="Mostrar apenas produtos com alterações"
                                                  IsChecked="True"
                                                  Margin="0,0,16,8"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"/>

                                                    <CheckBox x:Name="ChkIncludeZeroStock" 
                                                  Content="Incluir produtos sem stock"
                                                  IsChecked="False"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Botões de Ação -->
                                <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Info do período -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="📊 Período Selecionado" 
                                           FontWeight="SemiBold" 
                                           Foreground="#475569" 
                                           Margin="0,0,0,4" 
                                           FontSize="13"/>
                                            <TextBlock x:Name="TxtHistoryPeriod" 
                                           Text="Selecione as datas e clique em Analisar" 
                                           FontSize="12" 
                                           Foreground="#64748B"/>
                                        </StackPanel>

                                        <!-- Botões -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="BtnDebugTest" 
        Content="🐛 Debug" 
        Background="#EF4444" 
        Foreground="White"
        Click="BtnDebugTest_Click" 
        Padding="8,4" 
        FontSize="11"
        Margin="0,0,6,0"
        ToolTip="Testar diagnóstico do sistema"/>
                                            <!-- Na seção de botões de ação, adicione: -->
                                            <Button x:Name="BtnRefreshCache" 
        Content="🔄 Atualizar" 
        Style="{StaticResource SecondaryButtonStyle}"
        Click="BtnRefreshCache_Click" 
        Padding="8,4" 
        FontSize="11"
        Margin="0,0,6,0"
        ToolTip="Atualizar cache de dados"
        MinWidth="80"/>

                                            <Button x:Name="BtnForceRecalculate" 
        Content="⚡ Recalcular" 
        Style="{StaticResource SecondaryButtonStyle}"
        Click="BtnForceRecalculate_Click" 
        Padding="8,9" 
        FontSize="11"
        ToolTip="Forçar recálculo completo"
        MinWidth="80"/>
                                            <Button x:Name="BtnClearHistory" 
                                        Content="🗑️ Limpar" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnClearHistoryFilters_Click" 
                                        Padding="12,8" 
                                        FontSize="12" 
                                        Margin="0,0,8,0"
                                        ToolTip="Limpar todos os filtros"
                                        MinWidth="80"/>

                                            <Button x:Name="BtnExportHistory" 
                                        Content="📊 Exportar" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnExportHistory_Click" 
                                        Padding="12,8" 
                                        FontSize="12" 
                                        Margin="0,0,8,0"
                                        ToolTip="Exportar relatório detalhado"
                                        MinWidth="80"/>

                                            <Button x:Name="BtnAnalyzeHistory" 
                                        Content="🔍 Analisar" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnAnalyzeHistory_Click" 
                                        Padding="12,8" 
                                        FontSize="12"
                                        ToolTip="Analisar variações de stock no período"
                                        MinWidth="100"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Resultados da Análise -->
                        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Margin="16,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho com Estatísticas -->
                                <Border Grid.Row="0" Padding="16" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Título e Contador -->
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="ChartLine" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Foreground="#4F46E5" 
                                                             Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Variação de Stock por Produto" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="16" 
                                                       Foreground="#2C3E50"/>
                                                        <TextBlock x:Name="TxtHistoryCount" 
                                                       Text=" (0 produtos)" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#64748B" 
                                                       FontSize="16"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtHistoryPeriodResults" 
                                                   Text="Execute uma análise para ver os resultados" 
                                                   FontSize="12" 
                                                   Foreground="#64748B" 
                                                   Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Estatísticas Rápidas -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Aumentaram -->
                                            <Border Background="#F0F9FF" 
                                        CornerRadius="6" 
                                        Padding="8,6" 
                                        Margin="0,0,8,0"
                                        BorderBrush="#E0F2FE"
                                        BorderThickness="1"
                                        MinWidth="100">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="TrendingUp" 
                                                                 Foreground="#0EA5E9" 
                                                                 Width="16" 
                                                                 Height="16" 
                                                                 Margin="0,0,6,0"/>
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtIncreasedCount" 
                                                       Text="0" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Foreground="#0EA5E9"
                                                       HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Aumentaram" 
                                                       FontSize="10" 
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Diminuíram -->
                                            <Border Background="#FEF2F2" 
                                        CornerRadius="6" 
                                        Padding="8,6" 
                                        Margin="0,0,8,0"
                                        BorderBrush="#FEE2E2"
                                        BorderThickness="1"
                                        MinWidth="100">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="TrendingDown" 
                                                                 Foreground="#EF4444" 
                                                                 Width="16" 
                                                                 Height="16" 
                                                                 Margin="0,0,6,0"/>
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtDecreasedCount" 
                                                       Text="0" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Foreground="#EF4444"
                                                       HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Diminuíram" 
                                                       FontSize="10" 
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Estáveis -->
                                            <Border Background="#F0FDF4" 
                                        CornerRadius="6" 
                                        Padding="8,6"
                                        BorderBrush="#D1FAE5"
                                        BorderThickness="1"
                                        MinWidth="90">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Minus" 
                                                                 Foreground="#10B981" 
                                                                 Width="16" 
                                                                 Height="16" 
                                                                 Margin="0,0,6,0"/>
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtStableCount" 
                                                       Text="0" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Foreground="#10B981"
                                                       HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Estáveis" 
                                                       FontSize="10" 
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- DataGrid de Resultados (com Scroll interno) -->
                                <Border Grid.Row="1" Margin="0,8,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Padding="1">
                                        <DataGrid x:Name="DgStockHistory" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True"
                                      SelectionChanged="DgStockHistory_SelectionChanged"
                                      BorderThickness="1" 
                                      BorderBrush="#E2E8F0" 
                                      FontSize="12"
                                      CanUserSortColumns="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeColumns="True"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      RowHeight="40"
                                      MinHeight="200">

                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="Foreground" Value="#334155"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#E0E7FF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.Resources>

                                            <DataGrid.Columns>
                                                <!-- Produto -->
                                                <DataGridTextColumn Header="Produto" 
                                                        Binding="{Binding HistoricalData.ProductName}" 
                                                        Width="*" MinWidth="180"/>

                                                <!-- Código -->
                                                <DataGridTextColumn Header="Código" 
                                                        Binding="{Binding HistoricalData.ProductCode}" 
                                                        Width="100" MinWidth="80"/>

                                                <!-- Categoria -->
                                                <DataGridTextColumn Header="Categoria" 
                                                        Binding="{Binding HistoricalData.CategoryName}" 
                                                        Width="120" MinWidth="100"/>

                                                <!-- Stock Inicial -->
                                                <DataGridTextColumn Header="Stock Inicial" 
                                                        Binding="{Binding HistoricalData.StockAtStart, StringFormat=N0}" 
                                                        Width="110" MinWidth="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                            <Setter Property="FontWeight" Value="Medium"/>
                                                            <Setter Property="Padding" Value="0,0,8,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Stock Final -->
                                                <DataGridTextColumn Header="Stock Final" 
                                                        Binding="{Binding HistoricalData.StockAtEnd, StringFormat=N0}" 
                                                        Width="110" MinWidth="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                            <Setter Property="FontWeight" Value="Medium"/>
                                                            <Setter Property="Padding" Value="0,0,8,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Variação Quantitativa -->
                                                <DataGridTextColumn Header="Variação" 
                                                        Width="120" MinWidth="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Padding" Value="0,0,8,0"/>
                                                            <Setter Property="Text" 
                                                        Value="{Binding HistoricalData.Variation, StringFormat=N0}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HistoricalData.Variation}" Value="0">
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HistoricalData.Variation}">
                                                                    <DataTrigger.Value>
                                                                        <sys:Double>0</sys:Double>
                                                                    </DataTrigger.Value>
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HistoricalData.Variation}">
                                                                    <DataTrigger.Value>
                                                                        <sys:Double>0</sys:Double>
                                                                    </DataTrigger.Value>
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Variação Percentual -->
                                                <DataGridTemplateColumn Header="Variação %" Width="130" MinWidth="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" 
                                                        Padding="6,3" 
                                                        Background="#F1F5F9"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding TrendIcon}" 
                                                                   FontSize="11"
                                                                   Margin="0,0,4,0"
                                                                   VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding HistoricalData.VariationPercentage, StringFormat=P1}" 
                                                                   FontSize="11" 
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Tendência Visual -->
                                                <DataGridTemplateColumn Header="Tendência" Width="100" MinWidth="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding TrendColor}" 
                                                        CornerRadius="4" 
                                                        Padding="8,4" 
                                                        BorderThickness="1"
                                                        BorderBrush="{Binding TrendColor}"
                                                        Margin="4,0">
                                                                <TextBlock Text="{Binding Trend}" 
                                                               FontSize="11" 
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"
                                                               Foreground="White"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Detalhes -->
                                                <DataGridTemplateColumn Header="Ações" Width="100" MinWidth="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Button Content="📋" 
                                                            Style="{StaticResource ActionButtonStyle}"
                                                            Padding="6" 
                                                            FontSize="11"
                                                            Click="BtnViewStockDetails_Click"
                                                            Tag="{Binding HistoricalData}"
                                                            ToolTip="Ver detalhes"
                                                            Width="32" Height="32"
                                                            Background="#E0F2FE"
                                                            Margin="0,0,4,0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border" 
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="4">
                                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                      VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#BAE6FD"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <Button Content="📈" 
                                                            Style="{StaticResource ActionButtonStyle}"
                                                            Padding="6" 
                                                            FontSize="11"
                                                            Click="BtnShowProductChart_Click"
                                                            Tag="{Binding HistoricalData}"
                                                            ToolTip="Ver gráfico"
                                                            Width="32" Height="32"
                                                            Background="#F0FDF4">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border" 
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="4">
                                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                      VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#BBF7D0"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </Border>

                                <!-- Resumo e Ações -->
                                <Border Grid.Row="2" 
                            Background="#F8FAFC" 
                            Padding="16" 
                            Margin="0,12,0,0"
                            BorderBrush="#E2E8F0" 
                            BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Resumo Estatístico -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📊 Resumo da Análise" 
                                           FontWeight="SemiBold" 
                                           Foreground="#475569" 
                                           Margin="0,0,0,12" 
                                           FontSize="13"/>

                                            <WrapPanel>
                                                <!-- Variação Total -->
                                                <Border Background="#EFF6FF" 
                                            CornerRadius="6" 
                                            Padding="12" 
                                            Margin="0,0,12,8"
                                            MinWidth="140">
                                                    <StackPanel>
                                                        <TextBlock Text="Variação Total" 
                                                       FontSize="11" 
                                                       Foreground="#3B82F6"
                                                       Margin="0,0,0,4"/>
                                                        <TextBlock x:Name="TxtTotalVariation" 
                                                       Text="0 unidades" 
                                                       FontWeight="Bold" 
                                                       FontSize="13"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Maior Aumento -->
                                                <Border Background="#F0F9FF" 
                                            CornerRadius="6" 
                                            Padding="12" 
                                            Margin="0,0,12,8"
                                            MinWidth="140">
                                                    <StackPanel>
                                                        <TextBlock Text="Maior Aumento" 
                                                       FontSize="11" 
                                                       Foreground="#0EA5E9"
                                                       Margin="0,0,0,4"/>
                                                        <TextBlock x:Name="TxtMaxIncrease" 
                                                       Text="0%" 
                                                       FontWeight="Bold" 
                                                       FontSize="13"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Maior Queda -->
                                                <Border Background="#FEF2F2" 
                                            CornerRadius="6" 
                                            Padding="12" 
                                            Margin="0,0,12,8"
                                            MinWidth="140">
                                                    <StackPanel>
                                                        <TextBlock Text="Maior Queda" 
                                                       FontSize="11" 
                                                       Foreground="#EF4444"
                                                       Margin="0,0,0,4"/>
                                                        <TextBlock x:Name="TxtMaxDecrease" 
                                                       Text="0%" 
                                                       FontWeight="Bold" 
                                                       FontSize="13"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Produtos Analisados -->
                                                <Border Background="#F0FDF4" 
                                            CornerRadius="6" 
                                            Padding="12"
                                            MinWidth="140">
                                                    <StackPanel>
                                                        <TextBlock Text="Produtos Analisados" 
                                                       FontSize="11" 
                                                       Foreground="#10B981"
                                                       Margin="0,0,0,4"/>
                                                        <TextBlock x:Name="TxtProductsAnalyzed" 
                                                       Text="0" 
                                                       FontWeight="Bold" 
                                                       FontSize="13"/>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Botões de Ação -->
                                        <StackPanel Grid.Column="1" 
                                        Orientation="Vertical" 
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        MinWidth="180">
                                            <Button x:Name="BtnCompareDates" 
                                        Content="📅 Comparar Datas" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnCompareDates_Click" 
                                        Padding="12,8" 
                                        FontSize="12"
                                        Margin="0,0,0,8"
                                        ToolTip="Comparar stock entre duas datas específicas"
                                        HorizontalAlignment="Stretch"/>

                                            <Button x:Name="BtnShowChart" 
                                        Content="📈 Ver Gráfico Completo" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnShowChart_Click" 
                                        Padding="12,8" 
                                        FontSize="12"
                                        ToolTip="Visualizar gráfico de todas as variações"
                                        HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Mensagem quando não há dados -->
                        <Border Grid.Row="2" x:Name="BorderNoData" 
                    Style="{StaticResource ModernCardStyle}" 
                    Margin="16,0,16,16"
                    Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                                <materialDesign:PackIcon Kind="ChartBoxOutline" 
                                             Width="48" 
                                             Height="48" 
                                             Foreground="#CBD5E1" 
                                             Margin="0,0,0,16"/>
                                <TextBlock Text="Nenhuma análise executada" 
                               FontWeight="SemiBold" 
                               FontSize="16" 
                               Foreground="#64748B"
                               Margin="0,0,0,8"/>
                                <TextBlock Text="Selecione um período e clique em 'Analisar' para ver os resultados" 
                               FontSize="13" 
                               Foreground="#94A3B8"
                               TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- TAB INVENTÁRIO -->
            <TabItem Header="📊 Inventário">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar Superior -->
                    <Border Grid.Row="0" Margin="0,0,0,16" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filtros -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Style="{StaticResource ModernCardStyle}" Padding="10" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Filtrar Movimentos" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" FontSize="13"/>
                                        <WrapPanel>
                                            <ComboBox x:Name="CmbInventoryFilterType" Width="120" 
                                                      materialDesign:HintAssist.Hint="Tipo" 
                                                      SelectedIndex="0" Margin="0,0,6,6">
                                                <ComboBoxItem Content="Todos"/>
                                                <ComboBoxItem Content="Entradas"/>
                                                <ComboBoxItem Content="Saídas"/>
                                            </ComboBox>

                                            <ComboBox x:Name="CmbInventoryFilterProduct" Width="160" 
                                                      materialDesign:HintAssist.Hint="Produto"
                                                      DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,6,6"/>

                                            <DatePicker x:Name="DpInventoryFrom" Width="120" 
                                                         materialDesign:HintAssist.Hint="De" Margin="0,0,6,6"/>

                                            <DatePicker x:Name="DpInventoryTo" Width="120" 
                                                         materialDesign:HintAssist.Hint="Até"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Botões de Ação -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Style="{StaticResource ModernCardStyle}" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnNewMovement" ToolTip="Novo Movimento" Style="{StaticResource PrimaryButtonStyle}" 
                                                Background="#3B82F6" Margin="0,0,6,0" Click="BtnNewMovement_Click" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/>
                                                <TextBlock Text="Novo Movimento" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnExportInventory" ToolTip="Exportar Relatório" Style="{StaticResource SecondaryButtonStyle}" 
                                                Click="BtnExportInventory_Click" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileExport" Width="16" Height="16" Margin="0,0,4,0"/>
                                                <TextBlock Text="Exportar" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Conteúdo do Inventário -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho -->
                            <Border Grid.Row="0" Padding="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊 Movimentos de Inventário" FontWeight="SemiBold" FontSize="16" Foreground="#2C3E50"/>
                                        <TextBlock x:Name="TxtMovementCount" Text=" (0)" FontWeight="SemiBold" Foreground="#64748B" FontSize="16"/>
                                    </StackPanel>
                                    <TextBlock Text="Registro completo de todas as entradas e saídas de stock" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>

                            <!-- DataGrid de Movimentos -->
                            <DataGrid Grid.Row="1" x:Name="DgInventoryMovements" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="1" BorderBrush="#E2E8F0" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" 
                        Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" 
                        Width="120"/>

                                    <DataGridTextColumn Header="Produto" 
                        Binding="{Binding Product.Name}" 
                        Width="*"/>

                                    <!-- Coluna Tipo com badge colorido -->
                                    <DataGridTemplateColumn Header="Tipo" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#D1FAE5" BorderBrush="#10B981" 
                        CornerRadius="4" Padding="6,3" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MovementType}" Value="Saída">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding MovementType}" 
                               FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#065F46">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MovementType}" Value="Saída">
                                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Coluna Quantidade com sinal + ou - (SEM CONVERTER) -->
                                    <DataGridTextColumn Header="Quantidade" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Text" Value="{Binding Quantity, StringFormat=N0}"/>
                                                <Style.Triggers>
                                                    <!-- Entrada: sinal verde + -->
                                                    <DataTrigger Binding="{Binding MovementType}" Value="Entrada">
                                                        <Setter Property="Text">
                                                            <Setter.Value>
                                                                <MultiBinding StringFormat="+{0:N0}">
                                                                    <Binding Path="Quantity"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                    </DataTrigger>
                                                    <!-- Saída: sinal vermelho − -->
                                                    <DataTrigger Binding="{Binding MovementType}" Value="Saída">
                                                        <Setter Property="Text">
                                                            <Setter.Value>
                                                                <MultiBinding StringFormat="−{0:N0}">
                                                                    <Binding Path="Quantity"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Stock Anterior" 
                        Binding="{Binding PreviousStock, StringFormat=N0}" 
                        Width="100"/>

                                    <DataGridTextColumn Header="Novo Stock" 
                        Binding="{Binding NewStock, StringFormat=N0}" 
                        Width="100"/>

                                    <DataGridTextColumn Header="Motivo" 
                        Binding="{Binding Reason}" 
                        Width="150"/>

                                    <DataGridTextColumn Header="Usuário" 
                        Binding="{Binding User.Username}" 
                        Width="120"/>

                                    <DataGridTextColumn Header="Observações" 
                        Binding="{Binding Notes}" 
                        Width="*"/>
                                </DataGrid.Columns>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,8"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGrid.CellStyle>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB COMPRAS/REQUISIÇÕES -->
            <TabItem Header="🛒 Compras">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar Superior -->
                    <Border Grid.Row="0" Margin="0,0,0,16" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filtros -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Style="{StaticResource ModernCardStyle}" Padding="10" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Filtrar Compras" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" FontSize="13"/>
                                        <WrapPanel>
                                            <ComboBox x:Name="CmbPurchaseFilterStatus" Width="120"
                                          materialDesign:HintAssist.Hint="Status"
                                          SelectedIndex="0" Margin="0,0,6,6">
                                                <ComboBoxItem Content="Todos"/>
                                                <ComboBoxItem Content="Pendentes"/>
                                                <ComboBoxItem Content="Recebidas"/>
                                                <ComboBoxItem Content="Canceladas"/>
                                            </ComboBox>
                                            <ComboBox x:Name="CmbPurchaseFilterSupplier" Width="160"
                                          materialDesign:HintAssist.Hint="Fornecedor"
                                          DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,6,6"/>
                                            <DatePicker x:Name="DpPurchaseFrom" Width="120"
                                            materialDesign:HintAssist.Hint="De" Margin="0,0,6,6"/>
                                            <DatePicker x:Name="DpPurchaseTo" Width="120"
                                            materialDesign:HintAssist.Hint="Até"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Botões de Ação -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Style="{StaticResource ModernCardStyle}" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnNewPurchase" ToolTip="Nova Compra" Style="{StaticResource PrimaryButtonStyle}"
                                    Background="#F59E0B" Margin="0,0,6,0" Click="BtnNewPurchase_Click" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CartPlus" Width="16" Height="16" Margin="0,0,4,0"/>
                                                <TextBlock Text="Nova Compra" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnExportPurchases" ToolTip="Exportar Relatório" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnExportPurchases_Click" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileExport" Width="16" Height="16" Margin="0,0,4,0"/>
                                                <TextBlock Text="Exportar" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Lista de Compras -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho -->
                            <Border Grid.Row="0" Padding="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛒 Histórico de Compras" FontWeight="SemiBold" FontSize="16" Foreground="#2C3E50"/>
                                        <TextBlock x:Name="TxtPurchaseCount" Text=" (0)" FontWeight="SemiBold" Foreground="#64748B" FontSize="16"/>
                                    </StackPanel>
                                    <TextBlock Text="Registro de todas as requisições e compras realizadas" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>

                            <!-- DataGrid de Compras -->
                            <DataGrid Grid.Row="1" x:Name="DgPurchases" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="DgPurchases_SelectionChanged" BorderThickness="1" BorderBrush="#E2E8F0" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Número" Binding="{Binding PurchaseNumber}" Width="80"/>
                                    <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy'}" Width="100"/>
                                    <DataGridTextColumn Header="Fornecedor" Binding="{Binding Supplier.Name}" Width="*"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding PurchaseType}" Width="100"/>
                                    <DataGridTextColumn Header="Itens" Binding="{Binding ItemCount}" Width="60"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat='N2 MTn'}" Width="100"/>

                                    <!-- Coluna Status com badge colorido -->
                                    <DataGridTemplateColumn Header="Status" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#FEF3C7" BorderBrush="#F59E0B"
                                            CornerRadius="4" Padding="6,3" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Recebida">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelada">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#92400E">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Recebida">
                                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelada">
                                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Coluna Ações - SEM CONVERTER -->
                                    <DataGridTemplateColumn Header="Ações" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Ver"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="6,4"
                                                Click="BtnViewPurchase_Click"
                                                Tag="{Binding}"
                                                FontSize="11"
                                                Margin="0,0,4,0"/>

                                                    <Button Content="Receber"
                                                Padding="6,4"
                                                Click="BtnReceivePurchase_Click"
                                                Tag="{Binding}"
                                                FontSize="11"
                                                Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pendente">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Content="Cancelar"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="6,4"
                                                Click="BtnCancelPurchase_Click"
                                                Tag="{Binding}"
                                                FontSize="11"
                                                Margin="0,0,4,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,8"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGrid.CellStyle>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <!-- TAB CÓDIGO DE BARRAS -->
            <!-- TAB CÓDIGO DE BARRAS -->
            <!-- TAB CÓDIGO DE BARRAS -->
            <TabItem Header="📊 Códigos de Barras">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar Superior -->
                        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Informações -->
                                <Border Style="{StaticResource ModernCardStyle}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="🎯 Gerador de Códigos de Barras" 
                                       FontWeight="SemiBold" Foreground="#475569" 
                                       Margin="0,0,0,6" FontSize="13"/>
                                        <TextBlock Text="Crie códigos de barras para impressão nos produtos" 
                                       FontSize="12" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>

                                <!-- Botões de Ação -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Style="{StaticResource ModernCardStyle}" Padding="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnGenerateAllBarcodes" Content="🔢 Gerar Todos" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnGenerateAllBarcodes_Click" 
                                        Padding="12,8" FontSize="12" Margin="0,0,6,0"
                                        ToolTip="Gerar códigos de barras para todos os produtos sem código"/>
                                            <Button x:Name="BtnPrintBarcodes" Content="🖨️ Imprimir" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnPrintBarcodes_Click" 
                                        Padding="12,8" FontSize="12"
                                        ToolTip="Imprimir códigos de barras dos produtos selecionados"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Lista de Produtos para Geração de Códigos -->
                        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Cabeçalho -->
                                <Border Grid.Row="0" Padding="12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📦 Produtos para Gerar Códigos" 
                                               FontWeight="SemiBold" FontSize="16" 
                                               Foreground="#2C3E50"/>
                                                <TextBlock x:Name="TxtBarcodeProductsCount" Text=" (0)" 
                                               FontWeight="SemiBold" Foreground="#64748B" 
                                               FontSize="16"/>
                                            </StackPanel>
                                            <TextBlock Text="Selecione os produtos para gerar códigos de barras" 
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Botões de seleção rápida -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✓ Todos" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnSelectAllBarcodes_Click" 
                                        Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                                            <Button Content="✗ Nenhum" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnDeselectAllBarcodes_Click" 
                                        Padding="8,4" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- DataGrid de Produtos -->
                                <DataGrid Grid.Row="1" x:Name="DgBarcodeProducts" 
                              AutoGenerateColumns="False" 
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              RowHeight="40"
                              BorderThickness="1,0,1,0"
                              BorderBrush="#E2E8F0"
                              FontSize="12"
                              Background="Transparent"
                              Margin="0,8,0,0"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch">

                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        </Style>

                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,8"/>
                                            <Setter Property="Foreground" Value="#334155"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E0E7FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.Columns>
                                        <!-- Coluna de Seleção -->
                                        <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Click="BarcodeProductCheckBox_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Código -->
                                        <DataGridTextColumn Header="Código" 
                                                Binding="{Binding Code}" 
                                                Width="100" MinWidth="80"/>

                                        <!-- Nome -->
                                        <DataGridTextColumn Header="Nome" 
                                                Binding="{Binding Name}" 
                                                Width="*" MinWidth="150"/>

                                        <!-- Preço -->
                                        <DataGridTextColumn Header="Preço" 
                                                Binding="{Binding Price, StringFormat='N2 MTn'}" 
                                                Width="100" MinWidth="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="Foreground" Value="#059669"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Stock -->
                                        <DataGridTextColumn Header="Stock" 
                                                Binding="{Binding Stock, StringFormat=N0}" 
                                                Width="80" MinWidth="60">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Código de Barras -->
                                        <DataGridTextColumn Header="Cód. Barras" 
                                                Binding="{Binding Barcode}" 
                                                Width="150" MinWidth="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Courier New"/>
                                                    <Setter Property="Foreground" Value="#7C3AED"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Status do Código -->
                                        <DataGridTemplateColumn Header="Status" Width="100" MinWidth="80" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="4,2" 
                                                Background="#D1FAE5" 
                                                BorderBrush="#10B981"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtStatus" 
                                                       Text="OK" 
                                                       FontSize="10" 
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Pré-visualização -->
                                        <DataGridTemplateColumn Header="Visualizar" Width="120" MinWidth="100" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" 
                                                Background="White" Padding="2"
                                                Height="35"
                                                CornerRadius="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                        <Viewbox Stretch="Uniform" Width="100" Height="30">
                                                            <Image x:Name="BarcodePreview" 
                                                       Source="{Binding BarcodeImage}"
                                                       Stretch="Uniform"
                                                       Tag="{Binding Id}"/>
                                                        </Viewbox>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Rodapé com estatísticas -->
                                <Border Grid.Row="2" Background="#F8FAFC" Padding="12,8"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Estatísticas -->
                                        <StackPanel Grid.Column="0">
                                            <WrapPanel>
                                                <TextBlock FontWeight="Medium" Foreground="#475569" FontSize="12">
                                        <Run Text="📊"/>
                                        <Run Text="Selecionados:"/>
                                        <Run x:Name="TxtSelectedCount" Text="0" Foreground="#4F46E5" FontWeight="Bold"/>
                                        <Run Text="/"/>
                                        <Run x:Name="TxtTotalCount" Text="0"/>
                                                </TextBlock>
                                                <TextBlock FontWeight="Medium" Foreground="#475569" FontSize="12" Margin="12,0,0,0">
                                        <Run Text="• Com código:"/>
                                        <Run x:Name="TxtWithBarcodeCount" Text="0" Foreground="#10B981" FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock FontWeight="Medium" Foreground="#475569" FontSize="12" Margin="12,0,0,0">
                                        <Run Text="• Sem código:"/>
                                        <Run x:Name="TxtWithoutBarcodeCount" Text="0" Foreground="#F59E0B" FontWeight="Bold"/>
                                                </TextBlock>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Botão de atualização -->
                                        <Button Grid.Column="1" Content="🔄 Atualizar" 
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnRefreshBarcodeList_Click"
                                    Padding="8,4" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Configurações de Impressão -->
                        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Configurações -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="⚙️ Configurações de Impressão" 
                                   FontWeight="SemiBold" Foreground="#475569" 
                                   Margin="0,0,0,8" FontSize="13"/>

                                    <WrapPanel Margin="0,0,0,8">
                                        <!-- Número de cópias -->
                                        <StackPanel Margin="0,0,16,8" Width="140">
                                            <TextBlock Text="Códigos por Produto" 
                                           Style="{StaticResource RequiredFieldLabelStyle}"/>
                                            <TextBox x:Name="TxtBarcodeCopies" Text="1" 
                                         Height="32" FontSize="12"
                                         Style="{StaticResource ValidatedTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- Incluir linhas divisórias -->
                                        <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                                            <CheckBox x:Name="ChkIncludeDividers" 
                                          Content="Incluir linhas divisórias"
                                          IsChecked="True" Margin="0,6,0,0"
                                          FontSize="12" Foreground="#475569"/>
                                        </StackPanel>

                                        <!-- Tamanho do código -->
                                        <StackPanel Margin="0,0,16,8" Width="100">
                                            <TextBlock Text="Largura (mm)" 
                                           Style="{StaticResource RequiredFieldLabelStyle}"/>
                                            <TextBox x:Name="TxtBarcodeWidth" Text="50" 
                                         Height="32" FontSize="12"
                                         Style="{StaticResource ValidatedTextBoxStyle}"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,8" Width="100">
                                            <TextBlock Text="Altura (mm)" 
                                           Style="{StaticResource RequiredFieldLabelStyle}"/>
                                            <TextBox x:Name="TxtBarcodeHeight" Text="25" 
                                         Height="32" FontSize="12"
                                         Style="{StaticResource ValidatedTextBoxStyle}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Visualização e Informações da Impressora -->
                                <Border Grid.Row="1" BorderBrush="#E2E8F0" 
                            BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Informações da Impressora -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🖨️ Informações da Impressão" 
                                           FontWeight="SemiBold" Foreground="#475569" 
                                           Margin="0,0,0,6" FontSize="13"/>

                                            <WrapPanel>
                                                <Border Background="#F0F9FF" CornerRadius="6" Padding="8" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Impressora Configurada" 
                                                       FontSize="11" Foreground="#0EA5E9"/>
                                                        <TextBlock x:Name="TxtPrinterName" Text="Não configurada" 
                                                       FontWeight="SemiBold" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Text="Certifique-se de que a impressora está ligada e tem papel" 
                                           FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <!-- Visualização -->
                                        <Border Grid.Column="1" BorderBrush="#CBD5E1" 
                                    BorderThickness="1" Padding="10" 
                                    Background="#F8FAFC" CornerRadius="6" Margin="12,0,0,0"
                                    Width="200">
                                            <StackPanel>
                                                <TextBlock Text="👁️ Visualização" 
                                               FontWeight="SemiBold" Foreground="#475569" 
                                               Margin="0,0,0,8" FontSize="13"/>

                                                <Border BorderBrush="#CBD5E1" BorderThickness="1" 
                                            Background="White" Padding="8" CornerRadius="4">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <!-- Nome do Produto -->
                                                        <TextBlock x:Name="TxtPreviewName" 
                                                       Text="Nome do Produto" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="10" 
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="160"
                                                       Margin="0,0,0,4"/>

                                                        <!-- Código de Barras -->
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" 
                                                    Padding="2" Background="White" Margin="0,4,0,4">
                                                            <Image x:Name="ImgBarcodePreview" 
                                                       Stretch="Uniform" 
                                                       Height="40" 
                                                       Width="140"/>
                                                        </Border>

                                                        <!-- Informações -->
                                                        <StackPanel Margin="0,4,0,0">
                                                            <TextBlock x:Name="TxtPreviewPrice" 
                                                           Text="Preço: 0,00 MTn" 
                                                           FontSize="9" 
                                                           TextAlignment="Center"
                                                           Foreground="#475569"/>
                                                            <TextBlock x:Name="TxtPreviewCode" 
                                                           Text="Código: XXXXX" 
                                                           FontSize="8" 
                                                           Foreground="#64748B"
                                                           TextAlignment="Center"/>
                                                            <TextBlock x:Name="TxtPreviewBarcode" 
                                                           Text="1234567890123" 
                                                           FontSize="7" 
                                                           Foreground="#94A3B8"
                                                           TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Button x:Name="BtnRefreshPreview" 
                                            Content="🔄 Atualizar" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BtnRefreshPreview_Click" 
                                            Margin="0,8,0,0" Padding="6,4" FontSize="10"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- TAB FORNECEDORES -->
            <TabItem Header="🏢 Fornecedores">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar Superior -->
                    <Border Grid.Row="0" Margin="0,0,0,16" Padding="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Style="{StaticResource ModernCardStyle}" Padding="10">
                                <Button x:Name="BtnNewSupplier" ToolTip="Novo Fornecedor" Style="{StaticResource PrimaryButtonStyle}" 
                                        Background="#8B5CF6" Padding="12,8" Click="BtnNewSupplier_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/>
                                        <TextBlock Text="Novo Fornecedor" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lista de Fornecedores -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho -->
                            <Border Grid.Row="0" Padding="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏢 Fornecedores" FontWeight="SemiBold" FontSize="16" Foreground="#2C3E50"/>
                                        <TextBlock x:Name="TxtSupplierCount" Text=" (0)" FontWeight="SemiBold" Foreground="#64748B" FontSize="16"/>
                                    </StackPanel>
                                    <TextBlock Text="Gerencie os fornecedores da sua empresa" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>

                            <!-- DataGrid de Fornecedores -->
                            <DataGrid Grid.Row="1" x:Name="DgSuppliers" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="DgSuppliers_SelectionChanged" BorderThickness="1" BorderBrush="#E2E8F0" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="NIF" Binding="{Binding NIF}" Width="100"/>
                                    <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="120"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                                    <DataGridTextColumn Header="Cidade" Binding="{Binding City}" Width="100"/>

                                    <!-- Coluna Status com badge colorido (Ativo/Inativo) - SEM CONVERTER -->
                                    <DataGridTemplateColumn Header="Status" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#D1FAE5" BorderBrush="#10B981"
                                    CornerRadius="4" Padding="6,3" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Active}" Value="False">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Ativo" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#065F46">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Ativo"/>
                                                                <Setter Property="Foreground" Value="#065F46"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Active}" Value="False">
                                                                        <Setter Property="Text" Value="Inativo"/>
                                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Compras" Binding="{Binding PurchaseCount}" Width="70"/>

                                    <!-- Coluna Ações -->
                                    <DataGridTemplateColumn Header="Ações" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}" Padding="6,4"
                                        Click="EditSupplier_Click" Tag="{Binding}" FontSize="11" Margin="0,0,4,0"/>
                                                    <Button Content="Excluir" Style="{StaticResource SecondaryButtonStyle}" Padding="6,4"
                                        Click="BtnDeleteSupplier_Click" Tag="{Binding}" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,8"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGrid.CellStyle>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>