<UserControl x:Class="AyGestRest.Views.ProductsManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:AyGestRest.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Gradiente para o cabeçalho -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <!-- Cores translúcidas para WPF -->
        <SolidColorBrush x:Key="TranslucentWhite" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="SemiTransparentText" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="LightCardBackground" Color="#F8FAFC"/>

        <!-- Estilo para os títulos das seções -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Estilo para labels de campo obrigatório -->
        <Style x:Key="RequiredFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Estilo para campos com validação -->
        <Style x:Key="ValidatedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para cartões modernos -->
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1A000000" BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para popups -->
        <Style x:Key="PopupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1A000000" BlurRadius="24" ShadowDepth="8" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para cartões de lista -->
        <Style x:Key="ListCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1A000000" BlurRadius="6" ShadowDepth="1" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botões principais -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botões secundários -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para botões de ação -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botões de fechar popup -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Indicador de campo obrigatório -->
        <Style x:Key="RequiredIndicatorStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="*"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- Estilo para badges -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <!-- Estilo para status -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Overlay para popups -->
        <Grid x:Name="OverlayGrid" Panel.ZIndex="1000" Visibility="Collapsed">
            <Border Background="#00000040"/>

            <!-- Popup de Produto -->
            <!-- Popup de Produto -->
            <!-- Popup de Produto -->
<Border x:Name="ProductPopup"
        Style="{StaticResource PopupCardStyle}"
        Width="480"
        MaxHeight="520"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Visibility="Collapsed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho do Popup -->
        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtFormTitle" Text="Novo Produto"
                               FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,2"/>
                    <TextBlock Text="Preencha os campos obrigatórios (*)"
                               Foreground="#64748B" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Click="CloseProductPopup_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- Conteúdo do Popup (com scroll) -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      Padding="16"
                      VerticalAlignment="Stretch">
            <StackPanel>
                <!-- Informações Básicas -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Informações Básicas" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" FontSize="13"/>
                    
                    <!-- Nome -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Nome do Produto" Style="{StaticResource RequiredFieldLabelStyle}"/>
                            <TextBlock Style="{StaticResource RequiredIndicatorStyle}"/>
                        </StackPanel>
                        <TextBox x:Name="TxtName" materialDesign:HintAssist.Hint="Ex: Pizza Margherita"
                                 Style="{StaticResource ValidatedTextBoxStyle}" Height="32"/>
                    </StackPanel>
                    
                    <!-- Código -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Código/SKU" Style="{StaticResource RequiredFieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtCode" materialDesign:HintAssist.Hint="Ex: PIZZA-MARG"
                                     Style="{StaticResource ValidatedTextBoxStyle}" Height="32"/>
                            <Button Grid.Column="1" Content="Gerar" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="6,0,0,0" Padding="4" Click="BtnGenerateCode_Click" Height="32"/>
                        </Grid>
                        <TextBlock Text="Código único para identificar o produto" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- Categoria e Preço -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Categoria" Style="{StaticResource RequiredFieldLabelStyle}"/>
                                <TextBlock Style="{StaticResource RequiredIndicatorStyle}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbCategory" materialDesign:HintAssist.Hint="Selecionar categoria"
                                      DisplayMemberPath="Nome" SelectedValuePath="Id" Height="32"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Preço de Venda" Style="{StaticResource RequiredFieldLabelStyle}"/>
                                <TextBlock Style="{StaticResource RequiredIndicatorStyle}"/>
                            </StackPanel>
                            <TextBox x:Name="TxtSalePrice" materialDesign:HintAssist.Hint="0,00 MTn"
                                     Style="{StaticResource ValidatedTextBoxStyle}" Height="32"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Stock -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Stock Atual" Style="{StaticResource RequiredFieldLabelStyle}"/>
                        <TextBox x:Name="TxtStock" materialDesign:HintAssist.Hint="Quantidade em stock"
                                 Style="{StaticResource ValidatedTextBoxStyle}" Height="32"/>
                    </StackPanel>
                    
                    <!-- Código de Barras -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <Expander Header="📊 Código de Barras" IsExpanded="False" FontSize="12">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableBarcode" Content="Usar código de barras"
                                          Checked="ChkEnableBarcode_Changed" Unchecked="ChkEnableBarcode_Changed"
                                          FontWeight="Medium" Foreground="#475569" Margin="0,0,0,6"/>
                                <Grid x:Name="BarcodeGrid" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Código de Barras" Style="{StaticResource RequiredFieldLabelStyle}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtBarcode" materialDesign:HintAssist.Hint="Ex: 123456789012"
                                                 Style="{StaticResource ValidatedTextBoxStyle}" Height="32"/>
                                        <TextBlock Text="Use um scanner para ler o código" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📷 Scanner" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="12,22,0,0" Padding="8,6" Click="BtnScanBarcode_Click"
                                            ToolTip="Simular leitura de scanner"/>
                                                <!-- Adicionar este botão dentro do Grid do código de barras -->
                                                <Button Grid.Column="1" Content="📊 Gerar" 
        Style="{StaticResource SecondaryButtonStyle}"
        Margin="6,22,0,0" Padding="6,4" 
        Click="BtnGenerateBarcode_Click"
        ToolTip="Gerar código de barras automaticamente"/>
                                            </Grid>
                            </StackPanel>
                        </Expander>
                    </Border>
                    
                </StackPanel>
                
                <!-- Descrição -->
                <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                    <Expander Header="✏️ Descrição (opcional)" IsExpanded="False" FontSize="12">
                        <StackPanel>
                            <TextBlock Text="Descreva o produto para clientes e funcionários"
                                       FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtDescription" Height="50" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     materialDesign:HintAssist.Hint="Descrição detalhada do produto..." FontSize="12"/>
                        </StackPanel>
                    </Expander>
                </Border>
                
                <!-- Configurações -->
                            <!-- Configurações -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="⚙️ Configurações" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" FontSize="13"/>
                                    <StackPanel Orientation="Vertical" Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkActive" Content="Produto Ativo" IsChecked="True"
                      FontWeight="Medium" Foreground="#475569" FontSize="12"/>
                                        <TextBlock Text="Produtos inativos não aparecem nas vendas"
                       FontSize="10" Foreground="#94A3B8" Margin="20,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <CheckBox x:Name="ChkIsComposite" Content="Produto Composto"
                      Checked="ChkIsComposite_CheckChanged" Unchecked="ChkIsComposite_CheckChanged"
                      FontWeight="Medium" Foreground="#475569" FontSize="12"/>
                                        <TextBlock Text="Produtos compostos usam receita de ingredientes"
                       FontSize="10" Foreground="#94A3B8" Margin="20,2,0,0"/>
                                    </StackPanel>

                                    <!-- NOVO: Impressão na Cozinha -->
                                    <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                                        <CheckBox x:Name="ChkPrintToKitchen" Content="Imprimir na cozinha" IsChecked="True"
                      FontWeight="Medium" Foreground="#475569" FontSize="12"/>
                                        <TextBlock Text="Este produto será impresso na cozinha quando pedido"
                       FontSize="10" Foreground="#94A3B8" Margin="20,2,0,0"/>

                                        <!-- Informação da impressora configurada -->
                                        <Border Background="#E0F2FE" CornerRadius="4" Padding="6" Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtKitchenPrinterInfo" 
                               Text="Carregando configuração..."
                               FontSize="9" Foreground="#475569" TextWrapping="Wrap"/>
                                                <TextBlock Text="Configure em: Configurações > Impressão"
                               FontSize="8" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Imagem -->
                <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                    <Expander Header="🖼️ Imagem do Produto" IsExpanded="False" FontSize="12">
                        <StackPanel>
                            <TextBlock Text="Adicione uma imagem para melhor identificação"
                                       FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="4" Height="80">
                                        <Viewbox Stretch="Uniform" MaxWidth="200" MaxHeight="70">
                                            <Image x:Name="ImgProduct" Stretch="Uniform"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Button Content="📁 Carregar" Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BtnLoadImage_Click" Margin="0,0,6,0" Padding="8,4" FontSize="11" Height="28"/>
                                        <Button Content="🗑️ Remover" Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BtnRemoveImage_Click" Padding="8,4" FontSize="11" Height="28"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander>
                </Border>
                
                <!-- Receita (apenas para compostos) -->
                <Border x:Name="CardRecipe" Visibility="Collapsed" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📋 Receita do Produto" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" FontSize="13"/>
                        <TextBlock Text="Adicione os ingredientes necessários para preparar este produto"
                                   FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

                        <!-- Adicionar Ingrediente -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbAddIngredient" 
                                          materialDesign:HintAssist.Hint="Selecione um ingrediente"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          Height="28" FontSize="11"/>
                                <TextBox x:Name="TxtQuantityAdd"
                                         Grid.Column="1"
                                         materialDesign:HintAssist.Hint="Quantidade"
                                         Height="28" FontSize="11"
                                         Margin="4,0,0,0"
                                         TextAlignment="Right"/>
                                <TextBlock Grid.Column="2"
                                           Text="un"
                                           FontSize="11" Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="4,0,0,0"/>
                                <Button Grid.Column="3"
                                        Content="➕"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnAddIngredient_Click"
                                        Height="28" Width="28"
                                        FontSize="11"
                                        Margin="4,0,0,0"
                                        ToolTip="Adicionar ingrediente"/>
                            </Grid>
                        </Border>

                        <!-- Lista de Ingredientes -->
                                    <DataGrid x:Name="DgRecipe"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserReorderColumns="False"
          CanUserResizeColumns="True"
          CanUserResizeRows="False"
          CanUserSortColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          HeadersVisibility="Column"
          RowHeight="28"
          FontSize="11"
          Height="120"
          Margin="0,0,0,8">
                                        <DataGrid.Columns>
                                            <!-- CORREÇÃO: Usar Binding com caminho completo -->
                                            <DataGridTextColumn Header="Ingrediente" 
                            Binding="{Binding Ingredient.Name}"
                            Width="*"
                            MinWidth="120"/>
                                            <DataGridTextColumn Header="Quantidade" 
                            Binding="{Binding QuantityUsed, StringFormat=N2}"
                            Width="70" />
                                            <!-- CORREÇÃO: Usar caminho completo -->
                                            <DataGridTextColumn Header="Unidade" 
                            Binding="{Binding Ingredient.Unit}"
                            Width="50"/>
                                            <!-- CORREÇÃO: Usar caminho completo -->
                                            <DataGridTextColumn Header="Custo Unit." 
                            Binding="{Binding Ingredient.Cost, StringFormat=N2}"
                            Width="70" />
                                            <!-- CORREÇÃO: Calcular o total -->
                                            <DataGridTextColumn Header="Custo Total" 
                            Width="70">
                                                <DataGridTextColumn.Binding>
                                                    <MultiBinding StringFormat="N2">
                                                        <Binding Path="Ingredient.Cost"/>
                                                        <Binding Path="QuantityUsed"/>
                                                    </MultiBinding>
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="" Width="30">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="❌"
                            FontSize="9"
                            Padding="1"
                            Height="20" Width="20"
                            Click="BtnRemoveRecipeItem_Click"
                            Tag="{Binding IngredientId}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Resumo da Receita -->
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Resumo da Receita"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="#475569"
                                               Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtRecipeSummary"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Custo Total:"
                                               FontSize="11"
                                               Foreground="#475569"
                                               Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtTotalRecipeCost"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#2C3E50"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
