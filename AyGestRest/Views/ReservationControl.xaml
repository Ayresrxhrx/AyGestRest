<UserControl x:Class="AyGestRest.Views.ReservationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AyGestRest.Views"
             mc:Ignorable="d"
             Background="#F5F7FA">

    <UserControl.Resources>
        <!-- Estilos Gerais -->
        <Style x:Key="ModernBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.1" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14 10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14 10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14 10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14 10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Cores de Status -->
        <SolidColorBrush x:Key="StatusConfirmada" Color="#10B981"/>
        <SolidColorBrush x:Key="StatusPendente" Color="#F59E0B"/>
        <SolidColorBrush x:Key="StatusCancelada" Color="#EF4444"/>
        <SolidColorBrush x:Key="StatusConcluida" Color="#6B7280"/>
        <SolidColorBrush x:Key="StatusAtiva" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="StatusAtrasada" Color="#F97316"/>

        <!-- Formulário -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0 0 0 6"/>
        </Style>

        <!-- DataTemplate para Lista de Reservas -->
        <DataTemplate x:Key="ReservaItemTemplate">
            <Border Margin="0 0 0 8" 
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    Background="White"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Horário -->
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="15" 
                                   FontWeight="Bold" 
                                   Foreground="#111827"
                                   Text="{Binding Inicio, StringFormat='HH\\:mm'}"/>
                        <TextBlock FontSize="12" 
                                   Foreground="#6B7280"
                                   Text="{Binding Fim, StringFormat='HH\\:mm'}"/>
                    </StackPanel>

                    <!-- Detalhes -->
                    <StackPanel Grid.Column="1" Margin="12 0">
                        <TextBlock Text="{Binding NomeCliente}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#111827"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                            <TextBlock Text="Mesa " 
                                       FontSize="12" 
                                       Foreground="#6B7280"/>
                            <TextBlock Text="{Binding RestaurantTable.Nome}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       Foreground="#4B5563"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                            <TextBlock Text="{Binding NumPessoas}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       Foreground="#4B5563"/>
                            <TextBlock Text=" pessoas" 
                                       FontSize="12" 
                                       Foreground="#6B7280"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Código -->
                    <Border Grid.Column="2" 
                            Margin="0 0 12 0" 
                            Padding="6 2"
                            Background="#EEF2FF"
                            BorderBrush="#C7D2FE"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ToolTip="Código de verificação">
                        <StackPanel>
                            <TextBlock Text="{Binding CodigoVerificacao}" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#4F46E5"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Código" 
                                       FontSize="9" 
                                       Foreground="#6366F1"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <Border Grid.Column="3" 
                            Padding="8 4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="Confirmada">
                                        <Setter Property="Background" Value="{StaticResource StatusConfirmada}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Pendente">
                                        <Setter Property="Background" Value="{StaticResource StatusPendente}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Cancelada">
                                        <Setter Property="Background" Value="{StaticResource StatusCancelada}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Concluida">
                                        <Setter Property="Background" Value="{StaticResource StatusConcluida}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Ativa">
                                        <Setter Property="Background" Value="{StaticResource StatusAtiva}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Atrasada}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusAtrasada}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding EstadoDisplay}" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Estilo para botões toggle (filtros) -->
        <Style x:Key="ToggleFilterButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUNA ESQUERDA: Calendário e Estatísticas -->
        <StackPanel Grid.Column="0">
            <!-- Estatísticas -->
            <Border Style="{StaticResource ModernBorder}" Margin="0 0 0 12">
                <StackPanel>
                    <TextBlock Text="📊 Estatísticas do Dia" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#111827"/>

                    <Grid Margin="0 12 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Confirmadas -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#D1FAE5" 
                                Padding="8" 
                                Margin="0 0 4 4">
                            <StackPanel>
                                <TextBlock Text="✅ Confirmadas" 
                                           FontSize="11" 
                                           Foreground="#065F46"/>
                                <TextBlock x:Name="TxtConfirmadas" 
                                           Text="0" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#065F46"/>
                            </StackPanel>
                        </Border>

                        <!-- Pendentes -->
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="#FEF3C7" 
                                Padding="8" 
                                Margin="4 0 0 4">
                            <StackPanel>
                                <TextBlock Text="⏳ Pendentes" 
                                           FontSize="11" 
                                           Foreground="#92400E"/>
                                <TextBlock x:Name="TxtPendentes" 
                                           Text="0" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#92400E"/>
                            </StackPanel>
                        </Border>

                        <!-- Ativas -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Background="#EDE9FE" 
                                Padding="8" 
                                Margin="0 4 4 0">
                            <StackPanel>
                                <TextBlock Text="🔓 Ativas" 
                                           FontSize="11" 
                                           Foreground="#5B21B6"/>
                                <TextBlock x:Name="TxtAtivas" 
                                           Text="0" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#5B21B6"/>
                            </StackPanel>
                        </Border>

                        <!-- Canceladas -->
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="#FEE2E2" 
                                Padding="8" 
                                Margin="4 4 0 0">
                            <StackPanel>
                                <TextBlock Text="❌ Canceladas" 
                                           FontSize="11" 
                                           Foreground="#991B1B"/>
                                <TextBlock x:Name="TxtCanceladas" 
                                           Text="0" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="#991B1B"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Calendário -->
            <Border Style="{StaticResource ModernBorder}">
                <StackPanel>
                    <TextBlock Text="📅 Selecionar Data" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#374151"
                               Margin="0 0 0 12"/>

                    <Calendar x:Name="CalendarReservas" 
                              SelectedDatesChanged="CalendarReservas_SelectedDatesChanged"
                              BorderThickness="0"
                              Background="Transparent"/>

                    <!-- Data selecionada -->
                    <Border Background="#F3F4F6" 
                            Padding="12" 
                            Margin="0 12 0 0">
                        <StackPanel>
                            <TextBlock Text="Data selecionada:" 
                                       FontSize="12" 
                                       Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtDataSelecionada" 
                                       Text="Hoje" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#111827"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- COLUNA DIREITA: Lista e Formulário -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho e Filtros -->
            <Border Grid.Row="0" Style="{StaticResource ModernBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="📋 Reservas" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#111827"/>
                        <TextBlock x:Name="TxtTotalReservas" 
                                   Text=" (0)" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#4F46E5"
                                   Margin="4 0 0 0"/>
                    </StackPanel>

                    <!-- Filtros -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <ToggleButton x:Name="BtnFiltroTodas" 
                                      Content="Todas" 
                                      Margin="0 0 8 0"
                                      Style="{StaticResource ToggleFilterButton}"
                                      Checked="BtnFiltroTodas_Checked"
                                      IsChecked="True"/>
                        <ToggleButton x:Name="BtnFiltroConfirmadas" 
                                      Content="Confirmadas" 
                                      Margin="0 0 8 0"
                                      Style="{StaticResource ToggleFilterButton}"
                                      Checked="BtnFiltroConfirmadas_Checked"/>
                        <ToggleButton x:Name="BtnFiltroPendentes" 
                                      Content="Pendentes" 
                                      Margin="0 0 8 0"
                                      Style="{StaticResource ToggleFilterButton}"
                                      Checked="BtnFiltroPendentes_Checked"/>
                        <ToggleButton x:Name="BtnFiltroAtivas" 
                                      Content="Ativas" 
                                      Style="{StaticResource ToggleFilterButton}"
                                      Checked="BtnFiltroAtivas_Checked"/>
                    </StackPanel>

                    <!-- Ações Rápidas -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnAtualizar" 
                                Content="🔄 Atualizar" 
                                Click="BtnAtualizar_Click"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0 0 8 0"/>
                        <Button x:Name="BtnExportar" 
                                Content="📤 Exportar" 
                                Click="BtnExportar_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Lista de Reservas -->
            <Border Grid.Row="2" Style="{StaticResource ModernBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView x:Name="ListaReservas" 
                              SelectionChanged="ListaReservas_SelectionChanged"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemTemplate="{StaticResource ReservaItemTemplate}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Mensagem quando não há reservas -->
                    <Border Grid.Row="0" 
                            x:Name="BorderSemReservas" 
                            Visibility="Collapsed"
                            Background="#F9FAFB"
                            Padding="40">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📅" 
                                       FontSize="48" 
                                       HorizontalAlignment="Center"
                                       Margin="0 0 0 16"/>
                            <TextBlock Text="Nenhuma reserva encontrada" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Selecione uma data ou crie uma nova reserva" 
                                       FontSize="14" 
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       Margin="0 8 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- Controles -->
                    <Border Grid.Row="1" 
                            Background="#F9FAFB" 
                            Padding="12"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0 1 0 0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnNovaReserva" 
                                    Content="➕ Nova Reserva" 
                                    Click="BtnNovaReserva_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0 0 8 0"/>
                            <!-- Adicione este botão -->
                            <!-- No StackPanel das ações rápidas (Grid.Column="2") -->
                            <Button x:Name="BtnImprimirTodas" 
        Content="🖨️ Todas" 
        Click="BtnImprimirTodas_Click"
        Style="{StaticResource SecondaryButton}"
        Margin="0 0 8 0"/>
                            <Button x:Name="BtnImprimirCodigo" 
        Content="🖨️ Imprimir Código" 
        Click="BtnImprimirCodigo_Click"
        Style="{StaticResource SecondaryButton}"
        Margin="0 0 8 0"
        IsEnabled="False"/>
                            <Button x:Name="BtnAtivarReserva" 
                                    Content="🔓 Ativar" 
                                    Click="BtnAtivarReserva_Click"
                                    Style="{StaticResource SuccessButton}"
                                    Margin="0 0 8 0"
                                    IsEnabled="False"/>
                            <Button x:Name="BtnCancelarReserva" 
                                    Content="❌ Cancelar" 
                                    Click="BtnCancelarReserva_Click"
                                    Style="{StaticResource DangerButton}"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FORMULÁRIO FLUTUANTE -->
        <Border x:Name="FormularioOverlay" 
                Grid.Column="0" Grid.ColumnSpan="3"
                Background="#CC000000"
                Visibility="Collapsed"
                Panel.ZIndex="1000">
            <Border Style="{StaticResource ModernBorder}"
                    Width="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Border Background="#4F46E5" 
                            Padding="20 16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtTituloForm" 
                                       Text="Nova Reserva" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="White"/>
                            <Button x:Name="BtnFecharForm" 
                                    Grid.Column="1"
                                    Content="✕" 
                                    Width="32" Height="32"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Click="BtnFecharForm_Click"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Formulário -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="20">
                        <StackPanel>
                            <!-- Cliente -->
                            <TextBlock Text="Cliente *" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ComboCliente" 
                                      DisplayMemberPath="Nome"
                                      Height="40"
                                      FontSize="14"
                                      Margin="0 0 0 16"/>

                            <!-- Mesa -->
                            <TextBlock Text="Mesa *" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ComboMesa" 
                                      DisplayMemberPath="Number"
                                      Height="40"
                                      FontSize="14"
                                      Margin="0 0 0 16"/>

                            <!-- Data e Hora Início -->
                            <TextBlock Text="Início *" Style="{StaticResource FormLabel}"/>
                            <Grid Margin="0 0 0 16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="DpInicio" 
                                            Grid.Column="0"
                                            Height="40"
                                            FontSize="14"/>
                                <TextBox x:Name="TbHoraInicio" 
                                         Grid.Column="2"
                                         Height="40"
                                         FontSize="14"
                                         Padding="8"
                                         Text="19:00"/>
                            </Grid>

                            <!-- Data e Hora Fim -->
                            <TextBlock Text="Fim *" Style="{StaticResource FormLabel}"/>
                            <Grid Margin="0 0 0 16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="DpFim" 
                                            Grid.Column="0"
                                            Height="40"
                                            FontSize="14"/>
                                <TextBox x:Name="TbHoraFim" 
                                         Grid.Column="2"
                                         Height="40"
                                         FontSize="14"
                                         Padding="8"
                                         Text="21:00"/>
                            </Grid>

                            <!-- Número de Pessoas -->
                            <TextBlock Text="Número de Pessoas *" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TbNumPessoas" 
                                     Height="40"
                                     FontSize="14"
                                     Padding="8"
                                     Margin="0 0 0 16"
                                     Text="2"/>

                            <!-- Estado -->
                            <TextBlock Text="Estado" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ComboEstado" 
                                      Height="40"
                                      FontSize="14"
                                      Margin="0 0 0 16"/>

                            <!-- Código de Verificação -->
                            <TextBlock Text="Código de Verificação" Style="{StaticResource FormLabel}"/>
                            <Grid Margin="0 0 0 16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCodigoVerificacao" 
                                         Grid.Column="0"
                                         Height="40"
                                         FontSize="16"
                                         FontWeight="Bold"
                                         Padding="8"
                                         TextAlignment="Center"
                                         Background="#F3F4F6"
                                         IsReadOnly="True"/>
                                <Button x:Name="BtnGerarCodigo" 
                                        Grid.Column="1"
                                        Content="🔄 Gerar" 
                                        Height="40"
                                        Margin="8 0 0 0"
                                        Padding="12 0"
                                        Click="BtnGerarCodigo_Click"
                                        Style="{StaticResource SecondaryButton}"/>
                            </Grid>

                            <!-- Informações -->
                            <Border Background="#F0F9FF" 
                                    Padding="12"
                                    Margin="0 0 0 20">
                                <StackPanel>
                                    <TextBlock Text="💡 Informações" 
                                               FontSize="12" 
                                               FontWeight="Bold"
                                               Foreground="#0369A1"/>
                                    <TextBlock Text="• O código será enviado ao cliente" 
                                               FontSize="11" 
                                               Foreground="#0C4A6E"
                                               Margin="0 4 0 0"/>
                                    <TextBlock Text="• Use o código para ativar a mesa no PDV" 
                                               FontSize="11" 
                                               Foreground="#0C4A6E"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botões do Formulário -->
                    <Border Grid.Row="2" 
                            Background="#F9FAFB" 
                            Padding="20"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0 1 0 0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancelarForm" 
                                    Content="Cancelar" 
                                    Click="BtnCancelarForm_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0 0 12 0"/>
                            <Button x:Name="BtnSalvarReserva" 
                                    Content="💾 Salvar Reserva" 
                                    Click="BtnSalvarReserva_Click"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>