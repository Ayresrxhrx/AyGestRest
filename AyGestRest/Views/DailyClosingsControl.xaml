<UserControl x:Class="AyGestRest.Views.DailyClosingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AyGestRest.Views"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F7F9FC">

    <UserControl.Resources>
        <!-- Cores -->
        <SolidColorBrush x:Key="PrimaryColor">#4A6BFF</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessColor">#00C853</SolidColorBrush>
        <SolidColorBrush x:Key="WarningColor">#FF9100</SolidColorBrush>
        <SolidColorBrush x:Key="DangerColor">#FF5252</SolidColorBrush>
        <SolidColorBrush x:Key="InfoColor">#00B8D4</SolidColorBrush>
        <SolidColorBrush x:Key="DarkColor">#263238</SolidColorBrush>
        <SolidColorBrush x:Key="LightGray">#F5F7FA</SolidColorBrush>

        <!-- Estilos -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#20000000" BlurRadius="20" ShadowDepth="2" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource DarkColor}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="FECHO DO DIA" 
                             FontSize="28" 
                             FontWeight="Bold"
                             Foreground="{StaticResource DarkColor}"/>

                    <TextBlock x:Name="txtPeriodo" 
                             FontSize="14" 
                             Foreground="#666666"
                             Margin="0,4,0,0">
                        <Run Text="Período: "/>
                        <Run x:Name="runStartDate" Text="--/--/---- --:--"/>
                        <Run Text=" até "/>
                        <Run x:Name="runEndDate" Text="--/--/---- --:--"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="{StaticResource PrimaryColor}" 
                          Width="140" 
                          Height="80" 
                          Margin="8,0,4,0"
                          VerticalAlignment="Center"
                          CornerRadius="8">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtTotalVendidoHeader" 
                                     Text="0,00"
                                     FontSize="22"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="TOTAL VENDIDO"
                                     FontSize="11"
                                     Foreground="#E0E0E0"
                                     HorizontalAlignment="Center"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SuccessColor}" 
                          Width="140" 
                          Height="80" 
                          Margin="4,0,0,0"
                          VerticalAlignment="Center"
                          CornerRadius="8">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtTotalDinheiroHeader" 
                                     Text="0,00"
                                     FontSize="22"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="DINHEIRO"
                                     FontSize="11"
                                     Foreground="#E0E0E0"
                                     HorizontalAlignment="Center"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- COLUNA ESQUERDA -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <!-- RESUMO FINANCEIRO -->
                    <Border Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <TextBlock Text="RESUMO FINANCEIRO" Style="{StaticResource HeaderText}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total Vendido:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtTotalVendido" 
                                                 Grid.Column="1" 
                                                 FontSize="16"
                                                 FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dinheiro:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtDinheiro" 
                                                 Grid.Column="1" 
                                                 FontSize="16"
                                                 FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Outros Pagamentos:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtOutros" 
                                                 Grid.Column="1" 
                                                 FontSize="16"
                                                 FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Lucro Bruto Estimado:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtLucro" 
                                                 Grid.Column="1" 
                                                 FontSize="16"
                                                 FontWeight="Bold"
                                                 Foreground="{StaticResource SuccessColor}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Nº de Vendas:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtNumeroVendas" 
                                                 Grid.Column="1" 
                                                 FontSize="16"
                                                 FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ticket Médio:" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtTicketMedio" 
                                                 Grid.Column="1" 
                                                 FontSize="16"
                                                 FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DESPESAS DO DIA -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="DESPESAS DO DIA" Style="{StaticResource HeaderText}">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF6B6B" Offset="0"/>
                                        <GradientStop Color="#FF8E53" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💰" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Total de Compras Hoje:" 
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtTotalDespesas" 
                                                   Grid.Column="1" 
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#FF6B6B"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📦" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Número de Compras:" 
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtNumeroCompras" 
                                                   Grid.Column="1" 
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#FF8E53"/>
                                    </Grid>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                        Content="VER DETALHES"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        Margin="16,0,0,0"
                                        Click="BtnVerComprasHoje_Click"/>
                            </Grid>

                            <!-- LISTA DE COMPRAS DO DIA -->
                            <Border Background="#F8F9FA" 
                                    CornerRadius="8" 
                                    Padding="12" 
                                    Margin="0,8,0,0"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" 
                                               Text="COMPRAS DO DIA"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,0,8"/>

                                    <ScrollViewer Grid.Row="1" 
                                                  MaxHeight="150"
                                                  VerticalScrollBarVisibility="Auto">
                                        <DataGrid x:Name="dgComprasHoje" 
                                                  AutoGenerateColumns="False"
                                                  HeadersVisibility="Column"
                                                  IsReadOnly="True"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  FontSize="11"
                                                  RowHeight="28">
                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                </Style>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nº" 
                                                                    Binding="{Binding PurchaseNumber}" 
                                                                    Width="80"/>
                                                <DataGridTextColumn Header="Fornecedor" 
                                                                    Binding="{Binding Fornecedor}" 
                                                                    Width="*"/>
                                                <DataGridTextColumn Header="Hora" 
                                                                    Binding="{Binding CreatedAt, StringFormat=HH:mm}" 
                                                                    Width="60"/>
                                                <DataGridTextColumn Header="Itens" 
                                                                    Binding="{Binding Itens}" 
                                                                    Width="50">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Valor" 
                                                                    Binding="{Binding Valor, StringFormat=N2}" 
                                                                    Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- SALDO LÍQUIDO -->
                            <Border Background="{StaticResource LightGray}" 
                                    CornerRadius="8" 
                                    Padding="16,12" 
                                    Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SALDO LÍQUIDO DO DIA"
                                                   FontSize="12"
                                                   Foreground="#666666"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="txtSaldoLiquido"
                                                   Text="0,00 MTn"
                                                   FontSize="24"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="(Vendas - Despesas)"
                                                   FontSize="10"
                                                   Foreground="#999999"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="24"
                                            Background="#F0F0F0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="💰" 
                                                   FontSize="24" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- MÉTODOS DE PAGAMENTO -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="MÉTODOS DE PAGAMENTO" Style="{StaticResource HeaderText}"/>

                            <DataGrid ItemsSource="{Binding SalesByPaymentMethod}" 
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      BorderThickness="1"
                                      BorderBrush="#E0E0E0"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F8F9FA"
                                      FontSize="13"
                                      RowHeight="36"
                                      Height="200">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Método" 
                                                        Binding="{Binding MethodName}" 
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Quantidade" 
                                                        Binding="{Binding Count}" 
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Valor" 
                                                        Binding="{Binding Amount, StringFormat={}{0:N2}}" 
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="%" 
                                                        Binding="{Binding Percentage, StringFormat={}{0:0.0}%}" 
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- COLUNA DIREITA -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <!-- CONTAGEM DE CAIXA -->
                    <Border Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <TextBlock Text="CONTAGEM DE CAIXA" Style="{StaticResource HeaderText}"/>

                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="VALOR REGISTRADO (DINHEIRO)" 
                                           FontSize="13" 
                                           Foreground="#666666"
                                           Margin="0,0,0,4"/>

                                <Border Background="{StaticResource LightGray}" 
                                        Padding="16,12"
                                        Margin="0,0,0,16"
                                        CornerRadius="8">
                                    <TextBlock x:Name="txtTotalDinheiroRegistrado"
                                               Text="0,00 MTn"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="VALOR CONTADO FÍSICO" 
                                           FontSize="13" 
                                           Foreground="#666666"
                                           Margin="0,0,0,4"/>

                                <TextBox x:Name="txtValorContado" 
                                         FontSize="20"
                                         FontWeight="Bold"
                                         TextAlignment="Right"
                                         Padding="16,12"
                                         BorderBrush="#CCCCCC"
                                         BorderThickness="1"
                                         PreviewTextInput="TxtValorContado_PreviewTextInput"
                                         TextChanged="TxtValorContado_TextChanged"/>

                                <TextBlock Text="DIFERENÇA" 
                                           FontSize="13" 
                                           Foreground="#666666"
                                           Margin="0,24,0,8"/>

                                <Border x:Name="borderDiferenca"
                                        Padding="16,12"
                                        Background="#F5F5F5"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtDiferenca"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtDiferencaStatus"
                                                   FontSize="14"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- GRÁFICO -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="DISTRIBUIÇÃO POR MÉTODO" Style="{StaticResource HeaderText}"/>
                            <oxy:PlotView Model="{Binding PieModel}" Height="250"/>
                        </StackPanel>
                    </Border>

                    <!-- AÇÕES -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="AÇÕES" Style="{StaticResource HeaderText}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="EXPORTAR"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnExportar_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2" Background="White" Margin="0,16,0,0" Padding="24" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnConfirmar"
                        Content="CONFIRMAR FECHO DO DIA"
                        Style="{StaticResource PrimaryButton}"
                        Width="300"
                        Click="ConfirmarFecho_Click"/>

                <Button x:Name="btnCancelar"
                        Content="CANCELAR"
                        Style="{StaticResource SecondaryButton}"
                        Width="120"
                        Margin="16,0,0,0"
                        Click="BtnCancelar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>