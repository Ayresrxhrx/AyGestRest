<Window x:Class="AyGestRest.Views.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tela do Cliente - AyGestRest"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Gradientes e Cores Modernas -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A1929" Offset="0"/>
            <GradientStop Color="#1A365D" Offset="0.4"/>
            <GradientStop Color="#0F172A" Offset="0.8"/>
            <GradientStop Color="#1E293B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#EC4899" Offset="0.5"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#34D399" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#FBBF24" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#38BDF8" Offset="1"/>
        </LinearGradientBrush>

        <!-- Typography Scale Modern -->
        <Style x:Key="DisplayLarge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DisplayMedium" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Heading1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Heading2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="BodyLarge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="BodyMedium" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="BodySmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PriceStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10B981" Offset="0"/>
                        <GradientStop Color="#34D399" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplate Modern para Itens -->
        <DataTemplate x:Key="ModernItemTemplate">
            <Border Margin="0,6,0,6" Padding="16" Background="#18FFFFFF">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ícone e Quantidade -->
                    <Border Grid.Column="0" 
                            Background="{StaticResource AccentGradient}"
                            Width="48" 
                            Height="48"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#8B5CF6" Opacity="0.5"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding Quantity}" 
                                   FontSize="20" 
                                   FontWeight="Black" 
                                   Foreground="White"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Detalhes do Produto -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" 
                                   Style="{StaticResource Heading2}"
                                   Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1E293B" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:F2} MT/un'}"
                                           Style="{StaticResource BodySmall}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Subtotal com Animação -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:F2} MT'}"
                                   Style="{StaticResource PriceStyle}"/>
                        <TextBlock Text="Subtotal"
                                   Style="{StaticResource BodySmall}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Layout Principal com Design Moderno -->
    <Grid x:Name="MainGrid" Background="{StaticResource PrimaryGradient}">
        <!-- Background com efeito de partículas -->
        <Canvas x:Name="particleCanvas" Opacity="0.1">
            <Canvas.Effect>
                <BlurEffect Radius="2"/>
            </Canvas.Effect>
        </Canvas>

        <!-- Grid de Conteúdo Principal -->
        <Grid x:Name="ContentGrid" 
              Margin="40" 
              MinWidth="900" 
              MinHeight="650"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho Moderno -->
            <Border Grid.Row="0" 
                    Padding="24" 
                    Margin="0,0,0,20"
                    Background="#18FFFFFF">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo com Efeito Neon -->
                    <Border Grid.Column="0" 
                            Width="80" 
                            Height="80" 
                            Background="{StaticResource AccentGradient}"
                            Padding="2"
                            Margin="0,0,20,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" 
                                              Color="#8B5CF6" 
                                              Opacity="0.6"
                                              ShadowDepth="0"/>
                        </Border.Effect>
                        <Image x:Name="imgLogo" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Informações do Restaurante -->
                    <StackPanel Grid.Column="1" 
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <TextBlock Text="{Binding RestaurantName}" 
                                   Style="{StaticResource DisplayMedium}"
                                   Foreground="{StaticResource AccentGradient}"/>

                        <!-- Status com Indicador Animado -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">
                            <Ellipse Width="8" 
                                     Height="8" 
                                     Fill="#10B981"
                                     Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.3" To="1" 
                                                                         Duration="0:0:0.8"
                                                                         AutoReverse="True"
                                                                         RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="txtStatusVenda" 
                                       Text="🛒 Aguardando seu pedido..."
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="#CBD5E1"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Card da Venda Atual -->
                    <Border Grid.Column="2" 
                            Padding="20" 
                            MinWidth="220"
                            Background="{StaticResource InfoGradient}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="VENDA ATUAL" 
                                       Style="{StaticResource BodySmall}"
                                       Foreground="#E2E8F0"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="txtNumeroComanda" 
                                       Text="#000000"
                                       Style="{StaticResource DisplayLarge}"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,8"/>

                            <Border Background="#00000040" 
                                    Padding="8,4"
                                    Margin="0,0,0,8">
                                <TextBlock x:Name="txtMesaAtual" 
                                           Text="Balcão"
                                           Style="{StaticResource BodyLarge}"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Contador de Itens com Badge -->
                            <Border Background="#FFFFFF30"
                                    Padding="12,6"
                                    Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="📦"
                                               Style="{StaticResource BodyLarge}"
                                               Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtContadorItens"
                                               Text="0 itens"
                                               Style="{StaticResource BodyLarge}"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Painel de Métricas em Tempo Real -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card: Produtos -->
                <Border Grid.Column="0" 
                        Margin="0,0,10,0" 
                        Padding="20"
                        Background="#18FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtContadorProdutos" 
                                   Text="0"
                                   Style="{StaticResource DisplayLarge}"
                                   Foreground="#8B5CF6"/>
                        <TextBlock Text="PRODUTOS" 
                                   Style="{StaticResource BodySmall}"
                                   Foreground="#CBD5E1" 
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Itens diferentes"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="#94A3B8"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Card: Quantidade Total -->
                <Border Grid.Column="1" 
                        Margin="10,0,10,0" 
                        Padding="20"
                        Background="#18FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtContadorQuantidade" 
                                   Text="0"
                                   Style="{StaticResource DisplayLarge}"
                                   Foreground="#10B981"/>
                        <TextBlock Text="QUANTIDADE" 
                                   Style="{StaticResource BodySmall}"
                                   Foreground="#CBD5E1" 
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Unidades totais"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="#94A3B8"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Card: Tempo da Venda -->
                <Border Grid.Column="2" 
                        Margin="10,0,10,0" 
                        Padding="20"
                        Background="#18FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtTempoVenda" 
                                   Text="00:00:00"
                                   Style="{StaticResource DisplayLarge}"
                                   Foreground="#F59E0B"/>
                        <TextBlock Text="TEMPO" 
                                   Style="{StaticResource BodySmall}"
                                   Foreground="#CBD5E1" 
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Desde o início"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="#94A3B8"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Card: Valor Médio -->
                <Border Grid.Column="3" 
                        Margin="10,0,0,0" 
                        Padding="20"
                        Background="#18FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtValorMedio" 
                                   Text="0,00"
                                   Style="{StaticResource DisplayLarge}"
                                   Foreground="#EC4899"/>
                        <TextBlock Text="VALOR MÉDIO" 
                                   Style="{StaticResource BodySmall}"
                                   Foreground="#CBD5E1" 
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Por produto"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="#94A3B8"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Área de Conteúdo Dinâmico -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <!-- Estado: Boas-vindas -->
                <Border x:Name="panelBoasVindas" 
                        Padding="40"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Width="600"
                        Background="#18FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Ícone Animado -->
                        <Viewbox Width="120" Height="120" Margin="0,0,0,20">
                            <Canvas>
                                <!-- Círculo de fundo -->
                                <Ellipse Width="120" Height="120" 
                                         Stroke="{StaticResource AccentGradient}"
                                         StrokeThickness="3"
                                         Opacity="0.3"/>

                                <!-- Mão acenando -->
                                <Path Data="M40,60 Q50,40 60,60 Q70,40 80,60" 
                                      Stroke="{StaticResource AccentGradient}"
                                      StrokeThickness="4"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="Bem-vindo ao" 
                                   Style="{StaticResource BodyLarge}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding RestaurantName}" 
                                   Style="{StaticResource DisplayMedium}"
                                   Foreground="{StaticResource AccentGradient}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Aguardamos o seu pedido..." 
                                   Style="{StaticResource BodyLarge}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,30"/>

                        <!-- Loading Animado -->
                        <Border Width="60" Height="60" HorizontalAlignment="Center">
                            <Ellipse x:Name="loadingEllipse" 
                                     Stroke="{StaticResource AccentGradient}"
                                     StrokeThickness="4" 
                                     StrokeDashArray="4 2"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Estado: Carrinho -->
                <Grid x:Name="panelCarrinho" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Lista de Itens com Header -->
                    <Border Grid.Row="0" 
                            Margin="0,0,0,20"
                            Background="#18FFFFFF">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Opacity="0.2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header da Lista -->
                            <Border Grid.Row="0" 
                                    Background="#1E293B" 
                                    Padding="24,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="📋" 
                                               Style="{StaticResource BodyLarge}"
                                               Margin="0,0,12,0"/>

                                    <TextBlock Text="SEU PEDIDO" 
                                               Style="{StaticResource Heading2}"
                                               Grid.Column="1"/>

                                    <TextBlock Text="SUBTOTAL" 
                                               Style="{StaticResource BodyLarge}"
                                               Grid.Column="2"/>
                                </Grid>
                            </Border>

                            <!-- Lista Scrollável -->
                            <ScrollViewer Grid.Row="1" 
                                          VerticalScrollBarVisibility="Auto" 
                                          Padding="24"
                                          Background="Transparent">
                                <ItemsControl x:Name="itemsControlItens"
                                              ItemTemplate="{StaticResource ModernItemTemplate}"
                                              Margin="0,12">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Painel de Totais -->
                    <Border Grid.Row="1"
                            Background="#18FFFFFF"
                            Padding="30">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Opacity="0.2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Detalhes dos Valores -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Subtotal -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Subtotal" 
                                                   Style="{StaticResource BodySmall}"/>
                                        <TextBlock x:Name="txtSubtotal" 
                                                   Text="0,00 MT"
                                                   Style="{StaticResource Heading1}"
                                                   Foreground="#CBD5E1"/>
                                    </StackPanel>

                                    <!-- Desconto -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                                        <TextBlock Text="Desconto" 
                                                   Style="{StaticResource BodySmall}"/>
                                        <TextBlock x:Name="txtDesconto" 
                                                   Text="- 0,00 MT"
                                                   Style="{StaticResource Heading2}"
                                                   Foreground="#F87171"/>
                                    </StackPanel>

                                    <!-- Forma de Pagamento -->
                                    <Border Grid.Row="0" Grid.Column="1" 
                                            Grid.RowSpan="2"
                                            Background="{StaticResource InfoGradient}"
                                            Padding="20"
                                            Margin="40,0,0,0"
                                            MinWidth="200">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="15" Opacity="0.4"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="💳" 
                                                       Style="{StaticResource BodyLarge}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="PAGAMENTO" 
                                                       Style="{StaticResource BodySmall}"
                                                       Foreground="#E2E8F0"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtFormaPagamento" 
                                                       Text="Dinheiro"
                                                       Style="{StaticResource Heading2}"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Total Final -->
                            <Border Grid.Column="1" 
                                    Background="{StaticResource SuccessGradient}" 
                                    Padding="40"
                                    Margin="40,0,0,0"
                                    MinWidth="320">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="25" Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="TOTAL A PAGAR" 
                                               Style="{StaticResource BodyLarge}"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="txtTotalFinal" 
                                               Text="0,00 MT"
                                               Style="{StaticResource DisplayLarge}"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,16"/>

                                    <!-- Status do Pagamento com Animação -->
                                    <Border Background="#FFFFFF40" 
                                            Padding="16,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.6" To="1" 
                                                                                 Duration="0:0:1.5"
                                                                                 AutoReverse="True"
                                                                                 RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="⏳"
                                                       Style="{StaticResource BodyLarge}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock x:Name="txtStatusPagamento"
                                                       Text="Aguardando pagamento"
                                                       Style="{StaticResource BodyLarge}"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Estado: Obrigado -->
                <Border x:Name="panelObrigado" 
                        Padding="40"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Width="700"
                        Background="#18FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Confetes Animados -->
                        <Viewbox Width="180" Height="180" Margin="0,0,0,20">
                            <Canvas x:Name="confettiVisual">
                                <!-- Estrelas e Confetes serão adicionados via código -->
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="🎉 OBRIGADO! 🎉" 
                                   Style="{StaticResource DisplayMedium}"
                                   Foreground="{StaticResource AccentGradient}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Pela sua preferência" 
                                   Style="{StaticResource Heading1}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,30"/>

                        <TextBlock Text="Volte sempre, será um prazer atendê-lo novamente!"
                                   Style="{StaticResource BodyLarge}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,40"/>

                        <!-- Contador Regressivo com Progresso -->
                        <Border Background="#1E293B"
                                Padding="20"
                                Width="400"
                                HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="txtContadorRegressivo"
                                           Text="Voltando em 10s..."
                                           Style="{StaticResource BodyLarge}"
                                           Foreground="#CBD5E1"
                                           HorizontalAlignment="Center"/>

                                <!-- Barra de Progresso -->
                                <Border Height="8" 
                                        Background="#334155" 
                                        Margin="0,12,0,0">
                                    <Border x:Name="progressBar" 
                                            Width="0"
                                            Background="{StaticResource AccentGradient}"
                                            HorizontalAlignment="Left"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Rodapé Moderno -->
            <Border Grid.Row="3"
                    Background="#18FFFFFF"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Informações da Empresa -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="txtDataHora" 
                                   Text="Quinta-feira, 16 de Janeiro de 2025 • 22:49:30"
                                   Style="{StaticResource BodyMedium}"/>
                        <TextBlock Text="AyGestRest © 2025 • Sistema de Gestão para Restaurantes" 
                                   Style="{StaticResource BodySmall}"
                                   Foreground="#94A3B8"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Operador Atual -->
                    <Border Grid.Column="1" 
                            Background="{StaticResource AccentGradient}"
                            Padding="16,10"
                            MinWidth="180">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <TextBlock Text="👨‍💼"
                                       Style="{StaticResource BodyLarge}"
                                       Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="OPERADOR"
                                           Style="{StaticResource BodySmall}"
                                           Foreground="#E2E8F0"/>
                                <TextBlock x:Name="txtOperador" 
                                           Text="Administrador"
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status do Sistema -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <Border Background="{StaticResource SuccessGradient}"
                                Padding="12,8"
                                MinWidth="160">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center">
                                <Ellipse Width="10" 
                                         Height="10" 
                                         Fill="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.3" To="1" 
                                                                             Duration="0:0:1"
                                                                             AutoReverse="True"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="SISTEMA ONLINE" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>