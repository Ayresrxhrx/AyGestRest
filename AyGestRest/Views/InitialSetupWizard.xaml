<Window x:Class="AyGestRest.Views.InitialSetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistente de Configuração Inicial - AyGestRest"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f8fafc"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Cores -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SecondaryLightBrush" Color="#60A5FA"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="LightGrayBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BorderGrayBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="StepActiveBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="StepCompletedBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="StepPendingBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

        <!-- Estilos -->
        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionSubtitleStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,32"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SettingLabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SettingHintStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputFieldStyle">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGrayBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SecondaryLightBrush}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox" x:Key="ComboBoxStyle">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGrayBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SecondaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGrayBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource LightGrayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SuccessButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <Style TargetType="Button" x:Key="DangerButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style TargetType="RadioButton" x:Key="RadioButtonStyle">
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox" x:Key="CheckBoxStyle">
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Estilo para os passos do progresso -->
        <Style x:Key="ProgressStepStyle" TargetType="Grid">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="40,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ícone -->
                <TextBlock Grid.Column="0" 
                           Text="🍽️" 
                           FontSize="40" 
                           Margin="0,0,20,0" 
                           VerticalAlignment="Center"/>

                <!-- Título -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Configuração Inicial do AyGestRest"
                               Foreground="White" 
                               FontSize="28" 
                               FontWeight="Bold"/>
                    <TextBlock Text="Configure seu restaurante em 6 passos simples" 
                               Foreground="#94A3B8" 
                               FontSize="16" 
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Indicador de Progresso -->
                <Border Grid.Column="2" 
                        Background="#1E293B" 
                        CornerRadius="20" 
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Passo" 
                                   Foreground="#CBD5E1" 
                                   FontSize="14"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CurrentStep}" 
                                   Foreground="White" 
                                   FontSize="20" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="/6" 
                                   Foreground="#94A3B8" 
                                   FontSize="16"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BARRA DE PROGRESSO -->
        <Border Grid.Row="1" Background="White" Padding="40,24" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Passo 1 -->
                <Grid Style="{StaticResource ProgressStepStyle}">
                    <Ellipse Width="40" Height="40">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StepPendingBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource BorderGrayBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                        <Setter Property="Fill" Value="{StaticResource StepActiveBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepActiveBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="1" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               Foreground="White"/>
                    <TextBlock Text="Restaurante" 
                               HorizontalAlignment="Center" 
                               Margin="0,48,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"/>
                </Grid>

                <!-- Linha entre passos -->
                <Rectangle Width="40" Height="2" VerticalAlignment="Center" Fill="{StaticResource BorderGrayBrush}"/>

                <!-- Passo 2 -->
                <Grid Style="{StaticResource ProgressStepStyle}">
                    <Ellipse Width="40" Height="40">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StepPendingBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource BorderGrayBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                        <Setter Property="Fill" Value="{StaticResource StepActiveBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepActiveBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="2" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               Foreground="White"/>
                    <TextBlock Text="Impressão" 
                               HorizontalAlignment="Center" 
                               Margin="0,48,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"/>
                </Grid>

                <!-- Linha entre passos -->
                <Rectangle Width="40" Height="2" VerticalAlignment="Center" Fill="{StaticResource BorderGrayBrush}"/>

                <!-- Passo 3 -->
                <Grid Style="{StaticResource ProgressStepStyle}">
                    <Ellipse Width="40" Height="40">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StepPendingBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource BorderGrayBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Fill" Value="{StaticResource StepActiveBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepActiveBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="3" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               Foreground="White"/>
                    <TextBlock Text="Segurança" 
                               HorizontalAlignment="Center" 
                               Margin="0,48,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"/>
                </Grid>

                <!-- Linha entre passos -->
                <Rectangle Width="40" Height="2" VerticalAlignment="Center" Fill="{StaticResource BorderGrayBrush}"/>

                <!-- Passo 4 -->
                <Grid Style="{StaticResource ProgressStepStyle}">
                    <Ellipse Width="40" Height="40">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StepPendingBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource BorderGrayBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Fill" Value="{StaticResource StepActiveBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepActiveBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="4" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               Foreground="White"/>
                    <TextBlock Text="Backup" 
                               HorizontalAlignment="Center" 
                               Margin="0,48,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"/>
                </Grid>

                <!-- Linha entre passos -->
                <Rectangle Width="40" Height="2" VerticalAlignment="Center" Fill="{StaticResource BorderGrayBrush}"/>

                <!-- Passo 5 -->
                <Grid Style="{StaticResource ProgressStepStyle}">
                    <Ellipse Width="40" Height="40">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StepPendingBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource BorderGrayBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                        <Setter Property="Fill" Value="{StaticResource StepActiveBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepActiveBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6">
                                        <Setter Property="Fill" Value="{StaticResource StepCompletedBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepCompletedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="5" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               Foreground="White"/>
                    <TextBlock Text="VFD" 
                               HorizontalAlignment="Center" 
                               Margin="0,48,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"/>
                </Grid>

                <!-- Linha entre passos -->
                <Rectangle Width="40" Height="2" VerticalAlignment="Center" Fill="{StaticResource BorderGrayBrush}"/>

                <!-- Passo 6 -->
                <Grid Style="{StaticResource ProgressStepStyle}" Margin="0">
                    <Ellipse Width="40" Height="40">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StepPendingBrush}"/>
                                <Setter Property="Stroke" Value="{StaticResource BorderGrayBrush}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6">
                                        <Setter Property="Fill" Value="{StaticResource StepActiveBrush}"/>
                                        <Setter Property="Stroke" Value="{StaticResource StepActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="6" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               Foreground="White"/>
                    <TextBlock Text="Finalizar" 
                               HorizontalAlignment="Center" 
                               Margin="0,48,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="40"
                      Background="{StaticResource LightGrayBrush}">
            <Grid>
                <!-- Passo 1: Restaurante -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep1Visible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <TextBlock Text="📋 Informações do Restaurante" 
                                   Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Configure as informações básicas do seu estabelecimento" 
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <!-- Card principal -->
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="12"
                                BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="1"
                                Padding="32">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nome do Restaurante -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="Nome do Restaurante *" 
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBox Text="{Binding Config.RestaurantName, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource InputFieldStyle}"/>
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="Nome que aparecerá em recibos e na interface"/>
                                </StackPanel>

                                <!-- NIF -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                           Text="NIF" 
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                                    <TextBox Text="{Binding Config.NIF}" 
                                             Style="{StaticResource InputFieldStyle}"/>
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="Número de identificação fiscal do estabelecimento"/>
                                </StackPanel>

                                <!-- Logo -->
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                           Text="Logo" 
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" 
                                                Background="{StaticResource LightGrayBrush}" 
                                                CornerRadius="8"
                                                Padding="14"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Config.LogoPath, FallbackValue='Nenhum arquivo selecionado'}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <Button Grid.Column="1" 
                                                Content="Procurar" 
                                                Click="BrowseLogo_Click" 
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                Padding="16,10"/>

                                        <Button Grid.Column="2" 
                                                Content="Visualizar" 
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="16,10"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="Recomendado: 300x300px PNG ou JPG"/>
                                </StackPanel>

                                <!-- Endereço -->
                                <TextBlock Grid.Row="3" Grid.Column="0" 
                                           Text="Endereço" 
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,16,0,0">
                                    <TextBox Text="{Binding Config.Address}" 
                                             Style="{StaticResource InputFieldStyle}"
                                             Height="60"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"/>
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="Endereço que aparecerá nos recibos"/>
                                </StackPanel>

                                <!-- Telefone -->
                                <TextBlock Grid.Row="4" Grid.Column="0" 
                                           Text="Telefone" 
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,16,0,0">
                                    <TextBox Text="{Binding Config.Phone}" 
                                             Style="{StaticResource InputFieldStyle}"/>
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="Telefone de contacto do estabelecimento"/>
                                </StackPanel>

                                <!-- Email -->
                                <TextBlock Grid.Row="5" Grid.Column="0" 
                                           Text="Email" 
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,16,0,0">
                                    <TextBox Text="{Binding Config.Email}" 
                                             Style="{StaticResource InputFieldStyle}"/>
                                    <TextBlock Style="{StaticResource SettingHintStyle}"
                                               Text="Email de contacto do estabelecimento"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Passo 2: Impressão -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep2Visible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <TextBlock Text="🖨️ Configurações de Impressão" 
                                   Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Configure as impressoras e formatos de recibos" 
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <!-- Card principal -->
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="12"
                                BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="1"
                                Padding="32">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Impressora Principal -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="Impressora de Talões" 
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding AvailablePrinters}"
                                          SelectedItem="{Binding Config.PrinterName}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Margin="0,0,12,0"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="Testar" 
                                        Click="TestMainPrinter_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                <!-- Impressora da Cozinha -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                           Text="Impressora da Cozinha" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           Margin="0,16,0,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding AvailablePrinters}"
                                          SelectedItem="{Binding Config.KitchenPrinterName}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Margin="0,16,12,0"/>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Content="Testar" 
                                        Click="TestKitchenPrinter_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,16,0,0"/>

                                <!-- Impressão para Cozinha -->
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                        Background="{StaticResource LightGrayBrush}"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,24,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Impressão Automática para Cozinha"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="PrintOrderToKitchenYes" 
                                                         Content="Sim" 
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         Checked="BooleanRadioButton_Checked"/>
                                            <RadioButton x:Name="PrintOrderToKitchenNo" 
                                                         Content="Não" 
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         Margin="20,8,0,0"
                                                         Checked="BooleanRadioButton_Checked"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SettingHintStyle}"
                                                   Text="Imprimir pedidos automaticamente na cozinha"/>
                                    </StackPanel>
                                </Border>

                                <!-- Largura do Talão -->
                                <TextBlock Grid.Row="3" Grid.Column="0" 
                                           Text="Largura do Talão (mm)" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           Margin="0,24,0,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         Text="{Binding Config.ReceiptWidth}"
                                         Style="{StaticResource InputFieldStyle}"
                                         Margin="0,24,0,0"
                                         PreviewTextInput="NumberValidationTextBox"/>
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Text="(ex: 80)"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,24,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Passo 3: Segurança -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep3Visible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <TextBlock Text="🔒 Segurança e Permissões" 
                                   Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Configure segurança e permissões de usuários" 
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <!-- Card principal -->
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="12"
                                BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="1"
                                Padding="32">
                            <StackPanel>
                                <!-- Segurança -->
                                <Border Background="{StaticResource LightGrayBrush}"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,24">
                                    <StackPanel>
                                        <TextBlock Text="Segurança"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Margin="0,0,0,12"/>

                                        <StackPanel>
                                            <TextBlock Text="Exigir login na aplicação"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RequiresLoginYes" 
                                                             Content="Sim" 
                                                             Style="{StaticResource RadioButtonStyle}"
                                                             Checked="BooleanRadioButton_Checked"/>
                                                <RadioButton x:Name="RequiresLoginNo" 
                                                             Content="Não" 
                                                             Style="{StaticResource RadioButtonStyle}"
                                                             Margin="20,8,0,0"
                                                             Checked="BooleanRadioButton_Checked"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Permissões do Funcionário -->
                                <Border Background="{StaticResource LightGrayBrush}"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,24">
                                    <StackPanel>
                                        <TextBlock Text="Permissões do Funcionário"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Margin="0,0,0,12"/>

                                        <CheckBox x:Name="ChkFechoDia" 
                                                  Content="Pode fazer fecho diário" 
                                                  Style="{StaticResource CheckBoxStyle}"/>
                                        <CheckBox x:Name="ChkReservas" 
                                                  Content="Pode gerir reservas" 
                                                  Style="{StaticResource CheckBoxStyle}"/>
                                        <CheckBox x:Name="ChkHistorico" 
                                                  Content="Pode ver histórico de vendas" 
                                                  Style="{StaticResource CheckBoxStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Interface -->
                                <Border Background="{StaticResource LightGrayBrush}"
                                        CornerRadius="8"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Interface"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Margin="0,0,0,12"/>

                                        <StackPanel>
                                            <TextBlock Text="Efeitos sonoros"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="SoundEffectsYes" 
                                                             Content="Sim" 
                                                             Style="{StaticResource RadioButtonStyle}"
                                                             Checked="BooleanRadioButton_Checked"/>
                                                <RadioButton x:Name="SoundEffectsNo" 
                                                             Content="Não" 
                                                             Style="{StaticResource RadioButtonStyle}"
                                                             Margin="20,8,0,0"
                                                             Checked="BooleanRadioButton_Checked"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Margin="0,16,0,0">
                                            <TextBlock Text="Modo escuro"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="DarkModeYes" 
                                                             Content="Sim" 
                                                             Style="{StaticResource RadioButtonStyle}"
                                                             Checked="BooleanRadioButton_Checked"/>
                                                <RadioButton x:Name="DarkModeNo" 
                                                             Content="Não" 
                                                             Style="{StaticResource RadioButtonStyle}"
                                                             Margin="20,8,0,0"
                                                             Checked="BooleanRadioButton_Checked"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Passo 4: Backup -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep4Visible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <TextBlock Text="💾 Configurações de Backup" 
                                   Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Configure backups automáticos e localização" 
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <!-- Card principal -->
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="12"
                                BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="1"
                                Padding="32">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Pasta de Backup -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="Pasta de Backup" 
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{StaticResource LightGrayBrush}" 
                                        CornerRadius="8"
                                        Padding="14"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Config.BackupPath, FallbackValue='Nenhuma pasta selecionada'}" 
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Procurar" 
                                            Click="BrowseBackupFolder_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Abrir" 
                                            Click="OpenBackupFolder_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>

                                <!-- Backup Automático -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                           Text="Backup Automático" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           Margin="0,24,0,0"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                                            Orientation="Horizontal" Margin="0,24,0,0">
                                    <RadioButton x:Name="AutoBackupYes" 
                                                 Content="Sim" 
                                                 Style="{StaticResource RadioButtonStyle}"
                                                 Checked="BooleanRadioButton_Checked"/>
                                    <RadioButton x:Name="AutoBackupNo" 
                                                 Content="Não" 
                                                 Style="{StaticResource RadioButtonStyle}"
                                                 Margin="20,8,0,0"
                                                 Checked="BooleanRadioButton_Checked"/>
                                </StackPanel>

                                <!-- Backup Diário -->
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                           Text="Backup Diário" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           Margin="0,16,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" 
                                            Orientation="Horizontal" Margin="0,16,0,0">
                                    <RadioButton x:Name="BackupDiarioYes" 
                                                 Content="Sim" 
                                                 Style="{StaticResource RadioButtonStyle}"
                                                 Checked="BooleanRadioButton_Checked"/>
                                    <RadioButton x:Name="BackupDiarioNo" 
                                                 Content="Não" 
                                                 Style="{StaticResource RadioButtonStyle}"
                                                 Margin="20,8,0,0"
                                                 Checked="BooleanRadioButton_Checked"/>
                                </StackPanel>

                                <!-- Botão Backup Agora -->
                                <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                        Content="Fazer Backup Agora" 
                                        Click="BackupNow_Click"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Margin="0,32,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Passo 5: VFD -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep5Visible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <TextBlock Text="📺 Tela VFD (Display do Cliente)" 
                                   Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Configure o display para clientes" 
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <!-- Card principal -->
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="12"
                                BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="1"
                                Padding="32">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ativar VFD -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="Ativar Tela VFD" 
                                           Style="{StaticResource SettingLabelStyle}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" 
                                            Orientation="Horizontal">
                                    <RadioButton x:Name="VFDEenabledYes" 
                                                 Content="Sim" 
                                                 Style="{StaticResource RadioButtonStyle}"
                                                 Checked="BooleanRadioButton_Checked"/>
                                    <RadioButton x:Name="VFDEenabledNo" 
                                                 Content="Não" 
                                                 Style="{StaticResource RadioButtonStyle}"
                                                 Margin="20,8,0,0"
                                                 Checked="BooleanRadioButton_Checked"/>
                                </StackPanel>

                                <!-- Porta COM -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                           Text="Porta COM" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           Margin="0,16,0,0"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,16,12,0">
                                    <ComboBox ItemsSource="{Binding AvailableCOMPorts}"
                                              SelectedItem="{Binding SelectedCOMPort}"
                                              Style="{StaticResource ComboBoxStyle}"
                                              Width="120"
                                              Margin="0,0,8,0"/>
                                    <Button Content="Detectar" 
                                            Click="DetectCOMPorts_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Content="Testar Conexão" 
                                        Click="TestVFDConnection_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,16,0,0"/>

                                <!-- Configurações do Display -->
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                           Text="Configurações do Display" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           Margin="0,16,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Linhas" 
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding DisplayLines}"
                                                  SelectedItem="{Binding SelectedDisplayLines}"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  Width="80"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Colunas" 
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding DisplayColumns}"
                                                  SelectedItem="{Binding SelectedDisplayColumns}"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  Width="80"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Baud Rate" 
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding BaudRates}"
                                                  SelectedItem="{Binding SelectedBaudRate}"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  Width="100"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Preview VFD -->
                                <TextBlock Grid.Row="3" Grid.Column="0" 
                                           Text="Pré-visualização" 
                                           Style="{StaticResource SettingLabelStyle}"
                                           Margin="0,24,0,0"/>
                                <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                        Background="#0F172A"
                                        CornerRadius="8"
                                        Padding="20"
                                        Margin="0,24,0,0"
                                        Height="120">
                                    <TextBlock Text="{Binding VFDPreviewText}"
                                               Foreground="#3B82F6"
                                               FontFamily="Consolas"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Border>

                                <!-- Botão Atualizar Preview -->
                                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                        Content="Atualizar Preview no VFD" 
                                        Click="UpdateVFDPreview_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Margin="0,24,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Passo 6: Finalizar -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep6Visible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <TextBlock Text="🎉 Revisão Final" 
                                   Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Pronto para começar! Revise suas configurações" 
                                   Style="{StaticResource SectionSubtitleStyle}"/>

                        <!-- Card principal -->
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="12"
                                BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="1"
                                Padding="32">
                            <StackPanel>
                                <TextBlock Text="✅ Configuração Concluída!"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,32"/>

                                <Border Background="#0F172A"
                                        CornerRadius="12"
                                        Padding="40"
                                        Height="300"
                                        Margin="0,0,0,32">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Config.RestaurantName, FallbackValue='O SEU RESTAURANTE'}" 
                                                   FontSize="36" 
                                                   FontWeight="ExtraBold" 
                                                   Foreground="#FFD700" 
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,16"/>
                                        <TextBlock Text="Obrigado pela preferência!" 
                                                   FontSize="28" 
                                                   Foreground="#64B5F6" 
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,16"/>
                                        <TextBlock Text="Volte sempre 😊" 
                                                   FontSize="24" 
                                                   Foreground="#95A5A6" 
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Clique em 'Concluir' para salvar todas as configurações e iniciar o AyGestRest."
                                           FontSize="16"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="3" 
                Background="White" 
                Padding="40,24"
                BorderBrush="{StaticResource BorderGrayBrush}"
                BorderThickness="1,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título do passo atual -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentStepTitle}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding StepDescription}" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Botões de Navegação -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" 
                            Style="{StaticResource DangerButtonStyle}"
                            Click="Cancel_Click"/>

                    <Button Content="Anterior" 
                            IsEnabled="{Binding CanGoBack}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Previous_Click"
                            Margin="12,0,0,0"/>

                    <Button Content="{Binding NextButtonText}"
                            Style="{StaticResource SuccessButtonStyle}"
                            Click="NextOrFinish_Click"
                            Margin="12,0,0,0"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>