<!-- WhatsAppApiConfigDialog.xaml -->
<Window x:Class="AyGestRest.Views.WhatsAppApiConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar WhatsApp Business API" 
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuração da API do WhatsApp Business"
                  FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Token de Acesso:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtAccessToken" Height="30" Margin="0,0,0,15"
                    ToolTip="Token de acesso da API do WhatsApp Business"/>

            <TextBlock Text="ID do Número de Telefone:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPhoneNumberId" Height="30" Margin="0,0,0,15"
                    ToolTip="ID do número de telefone do WhatsApp Business"/>

            <TextBlock Text="ID da Conta Business (opcional):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtBusinessAccountId" Height="30" Margin="0,0,0,20"/>

            <Button Content="ℹ️ Como obter estas credenciais?" 
                   Click="Help_Click"
                   HorizontalAlignment="Left"
                   Background="Transparent"
                   BorderBrush="LightGray"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="100" Height="35" Margin="0,0,10,0"
                   Click="Cancel_Click"/>
            <Button Content="Salvar" Width="100" Height="35"
                   Background="#25D366" Foreground="White"
                   Click="OK_Click"/>
        </StackPanel>
    </Grid>
</Window>