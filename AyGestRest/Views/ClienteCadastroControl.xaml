<UserControl x:Class="AyGestRest.Controls.ClienteCadastroControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Estilos -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E6F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="16" 
                                      Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#3498DB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#B3D7FF"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#B3D7FF"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#21618C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B3CEE5"/>
                    <Setter Property="Foreground" Value="#95A5A6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#484E53"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A0A8AF"/>
                    <Setter Property="Foreground" Value="#95A5A6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#3498DB"/>
                    <Setter Property="Background" Value="#F8F9FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveTabButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ícone animado -->
        <Storyboard x:Key="SuccessAnimation" RepeatBehavior="1x">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Estilo para DataGrid -->
        <Style x:Key="ClientDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        </Style>

        <!-- Estilo para células da DataGrid -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#2C3E50"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="White" Padding="20"
                BorderBrush="#E0E6F0" BorderThickness="0,0,0,1"
                Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ícone -->
                <Border Grid.Column="0" 
                        Background="#E3F2FD" 
                        Width="48" 
                        Height="48" 
                        Margin="0,0,12,0">
                    <TextBlock Text="👥" 
                               FontSize="24" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Título e descrição -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GERENCIAMENTO DE CLIENTES" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Foreground="#2C3E50"/>
                    <TextBlock Text="Cadastre novos clientes, edite informações ou visualize a lista completa" 
                               FontSize="12" 
                               Foreground="#6C757D"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Badge de total de clientes -->
                <Border Grid.Column="2" 
                        Background="#3498DB" 
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" 
                                   FontSize="12" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock x:Name="txtTotalClientes" 
                                   Text="0 clientes" 
                                   FontSize="11"
                                   FontWeight="SemiBold" 
                                   Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Conteúdo principal com abas -->
        <Grid Grid.Row="1" Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Abas -->
            <Border Grid.Row="0" 
                    Background="White" 
                    Padding="0,0,0,1"
                    BorderBrush="#E0E6F0" 
                    BorderThickness="0,0,0,1"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnTabCadastro" 
                            Content="📝 CADASTRAR CLIENTE" 
                            Style="{StaticResource ActiveTabButtonStyle}"
                            Click="BtnTabCadastro_Click"/>
                    <Button x:Name="btnTabLista" 
                            Content="📋 LISTA DE CLIENTES" 
                            Style="{StaticResource TabButtonStyle}"
                            Margin="1,0,0,0"
                            Click="BtnTabLista_Click"/>
                </StackPanel>
            </Border>

            <!-- Conteúdo das abas -->
            <Grid Grid.Row="1">
                <!-- Conteúdo da aba de Cadastro -->
                <ScrollViewer x:Name="scrollCadastro" 
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Formulário principal -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Coluna 1: Informações básicas -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="📋 INFORMAÇÕES BÁSICAS" Style="{StaticResource SectionHeaderStyle}"/>

                                    <!-- Código único (gerado automaticamente) -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Código Único *" Style="{StaticResource LabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtCodigoUnico" 
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     IsEnabled="False"
                                                     Background="#E9ECEF"
                                                     ToolTip="Código gerado automaticamente"/>
                                            <Button x:Name="btnGerarCodigo" 
                                                    Grid.Column="1"
                                                    Content="🔄 Gerar" 
                                                    Margin="6,0,0,0"
                                                    Width="80"
                                                    Height="38"
                                                    Background="#8B5CF6"
                                                    Style="{StaticResource SmallButtonStyle}"
                                                    Click="BtnGerarCodigo_Click"/>
                                        </Grid>
                                        <TextBlock Text="Código único de identificação do cliente" 
                                                   FontSize="10" 
                                                   Foreground="#6C757D"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Nome -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Nome Completo *" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtNome" 
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 MaxLength="100"/>
                                        <TextBlock x:Name="txtNomeError" 
                                                   Text="O nome é obrigatório" 
                                                   FontSize="10" 
                                                   Foreground="#E74C3C"
                                                   Margin="0,2,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- Telefone -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Telefone" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtTelefone" 
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 MaxLength="15"/>
                                        <TextBlock Text="Formato: (11) 99999-9999" 
                                                   FontSize="10" 
                                                   Foreground="#6C757D"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Email -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="E-mail" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtEmail" 
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 MaxLength="100"/>
                                        <TextBlock x:Name="txtEmailError" 
                                                   Text="E-mail inválido" 
                                                   FontSize="10" 
                                                   Foreground="#E74C3C"
                                                   Margin="0,2,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Espaçador -->
                            <Rectangle Grid.Column="1" Width="20" Fill="Transparent"/>

                            <!-- Coluna 2: Informações adicionais -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="📊 INFORMAÇÕES ADICIONAIS" Style="{StaticResource SectionHeaderStyle}"/>

                                    <!-- Pontos -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Pontos de Fidelidade" Style="{StaticResource LabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtPontos" 
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     Text="0"
                                                     TextAlignment="Right"/>
                                            <StackPanel Grid.Column="1" 
                                                        Orientation="Horizontal" 
                                                        Margin="6,0,0,0">
                                                <Button x:Name="btnAdicionarPontos" 
                                                        Content="+10" 
                                                        Width="40"
                                                        Height="38"
                                                        Background="#27AE60"
                                                        Style="{StaticResource SmallButtonStyle}"
                                                        Click="BtnAdicionarPontos_Click"/>
                                                <Button x:Name="btnRemoverPontos" 
                                                        Content="-10" 
                                                        Width="40"
                                                        Height="38"
                                                        Background="#E74C3C"
                                                        Style="{StaticResource SmallButtonStyle}"
                                                        Margin="4,0,0,0"
                                                        Click="BtnRemoverPontos_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Pontos acumulados do programa de fidelidade" 
                                                   FontSize="10" 
                                                   Foreground="#6C757D"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Última visita -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Última Visita" Style="{StaticResource LabelStyle}"/>
                                        <DatePicker x:Name="dpUltimaVisita" 
                                                    SelectedDateFormat="Short"/>
                                    </StackPanel>

                                    <!-- Status -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Status" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="cmbStatus" 
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="👤 Cliente Ativo" Tag="Ativo" IsSelected="True"/>
                                            <ComboBoxItem Content="⏸️ Cliente Inativo" Tag="Inativo"/>
                                            <ComboBoxItem Content="⭐ Cliente VIP" Tag="VIP"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Estatísticas -->
                                    <Border Background="#F8F9FA" 
                                            Padding="12"
                                            BorderBrush="#E9ECEF" 
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📈 ESTATÍSTICAS" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold"
                                                       Foreground="#495057"
                                                       Margin="0,0,0,8"/>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Total de compras -->
                                                <StackPanel Grid.Row="0" 
                                                            Orientation="Horizontal" 
                                                            Margin="0,0,0,6">
                                                    <TextBlock Text="🛒 Total de Compras:" 
                                                               FontSize="10" 
                                                               Foreground="#6C757D"
                                                               Width="120"/>
                                                    <TextBlock x:Name="txtTotalCompras" 
                                                               Text="0" 
                                                               FontSize="10" 
                                                               FontWeight="SemiBold"
                                                               Foreground="#2C3E50"/>
                                                </StackPanel>

                                                <!-- Valor médio -->
                                                <StackPanel Grid.Row="1" 
                                                            Orientation="Horizontal" 
                                                            Margin="0,0,0,6">
                                                    <TextBlock Text="💰 Valor Médio:" 
                                                               FontSize="10" 
                                                               Foreground="#6C757D"
                                                               Width="120"/>
                                                    <TextBlock x:Name="txtValorMedio" 
                                                               Text="{Binding CurrencyText}" 
                                                               FontSize="10" 
                                                               FontWeight="SemiBold"
                                                               Foreground="#2C3E50"/>
                                                </StackPanel>

                                                <!-- Dias desde última visita -->
                                                <StackPanel Grid.Row="2" 
                                                            Orientation="Horizontal">
                                                    <TextBlock Text="📅 Dias sem visitar:" 
                                                               FontSize="10" 
                                                               Foreground="#6C757D"
                                                               Width="120"/>
                                                    <TextBlock x:Name="txtDiasSemVisitar" 
                                                               Text="0 dias" 
                                                               FontSize="10" 
                                                               FontWeight="SemiBold"
                                                               Foreground="#2C3E50"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Ações -->
                        <Border Background="White" 
                                Padding="20"
                                BorderBrush="#E0E6F0" 
                                BorderThickness="1"
                                Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Indicador de sucesso -->
                                <Border x:Name="successIndicator" 
                                        Grid.Column="0"
                                        Background="#27AE60" 
                                        Padding="12,8"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform/>
                                    </Border.RenderTransform>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✅" 
                                                   FontSize="14" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock x:Name="txtSuccessMessage" 
                                                   Text="Cliente salvo com sucesso!" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Botões de ação -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="btnCancelar" 
                                            Content="Cancelar" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="BtnCancelar_Click"/>
                                    <Button x:Name="btnLimpar" 
                                            Content="Limpar Formulário" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="BtnLimpar_Click"/>
                                    <Button x:Name="btnSalvar" 
                                            Content="💾 Salvar Cliente" 
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="BtnSalvar_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Conteúdo da aba de Lista -->
                <Grid x:Name="pnlListaClientes" 
                      Visibility="Collapsed"
                      Background="White"
                      Margin="0">

                    <!-- Barra de ferramentas da lista -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barra superior com pesquisa e ações -->
                        <Border Grid.Row="0" 
                                Background="#F8F9FA" 
                                Padding="16"
                                BorderBrush="#E9ECEF" 
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Estatísticas rápidas -->
                                <StackPanel Grid.Column="0" 
                                            Orientation="Horizontal" 
                                            VerticalAlignment="Center">
                                    <Border Background="#3498DB" 
                                            Padding="8,4"
                                            Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👥" 
                                                       FontSize="11" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock x:Name="txtContagemClientes" 
                                                       Text="Total: 0" 
                                                       FontSize="11"
                                                       FontWeight="SemiBold" 
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#27AE60" 
                                            Padding="8,4"
                                            Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⭐" 
                                                       FontSize="11" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock x:Name="txtClientesAtivos" 
                                                       Text="Ativos: 0" 
                                                       FontSize="11"
                                                       FontWeight="SemiBold" 
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#8B5CF6" 
                                            Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🏆" 
                                                       FontSize="11" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock x:Name="txtPontosTotais" 
                                                       Text="Pontos: 0" 
                                                       FontSize="11"
                                                       FontWeight="SemiBold" 
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Barra de pesquisa -->
                                <Border Grid.Column="1" 
                                        Background="White" 
                                        Padding="8"
                                        Margin="16,0,16,0"
                                        BorderBrush="#E9ECEF" 
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="🔍" 
                                                   FontSize="14" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <TextBox x:Name="txtPesquisaCliente" 
                                                 Grid.Column="1"
                                                 Height="32"
                                                 FontSize="12"
                                                 Padding="8"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="TxtPesquisaCliente_TextChanged">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Foreground" Value="#95A5A6"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                            <TextBox.Text>Pesquisar por nome, telefone ou código...</TextBox.Text>
                                        </TextBox>

                                        <Button x:Name="btnLimparPesquisa" 
                                                Grid.Column="2"
                                                Content="✕" 
                                                Width="24"
                                                Height="24"
                                                FontSize="10"
                                                Background="Transparent"
                                                Foreground="#6C757D"
                                                BorderThickness="0"
                                                Click="BtnLimparPesquisa_Click"
                                                ToolTip="Limpar pesquisa"/>
                                    </Grid>
                                </Border>

                                <!-- Botões de ação -->
                                <StackPanel Grid.Column="2" 
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="btnExportarClientes" 
                                            Content="📥 Exportar" 
                                            Width="100"
                                            Height="32"
                                            FontSize="11"
                                            Background="#6C757D"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="0,0,8,0"
                                            Click="BtnExportarClientes_Click"/>

                                    <Button x:Name="btnNovoClienteLista" 
                                            Content="➕ Novo Cliente" 
                                            Width="120"
                                            Height="32"
                                            FontSize="11"
                                            Background="#3498DB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="BtnNovoClienteLista_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Lista de clientes -->
                        <DataGrid x:Name="dgClientes" 
                                  Grid.Row="1"
                                  Style="{StaticResource ClientDataGridStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  SelectionChanged="DgClientes_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CÓDIGO" 
                                                    Binding="{Binding CodigoUnico}" 
                                                    Width="100"
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderStyle}"/>
                                <DataGridTextColumn Header="NOME COMPLETO" 
                                                    Binding="{Binding Nome}" 
                                                    Width="*"
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderStyle}"/>
                                <DataGridTextColumn Header="TELEFONE" 
                                                    Binding="{Binding Telefone}" 
                                                    Width="120"
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderStyle}"/>
                                <DataGridTextColumn Header="E-MAIL" 
                                                    Binding="{Binding Email}" 
                                                    Width="180"
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderStyle}"/>
                                <DataGridTextColumn Header="PONTOS" 
                                                    Binding="{Binding Pontos}" 
                                                    Width="80"
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#3498DB"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ÚLTIMA VISITA" 
                                                    Binding="{Binding UltimaVisita, StringFormat=dd/MM/yyyy}" 
                                                    Width="110"
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderStyle}"/>
                                <DataGridTemplateColumn Header="AÇÕES" 
                                                        Width="120"
                                                        HeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" 
                                                        HorizontalAlignment="Center">
                                                <Button Content="👁️" 
                                                        Width="28" 
                                                        Height="28"
                                                        FontSize="11"
                                                        Background="#3498DB"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Click="BtnVisualizarCliente_Click"
                                                        Tag="{Binding Id}"
                                                        ToolTip="Visualizar detalhes"
                                                        Cursor="Hand"/>
                                                <Button Content="✏️" 
                                                        Width="28" 
                                                        Height="28"
                                                        FontSize="11"
                                                        Background="#27AE60"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="4,0,0,0"
                                                        Click="BtnEditarCliente_Click"
                                                        Tag="{Binding Id}"
                                                        ToolTip="Editar cliente"
                                                        Cursor="Hand"/>
                                                <Button Content="🗑️" 
                                                        Width="28" 
                                                        Height="28"
                                                        FontSize="11"
                                                        Background="#E74C3C"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="4,0,0,0"
                                                        Click="BtnExcluirCliente_Click"
                                                        Tag="{Binding Id}"
                                                        ToolTip="Excluir cliente"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>