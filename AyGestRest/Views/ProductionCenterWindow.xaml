<Window x:Class="AyGestRest.Views.ProductionCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AyGest POS · Centro de Operações"
        Width="1320" Height="820"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AyGestBackground}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Centro de Operações" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AyGestText}"/>
                <TextBlock Text="Visão central da operação, caixa, rede e integridade do sistema" FontSize="14" Foreground="{DynamicResource AyGestMuted}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Background="#EAF8EF" CornerRadius="16" Padding="12,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TxtConnection" Text="Ligado" Foreground="#166534" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Button Content="Fechar" Style="{StaticResource AyGestSecondaryButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource AyGestCard}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Vendas hoje" Foreground="{DynamicResource AyGestMuted}"/><TextBlock x:Name="TxtSales" Text="0 MT" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource AyGestCard}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Pedidos pagos" Foreground="{DynamicResource AyGestMuted}"/><TextBlock x:Name="TxtOrders" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource AyGestCard}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Stock crítico" Foreground="{DynamicResource AyGestMuted}"/><TextBlock x:Name="TxtLowStock" Text="0" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AyGestDanger}" Margin="0,7,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource AyGestCard}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Clientes" Foreground="{DynamicResource AyGestMuted}"/><TextBlock x:Name="TxtCustomers" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource AyGestCard}">
                <StackPanel><TextBlock Text="Cancelamentos" Foreground="{DynamicResource AyGestMuted}"/><TextBlock x:Name="TxtCancelled" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource AyGestCard}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Produtos mais vendidos" FontSize="17" FontWeight="SemiBold"/>
                        <Button DockPanel.Dock="Right" Content="Actualizar" Style="{StaticResource AyGestSecondaryButton}" Padding="12,7" Click="Refresh_Click"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="TopProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="Receita" Binding="{Binding Revenue, StringFormat={}{0:N2} MT}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource AyGestCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Terminal" FontSize="17" FontWeight="SemiBold"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Nome" Foreground="{DynamicResource AyGestMuted}"/>
                            <TextBlock Grid.Row="0" x:Name="TxtTerminalName" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="ID" Foreground="{DynamicResource AyGestMuted}" Margin="0,9,0,0"/>
                            <TextBlock Grid.Row="1" x:Name="TxtTerminalId" HorizontalAlignment="Right" Margin="0,9,0,0"/>
                            <TextBlock Grid.Row="2" Text="Modo" Foreground="{DynamicResource AyGestMuted}" Margin="0,9,0,0"/>
                            <TextBlock Grid.Row="2" x:Name="TxtTerminalMode" HorizontalAlignment="Right" Margin="0,9,0,0"/>
                            <TextBlock Grid.Row="3" Text="Moeda" Foreground="{DynamicResource AyGestMuted}" Margin="0,9,0,0"/>
                            <TextBlock Grid.Row="3" x:Name="TxtCurrency" HorizontalAlignment="Right" Margin="0,9,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AyGestCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Operações de produção" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Button Content="Criar backup agora" Style="{StaticResource AyGestPrimaryButton}" Click="Backup_Click" Margin="0,0,0,8"/>
                        <Button Content="Abrir pasta de backups" Style="{StaticResource AyGestSecondaryButton}" Click="OpenBackups_Click" Margin="0,0,0,8"/>
                        <Button Content="Recarregar indicadores" Style="{StaticResource AyGestSecondaryButton}" Click="Refresh_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AyGestCard}">
                    <StackPanel>
                        <TextBlock Text="Integridade" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="SQLite WAL activo · Foreign Keys activas · Busy timeout 15s" Foreground="{DynamicResource AyGestMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock Text="Fila offline preparada para operações store-and-forward." Foreground="{DynamicResource AyGestMuted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="AyGest POS · Ambiente de produção" Foreground="{DynamicResource AyGestMuted}" FontSize="12" Margin="2,16,0,0"/>
    </Grid>
</Window>
