<UserControl x:Class="AyGestRest.Views.CategoriesManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#f0f2f5">
    <UserControl.Resources>
        <!-- DropShadow -->
        <DropShadowEffect x:Key="DropShadow" Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.15"/>

        <!-- Template para botões arredondados -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <!-- Style para botões da toolbar -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="12,6"
                                MinWidth="80">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título principal -->
        <TextBlock Grid.Row="0" Text="Gestão de Categorias de Produtos" 
                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" 
                   Margin="0,0,0,15" Foreground="#333"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL LATERAL - Responsivo -->
            <Border Grid.Column="0" Background="White" Padding="20" Margin="0,0,15,0"
                    CornerRadius="12" Effect="{StaticResource DropShadow}"
                    MinWidth="280">
                <StackPanel>
                    <TextBlock Text="Categoria" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- TextBox Nome com Placeholder -->
                    <Grid Margin="0,0,0,10">
                        <TextBox x:Name="CategoryNameTextBox" Height="40" Padding="10" 
                                 VerticalContentAlignment="Center" Background="Transparent"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Nome da categoria..." Foreground="Gray" Margin="12,0,0,0" 
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CategoryNameTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Botões Adicionar/Atualizar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" 
                                Margin="0,10,0,20" Height="40">
                        <Button x:Name="AddButton" Content="Adicionar" 
                                Background="#4CAF50" FontWeight="Bold" Height="40"
                                Template="{StaticResource RoundedButtonTemplate}"
                                Click="AddCategory_Click" HorizontalAlignment="Stretch"
                                MinWidth="100" Margin="0,0,5,0"/>
                        <Button x:Name="UpdateButton" Content="Atualizar" 
                                Background="#2196F3" FontWeight="Bold" Height="40"
                                Template="{StaticResource RoundedButtonTemplate}"
                                Click="UpdateCategory_Click" IsEnabled="False"
                                HorizontalAlignment="Stretch" MinWidth="100"/>
                    </StackPanel>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="Pesquisa" FontWeight="Bold" Margin="0,15,0,5"/>
                    <!-- TextBox Pesquisa com Placeholder -->
                    <Grid>
                        <TextBox x:Name="SearchTextBox" Height="40" Padding="10" 
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged"/>
                        <TextBlock Text="Pesquisar categorias..." Foreground="Gray" Margin="12,0,0,0" 
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Aviso sobre produtos "órfãos" -->
                    <Border Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1" 
                            CornerRadius="6" Padding="10" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="⚠️ Aviso Importante" FontWeight="Bold" Foreground="#856404" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Apagar categorias não é permitido para evitar que produtos fiquem sem categoria." 
                                       TextWrapping="Wrap" Foreground="#856404" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ÁREA PRINCIPAL - Responsiva -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="10"
                    MinWidth="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar superior -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Left">
                        <Button Content="Novo" Background="#4CAF50" 
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="NewCategory_Click"/>
                        <Button Content="Editar Nome" Background="#FFC107" 
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="EditSelected_Click" ToolTip="Editar nome da categoria selecionada"/>
                        <Button Content="Atualizar" Background="#2196F3" 
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="Refresh_Click"/>
                      
                    </WrapPanel>

                    <!-- DataGrid com scroll horizontal automático -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="CategoriesDataGrid" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" HeadersVisibility="Column" 
                                  RowHeight="40" SelectionMode="Single" IsReadOnly="True"
                                  GridLinesVisibility="None" AlternatingRowBackground="#f9f9f9" 
                                  BorderThickness="0" SelectionChanged="CategoriesDataGrid_SelectionChanged" 
                                  CanUserSortColumns="True" MinWidth="350">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#f0f2f5"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#333"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#e0f7fa"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#bbdefb"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="60"/>
                                <DataGridTextColumn Header="Nome da Categoria" Binding="{Binding Nome}" Width="*" MinWidth="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <!-- Contador de itens -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" 
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="CountTextBlock" Text="0 categorias encontradas" 
                                   Foreground="#666" FontStyle="Italic" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="#666" Margin="5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="❌ Apagar desativado - Proteção de produtos" 
                                   Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>