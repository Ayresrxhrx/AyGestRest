<UserControl x:Class="AyGestRest.Views.TablesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AyGestRest.Models"
             x:Name="TablesRoot"
             MinHeight="600" MinWidth="800"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior com controles -->
        <Border Background="#2D2D2D" Padding="10" Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <CheckBox x:Name="chkModoEdicao" Content="Modo Edição" IsChecked="True" Foreground="White" FontSize="16" Margin="0,0,30,0"/>
                <Button Content="Organizar Automaticamente" Height="40" Padding="15,0" Click="BtnOrganizar_Click" Margin="0,0,20,0"/>
                <TextBlock Text="Dica: Ctrl + Roda = Zoom | Clique direito = Menu | Arrastar = Mover (em modo edição)" 
                           Foreground="#BDC3C7" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Canvas principal -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <Canvas x:Name="TablesCanvas" Background="Transparent"
                    MouseRightButtonUp="TablesCanvas_MouseRightButtonUp"
                    PreviewMouseLeftButtonDown="TablesCanvas_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="TablesCanvas_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="TablesCanvas_PreviewMouseLeftButtonUp"/>
        </ScrollViewer>

        <!-- Legenda fixa -->
        <Border Background="#2D2D2D" Opacity="0.9" CornerRadius="8" Padding="10" 
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Legenda" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                <ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="20" Height="20" Fill="Gray" Margin="0,0,10,0"/>
                        <TextBlock Text="Livre" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="20" Height="20" Fill="Green" Margin="0,0,10,0"/>
                        <TextBlock Text="Ocupada" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="20" Height="20" Fill="Orange" Margin="0,0,10,0"/>
                        <TextBlock Text="Reservada" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="20" Height="20" Fill="Yellow" Margin="0,0,10,0"/>
                        <TextBlock Text="Pendente" Foreground="White"/>
                    </StackPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>