<UserControl x:Class="AyGestRest.Views.POSControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AyGestRest.Views"
             mc:Ignorable="d" 
             Background="#F0F2F5"
             Loaded="POSControl_Loaded"
             x:Name="userControl"
             SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <!-- Cores Principais -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#4338CA"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessDark" Color="#059669"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextLight" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EF4444" Offset="0"/>
            <GradientStop Color="#DC2626" Offset="1"/>
        </LinearGradientBrush>

        <!-- Sombras -->
        <DropShadowEffect x:Key="ShadowLight" BlurRadius="4" Direction="270" ShadowDepth="1" Opacity="0.06"/>
        <DropShadowEffect x:Key="ShadowMedium" BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.1"/>
        <DropShadowEffect x:Key="ShadowHeavy" BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.12"/>

        <!-- Estilo Base para Botões -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Primário -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Botão Secundário -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Botão de Sucesso -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource SuccessGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Botão de Perigo -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource DangerGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Botão Ícone -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Método Pagamento (Simplificado) -->
        <Style x:Key="MetodoPagamentoButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLight}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Moderno -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource ShadowLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- TextBox de Pesquisa -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Text="🔍 Pesquisar produto ou código de barras..."
                                               Foreground="{StaticResource TextLight}"
                                               FontSize="13" Margin="12,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão de Mesa -->
        <Style x:Key="MesaButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de Categoria -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLight}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card de Produto -->
        <Style x:Key="ProductCardStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Width" Value="155"/>
            <Setter Property="Height" Value="165"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource ShadowMedium}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item do Carrinho -->
        <Style x:Key="CartItemStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Effect" Value="{StaticResource ShadowLight}"/>
        </Style>

        <!-- Badge -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                        CornerRadius="12" Padding="0">
                            <Border x:Name="thumb" Width="18" Height="18" 
                            Background="White" CornerRadius="9"
                            HorizontalAlignment="Left" Margin="3,3,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.2"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,3,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Layout Principal -->
    <Grid x:Name="MainGrid">
        <!-- OVERLAY para Popups que BLOQUEIAM -->
        <Grid x:Name="overlayGrid" Panel.ZIndex="1000" Visibility="Collapsed" Background="#80000000">
            <!-- Popup Ativar Mesa -->
            <Border x:Name="popupAtivarMesa"
                    Width="340" Height="300"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Panel.ZIndex="1002" Visibility="Collapsed"
                    Background="White" CornerRadius="12"
                    Effect="{StaticResource ShadowHeavy}">
                <Grid>
                    <Border Background="#8B5CF6" Height="44" CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔓 ATIVAR MESA RESERVADA" FontSize="13" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <Button x:Name="btnFecharAtivar" Grid.Column="1"
                                    Content="✕" Width="28" Height="28"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="White" FontSize="12"
                                    Margin="0,0,12,0" Click="BtnFecharAtivar_Click"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EF4444"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="#FAFAFA" Margin="0,44,0,0" CornerRadius="0,0,12,12">
                        <StackPanel Margin="16">
                            <Border Background="#F3F4F6" Padding="10" Margin="0,0,0,12" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock x:Name="txtReservaCliente" Text="Cliente: Carregando..."
                                               FontSize="12" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <TextBlock x:Name="txtReservaHorario" Text="Horário: --:-- - --:--"
                                               FontSize="11" Foreground="#6B7280" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="txtReservaPessoas" Text="Pessoas: --"
                                               FontSize="11" Foreground="#6B7280"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Digite o código da reserva:" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtCodigoAtivacao" FontSize="20" FontWeight="Bold"
                                     TextAlignment="Center" Height="42" CharacterCasing="Upper" MaxLength="6"
                                     Margin="0,0,0,12">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Padding" Value="8"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button x:Name="btnConfirmarAtivacao" Content="✅ ATIVAR MESA"
                                    Height="42" FontSize="13" FontWeight="Bold"
                                    Background="#8B5CF6" Foreground="White"
                                    Click="BtnConfirmarAtivacao_Click" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}"
                                                            CornerRadius="6" BorderThickness="0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#6D28D9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border x:Name="borderErroAtivacao" Background="#FEE2E2" BorderBrush="#FCA5A5"
                                    BorderThickness="1" Padding="8" Margin="0,8,0,0" Visibility="Collapsed"
                                    CornerRadius="4">
                                <TextBlock x:Name="txtErroAtivacao" Text="" FontSize="11"
                                           Foreground="#DC2626" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Popup Pagamento Múltiplo (Completo) -->
            <Border x:Name="popupPagamentoMultiplo"
                    Width="520" Height="Auto" MaxHeight="650"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Panel.ZIndex="1003" Visibility="Collapsed"
                    Background="White" CornerRadius="12"
                    Effect="{StaticResource ShadowHeavy}">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="popupPagamentoMultiploScale" ScaleX="0.9" ScaleY="0.9"/>
                </Border.RenderTransform>
                <Grid>
                    <!-- Cabeçalho -->
                    <Border Background="{StaticResource PrimaryGradient}" Height="64" CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="💳 PAGAMENTO MÚLTIPLO" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Distribua o valor entre diferentes métodos" FontSize="11"
                                           Foreground="#C7D2FE" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnFecharPagamentoMultiplo" Grid.Column="1"
                                    Content="✕" Width="32" Height="32"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="White" FontSize="14" FontWeight="Bold"
                                    Margin="0,0,16,0" Click="BtnFecharPagamentoMultiplo_Click"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EF4444"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Conteúdo -->
                    <Border Background="#FAFAFA" Margin="0,64,0,0" CornerRadius="0,0,12,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                            <StackPanel Margin="20,16,20,20">
                                <!-- Resumo da Venda -->
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="TOTAL A PAGAR" FontSize="11" 
                                                       Foreground="#64748B" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="txtPopupPagamentoMultiploTotal" 
                                                       FontSize="22" FontWeight="ExtraBold" Foreground="#1E293B"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtRestanteMultiplo" Text="Restante: 0,00 Mtn"
                                                       FontSize="12" Foreground="#EF4444" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="ADICIONAR MÉTODO DE PAGAMENTO" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#475569" Margin="0,0,0,8"/>

                                <!-- Seleção de Método e Valor -->
                                <Border Background="{StaticResource BackgroundLight}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="cmbMetodoPagamento" Grid.Column="0" 
                                                  Height="36" FontSize="12" Width="180">
                                            <ComboBoxItem Content="💰 Dinheiro" Tag="Dinheiro" IsSelected="True"/>
                                            <ComboBoxItem Content="🏦 Multibanco" Tag="Multibanco"/>
                                            <ComboBoxItem Content="📱 MB Way" Tag="MBWay"/>
                                            <ComboBoxItem Content="💳 Cartão Crédito" Tag="CartaoCredito"/>
                                            <ComboBoxItem Content="💳 Cartão Débito" Tag="CartaoDebito"/>
                                            <ComboBoxItem Content="📲 M-Pesa" Tag="MPesa"/>
                                            <ComboBoxItem Content="📲 Emola" Tag="Emola"/>
                                            <ComboBoxItem Content="🏧 Ponto24" Tag="Ponto24"/>
                                            <ComboBoxItem Content="🏦 POS NedBank" Tag="PosNedBank"/>
                                            <ComboBoxItem Content="🏦 POS Moza" Tag="PosMoza"/>
                                            <ComboBoxItem Content="🔄 Outro" Tag="Outro"/>
                                        </ComboBox>

                                        <TextBox x:Name="txtValorMetodo" Grid.Column="1" 
                                                 Width="120" Height="36" FontSize="14" TextAlignment="Right"
                                                 Text="0,00" Margin="8,0,8,0"
                                                 TextChanged="TxtValorMetodo_TextChanged"/>

                                        <Button x:Name="btnAdicionarMetodo" Grid.Column="2" 
                                                Content="➕ ADICIONAR" 
                                                Background="#4F46E5" Foreground="White"
                                                FontWeight="SemiBold" FontSize="11"
                                                Height="36" Padding="12,0"
                                                Click="BtnAdicionarMetodo_Click"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Lista de Métodos Adicionados -->
                                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="0">
                                    <ItemsControl x:Name="itemsMetodosPagamento">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Background}" 
                                                        Padding="10,8" 
                                                        BorderBrush="#E5E7EB" 
                                                        BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Metodo}" 
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#1F2937" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Valor, StringFormat='{}{0:F2} Mtn'}" 
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Foreground="#10B981" VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"/>
                                                        <Button Grid.Column="3" Content="✕" 
                                                                Width="24" Height="24"
                                                                Background="Transparent" Foreground="#EF4444"
                                                                BorderThickness="0" FontSize="12"
                                                                Cursor="Hand"
                                                                Click="BtnRemoverMetodoPagamento_Click"
                                                                Tag="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Resumo dos Pagamentos -->
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total Distribuído:" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtTotalDistribuido" Grid.Column="1" 
                                                   Text="0,00 Mtn" FontSize="14" FontWeight="Bold"
                                                   Foreground="#10B981" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Botões Ação -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button x:Name="btnFinalizarPagamentoMultiplo" 
                                            Content="✅ FINALIZAR PAGAMENTO" 
                                            Background="#10B981" Foreground="White"
                                            FontWeight="Bold" FontSize="13"
                                            Height="40" Padding="24,0"
                                            Click="BtnFinalizarPagamentoMultiplo_Click"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}"/>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="btnCancelarPagamentoMultiplo" 
                                            Content="❌ CANCELAR" 
                                            Background="#EF4444" Foreground="White"
                                            FontWeight="SemiBold" FontSize="12"
                                            Height="40" Padding="16,0" Margin="8,0,0,0"
                                            Click="BtnCancelarPagamentoMultiplo_Click"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}"/>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Popup Pagamento Simplificado com Toggle -->
            <Border x:Name="popupPagamentoSimplificado"
        Width="480" Height="Auto"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        Panel.ZIndex="1004" Visibility="Collapsed"
        Background="White" CornerRadius="12"
        Effect="{StaticResource ShadowHeavy}">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="popupPagamentoSimplificadoScale" ScaleX="0.9" ScaleY="0.9"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Height="56" CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="💳" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="PAGAMENTO" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="txtPagamentoSimplificadoSubtitulo" 
                                   Text="Selecione o método de pagamento" 
                                   FontSize="10" Foreground="#C7D2FE"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="btnFecharPagamentoSimplificado" Grid.Column="1"
                        Content="✕" Width="32" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="White" FontSize="14" FontWeight="Bold"
                        Margin="0,0,12,0" Click="BtnFecharPagamentoSimplificado_Click"
                        Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EF4444"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Conteúdo -->
                    <Border Grid.Row="1" Background="#FAFAFA" CornerRadius="0,0,12,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="550">
                            <StackPanel Margin="16,16,16,20">
                                <!-- Total -->
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="TOTAL A PAGAR" FontSize="11" 
                                           Foreground="#64748B" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="txtPagamentoSimplificadoTotal" 
                                           FontSize="22" FontWeight="ExtraBold" Foreground="#1E293B"
                                           Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="txtModoPagamentoLabel" Text="Pagamento Único" 
                                           FontSize="10" FontWeight="SemiBold" Foreground="#166534"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- TOGGLE: Pagamento Simples / Múltiplo -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                            BorderBrush="#E5E7EB" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="🔄 Pagamento Múltiplo" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Text="Ative para dividir entre vários métodos" FontSize="9" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="tglPagamentoMultiplo" Grid.Column="1" 
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="TglPagamentoMultiplo_Checked"
                                          Unchecked="TglPagamentoMultiplo_Unchecked"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" x:Name="txtToggleStatus" Text="OFF" 
                                       FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Container de Métodos -->
                                <Border Background="White" CornerRadius="8" 
                            BorderBrush="#E5E7EB" BorderThickness="1">
                                    <StackPanel>
                                        <!-- MODO SIMPLES (Padrão) - Botões de métodos -->
                                        <StackPanel x:Name="panelMetodosSimples">
                                            <TextBlock Text="Escolha o método de pagamento:" FontSize="11" 
                                           Foreground="#64748B" Margin="12,10,0,6"/>
                                            <WrapPanel x:Name="pnlBotoesMetodosSimplificado" Margin="6,0,6,6"/>
                                        </StackPanel>

                                        <!-- MODO MÚLTIPLO - Botões de métodos + valores -->
                                        <StackPanel x:Name="panelMetodosMultiplos" Visibility="Collapsed">
                                            <TextBlock Text="Selecione os métodos e valores:" FontSize="11" 
                                           Foreground="#64748B" Margin="12,10,0,6"/>

                                            <!-- Grid de botões de métodos com campo de valor -->
                                            <WrapPanel x:Name="pnlBotoesMetodosMultiplos" Margin="6,0,6,6"/>

                                            <!-- Lista de métodos adicionados -->
                                            <Border Background="#F8FAFC" CornerRadius="6" Margin="6,6,6,6" Padding="0">
                                                <ItemsControl x:Name="itemsMetodosPagamentoMulti">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding Background}" Padding="8,6" 
                                                        BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Metodo}" 
                                                                   FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Valor, StringFormat='{}{0:F2} Mtn'}" 
                                                                   FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0"/>
                                                                    <Button Grid.Column="3" Content="✕" Width="22" Height="22"
                                                                Background="Transparent" Foreground="#EF4444"
                                                                BorderThickness="0" FontSize="10" Cursor="Hand"
                                                                Click="BtnRemoverMetodoMulti_Click" Tag="{Binding}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                            <!-- Resumo -->
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="10" Margin="6,0,6,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Total Distribuído:" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                                    <TextBlock x:Name="txtTotalDistribuidoMulti" Grid.Column="1" 
                                                   Text="0,00 Mtn" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                                                </Grid>
                                            </Border>

                                            <!-- Botão para finalizar no modo múltiplo -->
                                            <Button x:Name="btnFinalizarMultiplo" 
                                        Content="✅ FINALIZAR PAGAMENTO MÚLTIPLO" 
                                        Background="#10B981" Foreground="White"
                                        FontWeight="Bold" FontSize="12"
                                        Height="40" Margin="6,6,6,6"
                                        Click="BtnFinalizarMultiplo_Click"
                                        Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}"/>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- POPUP RECIBO - FLUTUANTE (NÃO BLOQUEIA A TELA) -->
        <Border x:Name="popupRecibo"
                Width="280"
                Height="400"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10,0,0,80"
                Panel.ZIndex="999"
                Background="White"
                CornerRadius="12"
                Effect="{StaticResource ShadowHeavy}"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="popupTransform"/>
            </Border.RenderTransform>
            <Grid>
                <!-- Cabeçalho arrastável -->
                <Border Background="#1E293B" Height="36" CornerRadius="12,12,0,0"
                        MouseLeftButtonDown="PopupRecibo_MouseLeftButtonDown"
                        MouseLeftButtonUp="PopupRecibo_MouseLeftButtonUp"
                        MouseMove="PopupRecibo_MouseMove"
                        Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📄 RECIBO" FontSize="11" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button x:Name="btnFecharRecibo" Grid.Column="1"
                                Content="✕" Width="24" Height="24"
                                Background="Transparent" BorderThickness="0"
                                Foreground="White" FontSize="11"
                                Margin="0,0,8,0" Click="BtnFecharRecibo_Click"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Conteúdo -->
                <Border Background="#FAFAFA" Margin="0,36,0,0" CornerRadius="0,0,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="2">
                            <StackPanel x:Name="stackRecibo" Background="White" Margin="0">
                                <!-- Cabeçalho -->
                                <Border Background="White" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RestaurantName, ElementName=userControl}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#1E293B"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                        <TextBlock Text="RECIBO DA VENDA" FontSize="9"
                                                   Foreground="{StaticResource TextSecondary}" TextAlignment="Center" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="txtReciboMesa" Text="Mesa: NENHUMA"
                                                   FontSize="9" Foreground="{StaticResource PrimaryColor}"
                                                   TextAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="txtReciboData" Text="Data: --/--/-- --:--"
                                                   FontSize="8" Foreground="{StaticResource TextLight}"
                                                   TextAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Itens -->
                                <Border Background="#F8FAFC" Padding="6,4" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                    <ItemsControl x:Name="itemsRecibo">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Quantity}" FontSize="9"
                                                               FontWeight="SemiBold" Foreground="#374151" Width="18"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}"
                                                               FontSize="9" Foreground="#374151" Margin="6,0,6,0"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SubTotal, StringFormat='{}{0:F2} Mtn'}"
                                                               FontSize="9" FontWeight="SemiBold" Foreground="#10B981"
                                                               MinWidth="45" TextAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Totais -->
                                <Border Background="White" Padding="8,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Subtotal" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="txtReciboSubtotal" Grid.Column="1"
                                                       Text="0,00 Mtn" FontSize="9" FontWeight="SemiBold" Foreground="#374151"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,2" x:Name="gridReciboDesconto" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Desconto" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="txtReciboDesconto" Grid.Column="1"
                                                       Text="0,00 Mtn" FontSize="9" FontWeight="SemiBold" Foreground="#EF4444"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock x:Name="txtReciboTotal" Grid.Column="1"
                                                       Text="0,00 Mtn" FontSize="11" FontWeight="ExtraBold" Foreground="#10B981"/>
                                        </Grid>
                                        <Border Background="#ECFDF5" Padding="6,4" Margin="0,8,0,0" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock x:Name="txtReciboStatus" Text="Aguardando pagamento"
                                                           FontSize="8" FontWeight="SemiBold" Foreground="#059669"
                                                           TextAlignment="Center"/>
                                                <TextBlock x:Name="txtReciboPagamento" Text="Forma de pagamento: ---"
                                                           FontSize="7" Foreground="#6B7280" TextAlignment="Center" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Rodapé -->
                        <Border Grid.Row="1" Background="#F1F5F9" Padding="6,4" 
                                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ItemCount, ElementName=userControl}" FontSize="8" Foreground="#475569"/>
                                <TextBlock Grid.Column="1" x:Name="txtReciboOperador"
                                           Text="{Binding OperatorName, ElementName=userControl}" FontSize="7" Foreground="#6B7280"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#1E293B" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Esquerda: Mesa e Ações -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#334155" Padding="8,5" CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MESA:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtMesaAtual" Text="NENHUMA" FontSize="16" FontWeight="ExtraBold" Foreground="#FCD34D"/>
                                <TextBlock x:Name="txtTempoMesa" FontSize="10" Foreground="#93C5FD" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="btnTrocarMesa" Content="🔄 TROCAR" Margin="0,0,4,0"
                                    Background="#3B82F6" Style="{StaticResource PrimaryButton}"
                                    Height="32" FontSize="10" Click="BtnNovaComanda_Click"
                                    ToolTip="Trocar mesa"/>
                            <Button x:Name="btnNovaComanda" Content="📋 NOVA" Margin="0,0,4,0"
                                    Background="#10B981" Style="{StaticResource SuccessButton}"
                                    Height="32" FontSize="10" Click="BtnNovaComanda_Click"
                                    ToolTip="Nova comanda"/>
                            <Button x:Name="btnCancelarVenda" Content="❌ CANC" Margin="0,0,4,0"
                                    Background="#EF4444" Style="{StaticResource BaseButton}"
                                    Height="32" FontSize="10" Click="BtnCancelarVenda_Click"
                                    ToolTip="Cancelar venda"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Centro: Total -->
                    <Border Grid.Column="1" Background="#334155" Padding="12,6" CornerRadius="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="TOTAL A PAGAR" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtTotalHeader" Text="0,00 Mtn" FontSize="22"
                                       FontWeight="ExtraBold" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Direita: Info -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#334155" Padding="6" Margin="0,0,4,0" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="OPERADOR" FontSize="7" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtUsuario" Text="NÃO IDENTIFICADO" FontSize="9"
                                           FontWeight="Bold" Foreground="#ECF0F1" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#334155" Padding="6" Margin="0,0,4,0" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="HORA" FontSize="7" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtDataHora" FontSize="9" FontWeight="Bold"
                                           Foreground="#ECF0F1" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#334155" Padding="6" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="ÚLTIMO TALÃO" FontSize="7" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtUltimoTalao" FontSize="11" FontWeight="ExtraBold"
                                           Foreground="#34D399" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MENSAGEM STATUS -->
            <Border x:Name="borderMensagemStatus" Background="#FEF3C7" BorderBrush="#FCD34D"
                    BorderThickness="1" Grid.Row="0" Margin="8,0,8,8"
                    VerticalAlignment="Bottom" Height="28" Visibility="Collapsed"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ " FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtMensagemStatus" Text="" FontSize="11"
                               FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CORPO PRINCIPAL -->
            <Grid Grid.Row="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColMesas" Width="200" MinWidth="150" MaxWidth="240"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition x:Name="ColCarrinho" Width="280" MinWidth="220" MaxWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- COLUNA 1: MESAS -->
                <Border Background="White" Padding="8" CornerRadius="10"
                        BorderBrush="#E5E7EB" BorderThickness="1"
                        Effect="{StaticResource ShadowLight}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Título e Pesquisa -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="📋 MESAS" FontSize="13" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,4"/>

                            <Border Background="#F9FAFB" Padding="4" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtPesquisaTalao" Grid.Column="0"
                                             Height="28" FontSize="11" Padding="4"
                                             Background="Transparent" Foreground="#6B7280"
                                             BorderThickness="0" VerticalContentAlignment="Center"
                                             KeyDown="TxtPesquisaTalao_KeyDown">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="Foreground" Value="#1F2937"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="🔍 Buscar talão..."
                                                                                   Foreground="#9CA3AF" FontSize="10"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button x:Name="btnBuscarTalao" Grid.Column="1" Content="🔍"
                                            Width="28" Height="28" Margin="4,0,0,0" FontSize="11"
                                            Background="#4F46E5" Style="{StaticResource PrimaryButton}"
                                            Click="BtnBuscarTalao_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Lista de Mesas -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="pnlMesas" Orientation="Horizontal"/>
                        </ScrollViewer>

                        <!-- Cliente -->
                        <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="6" Padding="6,4" 
                                BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="👤 CLIENTE:" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#374151" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="cmbClientes" Grid.Column="1" Height="26" FontSize="10"
                                          SelectedValuePath="Id" DisplayMemberPath="Nome"
                                          SelectionChanged="CmbClientes_SelectionChanged"
                                          BorderBrush="#D1D5DB" BorderThickness="1" />
                                <Button x:Name="btnClienteAleatorio" Grid.Column="2" Content="🎲"
                                        Width="26" Height="26" Margin="4,0,0,0" FontSize="11"
                                        Background="#8B5CF6" Style="{StaticResource PrimaryButton}"
                                        Click="BtnClienteAleatorio_Click"
                                        ToolTip="Cliente aleatório (F8)"/>
                            </Grid>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <Border Background="#F9FAFB" Padding="6" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="🏪 COMANDAS ATIVAS" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#374151" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="txtContadorComandas" Text="0 comandas abertas"
                                               FontSize="9" Foreground="#6B7280"/>
                                    <TextBlock x:Name="txtInfoMesa" Text="Selecione uma mesa para começar"
                                               FontSize="8" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- COLUNA 3: PRODUTOS -->
                <Border Grid.Column="2" Background="White" CornerRadius="10"
                        BorderBrush="#E5E7EB" BorderThickness="1"
                        Effect="{StaticResource ShadowLight}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Pesquisa -->
                        <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="10,10,0,0"
                                Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtPesquisa" Grid.Column="0" Grid.ColumnSpan="2"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         TextChanged="TxtPesquisa_TextChanged"
                                         KeyDown="TxtPesquisa_KeyDown"/>
                                <Button x:Name="btnLimparPesquisa" Grid.Column="2" Content="✕"
                                        Width="36" Height="36" Margin="6,0,0,0"
                                        Background="Transparent" Foreground="#6B7280"
                                        FontSize="12" Click="BtnLimparPesquisa_Click"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Categorias -->
                        <Border Grid.Row="1" Background="#F0FDF4" Padding="6,4"
                                BorderBrush="#D1FAE5" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📂" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Auto" Margin="0,0,6,0">
                                    <StackPanel x:Name="pnlCategorias" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ScrollViewer>
                                <TextBlock Grid.Column="2" x:Name="txtContadorItens" Text="(0 itens)"
                                           FontSize="10" Foreground="#059669" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Produtos -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="4">
                            <WrapPanel x:Name="pnlProdutos" Orientation="Horizontal" Margin="0"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- COLUNA 5: CARRINHO E PAGAMENTO -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CARRINHO -->
                    <Border Background="White" CornerRadius="10"
                            BorderBrush="#E5E7EB" BorderThickness="1"
                            Effect="{StaticResource ShadowLight}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho -->
                            <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="10,10,0,0"
                                    Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛒 CARRINHO" FontSize="13" FontWeight="Bold"
                                               Foreground="#1F2937" Margin="0,0,8,0"/>
                                    <Button x:Name="btnLimparCarrinho" Content="🗑️ LIMPAR"
                                            Background="#EF4444" Style="{StaticResource BaseButton}"
                                            Height="26" FontSize="9" Padding="8,0"
                                            Click="BtnLimparCarrinho_Click"/>
                                    <Button x:Name="btnImprimirCozinha" Content="🍳 COZINHA"
                                            Background="#F59E0B" Style="{StaticResource BaseButton}"
                                            Height="26" FontSize="9" Padding="8,0"
                                            Click="BtnImprimirCozinha_Click"
                                            ToolTip="Imprimir apenas o pedido da cozinha"
                                            Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Itens -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <ItemsControl x:Name="itemsCarrinho" Margin="6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CartItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Quantity, StringFormat='{}{0}x'}" FontSize="13"
                                                               FontWeight="Bold" Foreground="#4F46E5" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="11"
                                                               FontWeight="SemiBold" Foreground="#1F2937" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding SubTotal, StringFormat='{}{0:F2} Mtn'}"
                                                               FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Resumo -->
                            <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="0,0,10,10"
                                    Padding="8" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Subtotal" FontSize="11" Foreground="#6B7280"/>
                                            <TextBlock x:Name="txtSubtotalCarrinho" Grid.Column="1"
                                                       Text="0,00 Mtn" FontSize="12" FontWeight="Bold" Foreground="#1F2937"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total Itens" FontSize="11" Foreground="#6B7280"/>
                                            <TextBlock x:Name="txtTotalItensCarrinho" Grid.Column="1"
                                                       Text="0" FontSize="12" FontWeight="Bold" Foreground="#4F46E5"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- PAGAMENTO -->
                    <Border Grid.Row="2" Background="#EEF2FF" CornerRadius="10"
                            BorderBrush="#C7D2FE" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Desconto -->
                            <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="6" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎯 DESCONTO" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#1F2937" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBox x:Name="txtDesconto" Width="60" Height="30"
                                                 FontSize="12" Text="0" TextAlignment="Right"
                                                 Padding="4" TextChanged="TxtDesconto_TextChanged"
                                                 BorderBrush="#D1D5DB" BorderThickness="1" />
                                        <ComboBox x:Name="cmbDescontoTipo" Width="40" Height="30"
                                                  FontSize="10" SelectedIndex="0" Margin="4,0,0,0"
                                                  BorderBrush="#D1D5DB" BorderThickness="1" >
                                            <ComboBoxItem Content="%"/>
                                            <ComboBoxItem Content="Valor"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Valor Recebido -->
                            <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="6" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="💰 RECEBIDO" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#1F2937" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtValorRecebido" Grid.Column="1" Height="30"
                                             FontSize="13" TextAlignment="Right" Padding="4"
                                             TextChanged="TxtValorRecebido_TextChanged"
                                             GotFocus="TxtValorRecebido_GotFocus"
                                             BorderBrush="#D1D5DB" BorderThickness="1" />
                                </Grid>
                            </Border>

                            <!-- Valores Rápidos -->
                            <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="6" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="💰 VALORES RÁPIDOS" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#1F2937" Margin="0,0,0,4"/>
                                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,2">
                                        <Button Content="VALOR EXATO" Background="#4F46E5"
                                                Style="{StaticResource PrimaryButton}" Click="BtnValorExato_Click"/>
                                        <Button Content="+50" Background="#10B981"
                                                Style="{StaticResource SuccessButton}" Click="BtnMais50_Click"/>
                                        <Button Content="+100" Background="#10B981"
                                                Style="{StaticResource SuccessButton}" Click="BtnMais100_Click"/>
                                        <Button Content="+500" Background="#10B981"
                                                Style="{StaticResource SuccessButton}" Click="BtnMais500_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Total Final -->
                            <Border Grid.Row="3" Background="#1E293B" CornerRadius="6" Padding="8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TOTAL FINAL" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txtTotalFinal" Text="0,00 Mtn"
                                                   FontSize="18" FontWeight="ExtraBold" Foreground="White" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="txtTroco" Text="Troco: 0,00 Mtn"
                                                   FontSize="10" FontWeight="Bold" Foreground="#93C5FD" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Finalizar -->
                            <Button Grid.Row="4" x:Name="btnFinalizarVenda" Content="✅ FINALIZAR VENDA"
                                    Height="40" FontSize="13" Background="#10B981"
                                    Style="{StaticResource SuccessButton}" FontWeight="Bold" Padding="12,8"
                                    Click="BtnFinalizarVenda_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- RODAPÉ -->
            <Border Grid.Row="2" Background="#1E293B" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#334155" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                <TextBlock Text="F1" Foreground="#60A5FA" FontWeight="Bold" FontSize="8" Margin="0,0,2,0"/>
                            </Border>
                            <TextBlock Text="Nova" Foreground="#94A3B8" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <Border Background="#334155" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                <TextBlock Text="F2" Foreground="#60A5FA" FontWeight="Bold" FontSize="8" Margin="0,0,2,0"/>
                            </Border>
                            <TextBlock Text="Finalizar" Foreground="#94A3B8" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <Border Background="#334155" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                <TextBlock Text="F3" Foreground="#60A5FA" FontWeight="Bold" FontSize="8" Margin="0,0,2,0"/>
                            </Border>
                            <TextBlock Text="Buscar" Foreground="#94A3B8" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <Border Background="#334155" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                <TextBlock Text="F4" Foreground="#60A5FA" FontWeight="Bold" FontSize="8" Margin="0,0,2,0"/>
                            </Border>
                            <TextBlock Text="Limpar" Foreground="#94A3B8" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <Border Background="#334155" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                <TextBlock Text="F5" Foreground="#60A5FA" FontWeight="Bold" FontSize="8" Margin="0,0,2,0"/>
                            </Border>
                            <TextBlock Text="Imprimir" Foreground="#94A3B8" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <Border Background="#334155" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                <TextBlock Text="F8" Foreground="#60A5FA" FontWeight="Bold" FontSize="8" Margin="0,0,2,0"/>
                            </Border>
                            <TextBlock Text="Cliente" Foreground="#94A3B8" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <Border Background="#334155" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                <TextBlock Text="ESC" Foreground="#60A5FA" FontWeight="Bold" FontSize="8" Margin="0,0,2,0"/>
                            </Border>
                            <TextBlock Text="Cancelar" Foreground="#94A3B8" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnPrevisualizarRodape" Content="👁️ PRÉ-VISUALIZAR"
                                Background="#3B82F6" Style="{StaticResource PrimaryButton}"
                                Height="26" FontSize="9" Click="BtnPrevisualizarRecibo_Click"
                                Margin="0,0,4,0"/>
                        <Button x:Name="btnImprimirRodape" Content="🖨️ IMPRIMIR"
                                Background="#10B981" Style="{StaticResource SuccessButton}"
                                Height="26" FontSize="9" Click="BtnImprimirRecibo_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>