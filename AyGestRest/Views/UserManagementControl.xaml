<UserControl x:Class="AyGestRest.Views.UsersManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F5F7FA">
    <UserControl.Resources>
        <!-- Estilo para botões principais -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#21618C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botões secundários -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F9FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para botões de ícone -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo moderno para TextBox - SIMPLES E FUNCIONAL -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D9E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#3498DB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SelectionBrush" Value="#3498DB33"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">

                            <!-- AQUI ESTÁ O SEGREDO: Use Grid ao invés de ScrollViewer diretamente -->
                            <Grid>
                                <!-- O ScrollViewer DEVE ter nome PART_ContentHost -->
                                <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="0"
                                      Padding="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"/>
                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3498DB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0B4C6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo moderno para PasswordBox - SIMPLES E FUNCIONAL -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D9E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">

                            <Grid>
                                <!-- O ScrollViewer DEVE ter nome PART_ContentHost -->
                                <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="0"
                                      Padding="0"/>
                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3498DB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0B4C6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo SIMPLES para o TextBox de pesquisa -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ScrollViewer com nome correto -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Hidden"
                                  Margin="0"/>

                            <!-- Placeholder -->
                            <TextBlock x:Name="placeholderText"
                               Grid.Column="0"
                               Text="Pesquisar por nome ou utilizador..."
                               Foreground="#95A5A6"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="0"
                               IsHitTestVisible="False"
                               FontSize="14"
                               FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D9E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton" 
                                                Grid.Column="2" 
                                                Focusable="false"
                                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent" 
                                                        Width="20" 
                                                        Height="20">
                                                    <Path x:Name="Arrow" 
                                                          Fill="#666666" 
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   PopupAnimation="Slide"
                                   VerticalOffset="1">
                                <Border x:Name="DropDownBorder"
                                        BorderThickness="1"
                                        BorderBrush="#D1D9E0"
                                        Background="White"
                                        CornerRadius="4">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="checkBoxBorder"
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    BorderThickness="1"
                                    BorderBrush="#D1D9E0"
                                    Background="White"
                                    CornerRadius="3">
                                <Path x:Name="checkMark"
                                      Data="M 3 8 L 6 11 L 12 5"
                                      Stroke="#3498DB"
                                      StrokeThickness="2"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Border>

                            <ContentPresenter x:Name="contentPresenter"
                                              Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3498DB"/>
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Margin="0,0,0,15"
                BorderBrush="#E1E5E9" BorderThickness="1">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="👥 Gestão de Utilizadores" 
                               FontSize="24" FontWeight="SemiBold" 
                               Foreground="#2C3E50"/>
                    <TextBlock Text="Gerencie os utilizadores do sistema, permissões e acessos" 
                               FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="NOVO UTILIZADOR" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="160" 
                            Margin="0,0,15,0"
                            ToolTip="Criar novo utilizador"
                            Click="BtnMostrarPopup_Click"/>

                    <Border Background="White" CornerRadius="4" 
                            BorderBrush="#E1E5E9" BorderThickness="1"
                            Padding="10" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" 
                                       FontSize="16"
                                       Foreground="#95A5A6"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBox x:Name="txtPesquisa" 
                                   Width="250" 
                                   Height="30" 
                                   BorderThickness="0" 
                                   FontSize="14" 
                                   VerticalAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   TextChanged="TxtPesquisa_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#2C3E50"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="Transparent">
                                                        <Grid>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                        VerticalAlignment="Stretch"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalScrollBarVisibility="Auto"
                                                                        HorizontalScrollBarVisibility="Hidden"/>
                                                            <TextBlock Text="Pesquisar por nome ou utilizador..." 
                                                                       Foreground="#999999"
                                                                       VerticalAlignment="Center"
                                                                       IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cartões de resumo -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,15">
            <Border Background="White" CornerRadius="8" Margin="0,0,15,0"
                    BorderBrush="#E1E5E9" BorderThickness="1"
                    Width="200" Height="90">
                <StackPanel Margin="20">
                    <TextBlock Text="TOTAL" FontSize="12" Foreground="#7F8C8D" FontWeight="Medium"/>
                    <TextBlock x:Name="txtTotal" Text="0" FontSize="28" FontWeight="Bold" 
                               Foreground="#2C3E50" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Margin="0,0,15,0"
                    BorderBrush="#E1E5E9" BorderThickness="1"
                    Width="200" Height="90">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#2ECC71" Margin="0,0,5,0" 
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="ATIVOS" FontSize="12" Foreground="#7F8C8D" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock x:Name="txtAtivos" Text="0" FontSize="28" FontWeight="Bold" 
                               Foreground="#2ECC71" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E1E5E9" BorderThickness="1"
                    Width="200" Height="90">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#E74C3C" Margin="0,0,5,0" 
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="INATIVOS" FontSize="12" Foreground="#7F8C8D" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock x:Name="txtInativos" Text="0" FontSize="28" FontWeight="Bold" 
                               Foreground="#E74C3C" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Loading -->
        <Border Grid.Row="2" x:Name="panelLoading" 
                Background="#F5F7FA" CornerRadius="8"
                Visibility="Collapsed" 
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="300" Height="6" 
                             Margin="0,0,0,15">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#3498DB" Offset="0"/>
                            <GradientStop Color="#2980B9" Offset="0.5"/>
                            <GradientStop Color="#3498DB" Offset="1"/>
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>
                <TextBlock Text="A carregar utilizadores..." 
                           FontSize="14" Foreground="#7F8C8D"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" 
                BorderBrush="#E1E5E9" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header da tabela -->
                <Border Grid.Row="0" Background="#F8F9FA" 
                        CornerRadius="8,8,0,0" 
                        BorderThickness="0,0,0,1" 
                        BorderBrush="#E1E5E9">
                    <TextBlock Text="LISTA DE UTILIZADORES" 
                               FontSize="13" FontWeight="SemiBold" 
                               Foreground="#2C3E50"
                               Margin="15,12"/>
                </Border>

                <!-- Tabela -->
                <DataGrid x:Name="dgUtilizadores"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          IsReadOnly="False"
                          RowHeight="48"
                          FontSize="13"
                          Background="White"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          EnableRowVirtualization="True"
                          ItemsSource="{Binding}"
                          HeadersVisibility="Column"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CellStyle="{StaticResource {x:Type DataGridCell}}">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E1E5E9"/>
                            <Setter Property="Padding" Value="12,12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#2C3E50"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EBF5FB"/>
                                    <Setter Property="BorderBrush" Value="#3498DB"/>
                                    <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" 
                                          Width="70" IsReadOnly="True"/>

                        <DataGridTextColumn Header="UTILIZADOR" Binding="{Binding Username}" 
                                          Width="180"/>

                        <DataGridTextColumn Header="NOME COMPLETO" Binding="{Binding FullName}" 
                                          Width="*"/>

                        <!-- Coluna PERFIL CORRIGIDA - sem converters -->
                        <DataGridTemplateColumn Header="PERFIL" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="roleBorder" 
                                            CornerRadius="4" Padding="6,2" 
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoleDisplay}" 
                                                   Foreground="White" 
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="Administrador">
                                            <Setter TargetName="roleBorder" Property="Background" Value="#E74C3C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="Funcionario">
                                            <Setter TargetName="roleBorder" Property="Background" Value="#2ECC71"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="Gerente">
                                            <Setter TargetName="roleBorder" Property="Background" Value="#3498DB"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="Caixa">
                                            <Setter TargetName="roleBorder" Property="Background" Value="#9B59B6"/>
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="roleBorder" Property="Background" Value="#95A5A6"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding FontePerfis}"
                                            SelectedItem="{Binding Role}"
                                            Width="140" Margin="2,0"
                                            Style="{StaticResource ModernComboBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Coluna STATUS CORRIGIDA - sem converters -->
                        <DataGridTemplateColumn Header="STATUS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Ellipse x:Name="statusDot" Width="8" Height="8" 
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                        <TextBlock x:Name="statusText"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="statusDot" Property="Fill" Value="#2ECC71"/>
                                            <Setter TargetName="statusText" Property="Text" Value="Ativo"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter TargetName="statusDot" Property="Fill" Value="#E74C3C"/>
                                            <Setter TargetName="statusText" Property="Text" Value="Inativo"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ÚLTIMO LOGIN" 
                                          Binding="{Binding UltimoLoginFormatado}" 
                                          Width="160" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="AÇÕES" Width="140" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Editar utilizador"
                                                Tag="{Binding}" 
                                                Click="BtnEditar_Click">
                                            <TextBlock Text="✏️" FontSize="14"/>
                                        </Button>

                                        <Button Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Alterar senha"
                                                Tag="{Binding}"
                                                Click="BtnAlterarSenha_Click">
                                            <TextBlock Text="🔑" FontSize="14"/>
                                        </Button>

                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Background="Transparent"
                                                Foreground="#E74C3C"
                                                ToolTip="Apagar utilizador"
                                                Tag="{Binding}"
                                                Click="BtnApagar_Click">
                                            <TextBlock Text="🗑️" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Mensagem quando vazio -->
        <Border Grid.Row="2" x:Name="panelVazio" 
                Background="White" CornerRadius="8"
                Visibility="Collapsed" 
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="👥" FontSize="48" Margin="0,0,0,20"/>
                <TextBlock Text="Nenhum utilizador encontrado" 
                           FontSize="18" FontWeight="SemiBold" 
                           Foreground="#7F8C8D" Margin="0,0,0,10"/>
                <TextBlock Text="Clique em 'NOVO UTILIZADOR' para adicionar o primeiro" 
                           FontSize="14" Foreground="#95A5A6" 
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Overlay -->
        <Border x:Name="overlay" Grid.RowSpan="4" 
                Background="#80000000" 
                Visibility="Collapsed"/>

        <!-- Popup de cadastro/edição -->
        <Border x:Name="popupCadastro" 
                Background="White" 
                CornerRadius="12"
                Width="480" 
                Visibility="Collapsed"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Panel.ZIndex="1000" 
                Grid.RowSpan="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="3" 
                                Color="Black" Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header do popup -->
                <Border Grid.Row="0" Background="#3498DB" 
                        CornerRadius="12,12,0,0" 
                        Padding="25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="txtTituloPopup" 
                                       Text="Cadastrar Novo Utilizador" 
                                       FontSize="18" FontWeight="SemiBold" 
                                       Foreground="White"/>
                            <TextBlock Text="Preencha os dados do utilizador" 
                                       FontSize="13" Foreground="#EBF5FB" 
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{StaticResource IconButtonStyle}"
                                Background="Transparent"
                                Foreground="White"
                                Click="BtnFecharPopup_Click">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Conteúdo do formulário -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="25">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Nome de Utilizador*" 
                                       FontWeight="SemiBold" 
                                       Foreground="#2C3E50" 
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtPopupUsername" 
                                   Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Nome Completo*" 
                                       FontWeight="SemiBold" 
                                       Foreground="#2C3E50" 
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtPopupFullName" 
                                   Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock x:Name="lblSenha" 
                                       Text="Senha*" 
                                       FontWeight="SemiBold" 
                                       Foreground="#2C3E50" 
                                       Margin="0,0,0,5"/>
                            <PasswordBox x:Name="txtPopupSenha" 
                                       Style="{StaticResource ModernPasswordBox}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Perfil / Permissão*" 
                                       FontWeight="SemiBold" 
                                       Foreground="#2C3E50" 
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbPopupRole" 
                                    Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <Border Background="#F8F9FA" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Status do Utilizador" 
                                           FontWeight="SemiBold" 
                                           Foreground="#2C3E50" 
                                           Margin="0,0,0,10"/>
                                <CheckBox x:Name="chkPopupIsActive" 
                                        Content="Utilizador ativo no sistema"
                                        FontSize="14"
                                        IsChecked="True"
                                        Style="{StaticResource ModernCheckBox}"/>
                                <TextBlock Text="Utilizadores inativos não conseguem fazer login" 
                                           FontSize="12" Foreground="#95A5A6" 
                                           Margin="25,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Rodapé do popup -->
                <Border Grid.Row="2" Background="#F8F9FA" 
                        CornerRadius="0,0,12,12" 
                        BorderThickness="0,1,0,0" 
                        BorderBrush="#E1E5E9">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="25,15">
                        <Button Content="CANCELAR" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110" 
                                Click="BtnFecharPopup_Click"
                                Margin="0,0,10,0"/>

                        <Button Content="SALVAR" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="130"
                                Click="BtnSalvarPopup_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>