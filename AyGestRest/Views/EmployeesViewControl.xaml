<UserControl x:Class="AyGestRest.Views.EmployeesViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="1400"
             Background="#F8FAFC">
    <UserControl.Resources>
        <!-- Todos os recursos visuais idênticos ao original -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TranslucentWhite" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="SemiTransparentText" Color="#E6FFFFFF"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="RequiredFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1A000000" BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para texto somente leitura -->
        <Style x:Key="ReadOnlyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValidatedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Background="{StaticResource HeaderGradient}" Padding="20" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariant" Width="32" Height="32" Foreground="White" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Visualização de Produtos" FontSize="24" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="Consulta de produtos e ingredientes (somente leitura)" FontSize="14"
                                   Foreground="{StaticResource SemiTransparentText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20,16,20,20" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="20,12"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      ContentSource="Header" Margin="10,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#4F46E5"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,3"/>
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="#4F46E5"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="#64748B"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="#4F46E5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB PRODUTOS -->
            <TabItem Header="📦 Produtos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de busca e filtro -->
                    <Border Grid.Row="0" Margin="0,0,0,24" Style="{StaticResource ModernCardStyle}" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtSearch" Width="300" Margin="0,0,16,0"
                                     materialDesign:HintAssist.Hint="Buscar por nome ou código"
                                     Style="{StaticResource ValidatedTextBoxStyle}"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <ComboBox x:Name="CmbFilterCategory" Width="200"
                                      materialDesign:HintAssist.Hint="Filtrar por categoria"
                                      DisplayMemberPath="Nome" SelectedValuePath="Id"
                                      SelectionChanged="CmbFilterCategory_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="600"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Detalhes do produto selecionado (somente leitura) -->
                        <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PanelProductDetails" Visibility="Collapsed">
                                    <TextBlock Text="Detalhes do Produto" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20"/>

                                    <!-- Informações básicas -->
                                    <StackPanel Margin="0,0,0,24">
                                        <TextBlock Text="Informações Básicas" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,12"/>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="Nome do Produto" Style="{StaticResource RequiredFieldLabelStyle}"/>
                                            <TextBlock x:Name="TxtNameReadOnly" Style="{StaticResource ReadOnlyTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="Código/SKU" Style="{StaticResource RequiredFieldLabelStyle}"/>
                                            <TextBlock x:Name="TxtCodeReadOnly" Style="{StaticResource ReadOnlyTextStyle}"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Categoria" Style="{StaticResource RequiredFieldLabelStyle}"/>
                                                <TextBlock x:Name="TxtCategoryReadOnly" Style="{StaticResource ReadOnlyTextStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Preço de Venda" Style="{StaticResource RequiredFieldLabelStyle}"/>
                                                <TextBlock x:Name="TxtSalePriceReadOnly" Style="{StaticResource ReadOnlyTextStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,0,0,20">
                                            <TextBlock Text="Stock Atual" Style="{StaticResource RequiredFieldLabelStyle}"/>
                                            <TextBlock x:Name="TxtStockReadOnly" Style="{StaticResource ReadOnlyTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Descrição -->
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                                        <Expander Header="✏️ Descrição" IsExpanded="False">
                                            <TextBlock x:Name="TxtDescriptionReadOnly" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </Expander>
                                    </Border>

                                    <!-- Configurações -->
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="⚙️ Configurações" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="TxtStatusReadOnly" Margin="0,0,0,8" Style="{StaticResource ReadOnlyTextStyle}"/>
                                            <TextBlock x:Name="TxtTypeReadOnly" Margin="0,0,0,8" Style="{StaticResource ReadOnlyTextStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Imagem -->
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                                        <Expander Header="🖼️ Imagem do Produto" IsExpanded="False">
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" Height="200">
                                                <Image x:Name="ImgProductReadOnly" Stretch="Uniform"/>
                                            </Border>
                                        </Expander>
                                    </Border>

                                    <!-- Receita (para produtos compostos) -->
                                    <Border x:Name="CardRecipeReadOnly" Visibility="Collapsed" Style="{StaticResource ModernCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Receita do Produto Composto" FontWeight="SemiBold" Foreground="#0EA5E9" Margin="0,0,0,16"/>
                                            <DataGrid x:Name="DgRecipeReadOnly" AutoGenerateColumns="False" IsReadOnly="True"
                                                      Height="220" BorderThickness="1" BorderBrush="#E2E8F0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ingrediente" Binding="{Binding Ingredient.Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Quantidade" Binding="{Binding QuantityUsed}" Width="100"/>
                                                    <DataGridTextColumn Header="Unidade" Binding="{Binding Ingredient.Unit}" Width="100"/>
                                                    <DataGridTextColumn Header="Custo Unit." Binding="{Binding Ingredient.Cost, StringFormat=N2}" Width="120"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="TxtTotalRecipeCostReadOnly" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,16,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Lista de produtos -->
                        <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📋 Todos os Produtos" FontWeight="SemiBold" FontSize="16" Foreground="#2C3E50" Margin="0,0,0,16"/>
                                <DataGrid Grid.Row="1" x:Name="DgProducts" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionChanged="DgProducts_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"/>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Preço" Binding="{Binding Price, StringFormat='N2 MTn'}" Width="100"/>
                                        <DataGridTemplateColumn Header="Stock" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Stock, StringFormat=N2}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Stock}" Value="0">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Stock}">
                                                                        <DataTrigger.Value>
                                                                            <sys:Double>10</sys:Double>
                                                                        </DataTrigger.Value>
                                                                        <Setter Property="Foreground" Value="#F97316"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Categoria" Binding="{Binding Category.Nome}" Width="150"/>

                                        <!-- Status sem converter -->
                                        <DataGridTemplateColumn Header="Status" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#64748B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Active}" Value="True">
                                                                        <Setter Property="Background" Value="#10B981"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Foreground="White" FontWeight="Medium" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                                                            <Setter Property="Text" Value="Ativo"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Active}" Value="False">
                                                                            <Setter Property="Text" Value="Inativo"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Tipo sem converter -->
                                        <DataGridTemplateColumn Header="Tipo" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsComposite}" Value="True">
                                                                        <Setter Property="Background" Value="#3B82F6"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Width="12" Height="12" Foreground="White" Margin="0,0,4,0">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Setter Property="Kind" Value="Cube"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsComposite}" Value="True">
                                                                                <Setter Property="Kind" Value="ChefHat"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                            <TextBlock Foreground="White" FontWeight="Medium" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsComposite}" Value="True">
                                                                                <Setter Property="Text" Value="Composto"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsComposite}" Value="False">
                                                                                <Setter Property="Text" Value="Simples"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB INGREDIENTES (somente leitura) -->
            <TabItem Header="🧪 Ingredientes">
                <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🧪 Lista de Ingredientes" FontWeight="SemiBold" FontSize="16" Foreground="#2C3E50" Margin="0,0,0,16"/>
                        <DataGrid Grid.Row="1" x:Name="DgIngredients" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Custo" Binding="{Binding Cost, StringFormat='N2 MTn'}" Width="120"/>
                                <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="120"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat=N2}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Stock}" Value="0">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Stock}">
                                                    <DataTrigger.Value>
                                                        <sys:Double>10</sys:Double>
                                                    </DataTrigger.Value>
                                                    <Setter Property="Foreground" Value="#F97316"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>