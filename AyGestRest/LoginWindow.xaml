<Window x:Class="AyGestRest.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AyGest Rest - Autenticação" 
        Height="622" 
        Width="648"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F7FA"
        FontFamily="Segoe UI">

    <Border Background="White" 
            CornerRadius="12" 
            Margin="30" 
            Padding="40">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logotipo / Título -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock Text="AyGest Rest" 
                           FontSize="32" 
                           FontWeight="SemiBold" 
                           Foreground="#1E88E5"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Gestão de Restaurante" 
                           FontSize="14" 
                           Foreground="#757575"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Campo Utilizador -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <TextBlock Text="Utilizador" 
                           FontSize="14" 
                           FontWeight="Medium" 
                           Foreground="#424242"
                           Margin="0,0,0,8"/>
                <Border Background="#F0F0F0" CornerRadius="6" Padding="4">
                    <TextBox x:Name="txtUsername" 
                             FontSize="16" 
                             Padding="12,8" 
                             BorderThickness="0" 
                             Background="Transparent"
                             CaretBrush="#1E88E5"/>
                </Border>
            </StackPanel>

            <!-- Campo Senha -->
            <StackPanel Grid.Row="2" Margin="0,0,0,30">
                <TextBlock Text="Senha" 
                           FontSize="14" 
                           FontWeight="Medium" 
                           Foreground="#424242"
                           Margin="0,0,0,8"/>
                <Border Background="#F0F0F0" CornerRadius="6" Padding="4">
                    <PasswordBox x:Name="txtPassword" 
                                 FontSize="16" 
                                 Padding="12,8" 
                                 BorderThickness="0" 
                                 Background="Transparent"/>
                </Border>
            </StackPanel>

            <!-- Mensagem de erro -->
            <TextBlock x:Name="txtErrorMessage"
                       Grid.Row="3"
                       Text=""
                       Foreground="#D32F2F"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20"
                       Visibility="Collapsed"/>

            <!-- Botão Entrar -->
            <Button Grid.Row="4"
                    Content="Entrar"
                    Height="52"
                    FontSize="16"
                    FontWeight="Medium"
                    Background="#1E88E5"
                    Foreground="White"
                    BorderThickness="0"
                    Click="btnEntrar_Click"
                    IsDefault="True"/>

            <!-- Rodapé -->
            <TextBlock Grid.Row="5"
                       Text="© 2025 AyGest Rest - Sistema Offline"
                       FontSize="11"
                       Foreground="#9E9E9E"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,30,0,0"/>
        </Grid>
    </Border>
</Window>
