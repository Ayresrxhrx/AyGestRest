<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- AyGest Rest: identidade visual Clean Modern -->
    <Color x:Key="AyGestColorBackground">#F4F6FA</Color>
    <Color x:Key="AyGestColorSurface">#FFFFFF</Color>
    <Color x:Key="AyGestColorSurfaceSoft">#F8FAFD</Color>
    <Color x:Key="AyGestColorBorder">#E3E8F0</Color>
    <Color x:Key="AyGestColorPrimary">#3659D9</Color>
    <Color x:Key="AyGestColorPrimaryHover">#2949BD</Color>
    <Color x:Key="AyGestColorText">#172033</Color>
    <Color x:Key="AyGestColorMuted">#687386</Color>
    <Color x:Key="AyGestColorSuccess">#16865D</Color>
    <Color x:Key="AyGestColorDanger">#D94848</Color>
    <Color x:Key="AyGestColorWarning">#D99524</Color>

    <SolidColorBrush x:Key="AyGestBackground" Color="{StaticResource AyGestColorBackground}"/>
    <SolidColorBrush x:Key="AyGestSurface" Color="{StaticResource AyGestColorSurface}"/>
    <SolidColorBrush x:Key="AyGestSurfaceSoft" Color="{StaticResource AyGestColorSurfaceSoft}"/>
    <!-- Chaves de compatibilidade para ecrãs que ainda usam os nomes dos temas anteriores. -->
    <SolidColorBrush x:Key="AyGestSurfaceElevated" Color="#F8FAFD"/>
    <SolidColorBrush x:Key="AyGestInfo" Color="#2878D0"/>
    <SolidColorBrush x:Key="AyGestBorder" Color="{StaticResource AyGestColorBorder}"/>
    <SolidColorBrush x:Key="AyGestPrimary" Color="{StaticResource AyGestColorPrimary}"/>
    <SolidColorBrush x:Key="AyGestPrimaryHover" Color="{StaticResource AyGestColorPrimaryHover}"/>
    <SolidColorBrush x:Key="AyGestText" Color="{StaticResource AyGestColorText}"/>
    <SolidColorBrush x:Key="AyGestMuted" Color="{StaticResource AyGestColorMuted}"/>
    <SolidColorBrush x:Key="AyGestSuccess" Color="{StaticResource AyGestColorSuccess}"/>
    <SolidColorBrush x:Key="AyGestDanger" Color="{StaticResource AyGestColorDanger}"/>
    <SolidColorBrush x:Key="AyGestWarning" Color="{StaticResource AyGestColorWarning}"/>

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="{StaticResource AyGestBackground}"/>
    </Style>
    <Style TargetType="{x:Type UserControl}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="{StaticResource AyGestBackground}"/>
    </Style>
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestMuted}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AyGestPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource AyGestSurfaceSoft}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="CanUserAddRows" Value="False"/>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource AyGestSurfaceSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{StaticResource AyGestBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
    </Style>
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="Margin" Value="0,6"/>
    </Style>
    <Style x:Key="AyGestCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="AyGestPrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource AyGestPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="AyGestSecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="{StaticResource AyGestSurfaceSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="AyGestDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AyGestPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource AyGestDanger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestDanger}"/>
    </Style>
    <Style x:Key="AyGestSidebarButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AyGestSecondaryButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
</ResourceDictionary>