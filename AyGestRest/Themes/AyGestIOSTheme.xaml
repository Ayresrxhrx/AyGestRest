<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AyGestBackground" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="AyGestSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AyGestSurfaceElevated" Color="#F9F9FB"/>
    <SolidColorBrush x:Key="AyGestBorder" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="AyGestPrimary" Color="#16A34A"/>
    <SolidColorBrush x:Key="AyGestPrimaryHover" Color="#22C55E"/>
    <SolidColorBrush x:Key="AyGestText" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="AyGestMuted" Color="#6E6E73"/>
    <SolidColorBrush x:Key="AyGestDanger" Color="#FF3B30"/>
    <SolidColorBrush x:Key="AyGestWarning" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="AyGestInfo" Color="#007AFF"/>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="{StaticResource AyGestBackground}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="#F2F2F7"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="#F2F2F7"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="AlternatingRowBackground" Value="#FAFAFC"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="44"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F2F2F7"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="AyGestCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AyGestSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AyGestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <Style x:Key="AyGestPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource AyGestPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="AyGestSecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="Background" Value="#F2F2F7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="AyGestDangerButton" TargetType="Button" BasedOn="{StaticResource AyGestPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource AyGestDanger}"/>
    </Style>

    <Style x:Key="AyGestSidebarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AyGestText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="6,2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
</ResourceDictionary>
