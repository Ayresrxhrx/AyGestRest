<Window x:Class="AyGestRest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AyGest Rest - Sistema de Gestão"
        Height="1080"
        Width="1920"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0F1419"
        FontFamily="Segoe UI"
        Foreground="#E0E0E0">

    <Window.Resources>
        <!-- Animação para transição suave -->
        <Storyboard x:Key="CollapseAnimation" Duration="0:0:0.3">
            <DoubleAnimation Storyboard.TargetProperty="Height" To="70" />
        </Storyboard>
        <Storyboard x:Key="ExpandAnimation" Duration="0:0:0.3">
            <DoubleAnimation Storyboard.TargetProperty="Height" To="90" />
        </Storyboard>
        <Storyboard x:Key="CollapseSidebarAnimation" Duration="0:0:0.3">
            <DoubleAnimation Storyboard.TargetProperty="Width" To="80" />
        </Storyboard>
        <Storyboard x:Key="ExpandSidebarAnimation" Duration="0:0:0.3">
            <DoubleAnimation Storyboard.TargetProperty="Width" To="300" />
        </Storyboard>

        <!-- Estilo para o botão de toggle da barra superior -->
        <Style x:Key="TopbarToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" 
                                                  Opacity="0.4" 
                                                  ShadowDepth="3" 
                                                  Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <!-- Ícone de seta para cima/baixo -->
                                        <Path x:Name="iconPath" 
                                              Data="M12,4 L20,12 L12,20 L4,12 Z"
                                              Stroke="#60A5FA"
                                              StrokeThickness="2"
                                              Fill="#60A5FA"
                                              Opacity="0.8">
                                            <Path.RenderTransform>
                                                <RotateTransform CenterX="12" CenterY="12" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2937"/>
                                <Setter TargetName="border" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter TargetName="iconPath" Property="Fill" Value="#93C5FD"/>
                                <Setter TargetName="iconPath" Property="Stroke" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para o botão de toggle da barra lateral -->
        <Style x:Key="SidebarToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" 
                                                  Opacity="0.4" 
                                                  ShadowDepth="3" 
                                                  Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <!-- Ícone de seta para esquerda/direita -->
                                        <Path x:Name="iconPath" 
                                              Data="M20,12 L12,4 L4,12 L12,20 Z"
                                              Stroke="#8B5CF6"
                                              StrokeThickness="2"
                                              Fill="#8B5CF6"
                                              Opacity="0.8">
                                            <Path.RenderTransform>
                                                <RotateTransform CenterX="12" CenterY="12" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2937"/>
                                <Setter TargetName="border" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter TargetName="iconPath" Property="Fill" Value="#A78BFA"/>
                                <Setter TargetName="iconPath" Property="Stroke" Value="#A78BFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botões de menu colapsados -->
        <Style x:Key="CollapsedMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ToolTipService.ShowDuration" Value="2000"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2933"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2933"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource MenuButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border x:Name="TopBorder" 
                Grid.Row="0" 
                Grid.ColumnSpan="2"
                Background="#0F1419"
                BorderBrush="#1F2937"
                BorderThickness="0,0,0,2">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo e botão de toggle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botão para colapsar/expandir barra superior -->
                    <Button x:Name="BtnToggleTopbar"
                            Style="{StaticResource TopbarToggleButtonStyle}"
                            Margin="0,0,16,0"
                            Click="BtnToggleTopbar_Click"
                            ToolTip="Reduzir/Expandir barra superior">
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="0" Duration="0:0:0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <TextBlock Text="🍽 AyGest Rest"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#60A5FA"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="txtNotifications"
                           Grid.Column="1"
                           Text=""
                           FontSize="16"
                           Foreground="#FBBF24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtCurrentUser"
                               FontSize="15"
                               Foreground="#93C5FD"
                               Margin="0,0,24,0"/>

                    <TextBlock x:Name="txtCurrentTime"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               Margin="0,0,32,0"/>

                    
                    <Button Content="Sair"
                            Width="120"
                            Height="44"
                            
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnSair_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRA LATERAL -->
        <Border x:Name="SideBorder"
                Grid.Row="1" 
                Grid.Column="0"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="0,0,2,0">
            <Grid>
                <!-- Botão para colapsar/expandir barra lateral (no topo da sidebar) -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                        Background="Transparent" 
                        Padding="12,8">
                    <Button x:Name="BtnToggleSidebar"
                            Style="{StaticResource SidebarToggleButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="BtnToggleSidebar_Click"
                            ToolTip="Reduzir/Expandir barra lateral">
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="0" Duration="0:0:0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                </Border>

                <!-- Conteúdo da sidebar com scroll -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarContent" Margin="12,8">
                        <!-- Seção de Operações -->
                        <TextBlock x:Name="txtOperacoesHeader"
                                   Text="OPERAÇÕES"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="12,0,12,8"
                                   HorizontalAlignment="Left"/>

                        <StackPanel x:Name="SectionOperacoes">
                            <Button x:Name="BtnMesas" 
                                    Content="🪑 Mesas" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnMesas_Click"/>
                            <Button x:Name="BtnCaixa" 
                                    Content="💳 Caixa (PDV)" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnCaixa_Click"/>
              
                        </StackPanel>

                        <!-- Seção de Gestão -->
                        <TextBlock x:Name="txtGestaoHeader"
                                   Text="GESTÃO"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="12,24,12,8"
                                   HorizontalAlignment="Left"/>

                        <StackPanel x:Name="SectionGestao">
                            <Button x:Name="BtnArtigos" 
                                    Content="🍽 Artigos / Menu" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnArtigos_Click"/>
                            <Button x:Name="BtnReservas" 
                                    Content="📅 Reservas" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnReservas_Click"/>
                            <Button x:Name="BtnCategorias" 
                                    Content="📅 Categorias" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnCategorias_Click"/>
                            <Button x:Name="BtnClientes" 
                                    Content="🙍‍ Clientes" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnClientes_Click"/>
                        </StackPanel>

                        <!-- Seção de Relatórios -->
                        <TextBlock x:Name="txtRelatoriosHeader"
                                   Text="RELATÓRIOS"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="12,24,12,8"
                                   HorizontalAlignment="Left"/>

                        <StackPanel x:Name="SectionRelatorios">
                            <Button x:Name="BtnHistoricoPedidos" 
                                    Content="📜 Histórico de Vendas" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnHistoricoPedidos_Click"/>
                            <Button x:Name="BtnFechoDiario" 
                                    Content="🏁 Fecho Diário" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnFechoDiario_Click"/>
                            <Button x:Name="BtnrRelatorios" 
                                    Content="🏁 Relatórios" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnrRelatorios_Click"/>
                            <Button x:Name="BtnTurnos" 
        Content="🕐 Turnos Funcionários" 
        Style="{StaticResource MenuButtonStyle}" 
        Click="BtnTurnos_Click"/>
                        </StackPanel>

                        <!-- Seção de Administração -->
                        <TextBlock x:Name="txtAdminHeader"
                                   Text="ADMINISTRAÇÃO"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="12,24,12,8"
                                   HorizontalAlignment="Left"/>

                        <StackPanel x:Name="SectionAdmin">
                            <Button x:Name="BtnDefinicoes" 
                                    Content="⚙️ Definições" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnDefinicoes_Click"/>
                            <Button x:Name="BtnUtilizadores" 
                                    Content="👤 Utilizadores" 
                                    Style="{StaticResource MenuButtonStyle}" 
                                    Click="BtnUtilizadores_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ÁREA DE CONTEÚDO PRINCIPAL -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="#0F1419"
                Padding="16">
            <ContentControl x:Name="MainContentArea"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</Window>